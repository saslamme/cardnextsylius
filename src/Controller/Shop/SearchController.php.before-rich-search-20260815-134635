<?php

declare(strict_types=1);

namespace App\Controller\Shop;

use App\Entity\Product\Product;
use App\Service\Search\CardnextProductSearch;
use Doctrine\ORM\EntityManagerInterface;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

final class SearchController extends AbstractController
{
    #[Route('/{_locale}/suche', name: 'cardnext_shop_search', methods: ['GET'], priority: 120)]
    public function index(
        string $_locale,
        Request $request,
        CardnextProductSearch $search,
        EntityManagerInterface $entityManager,
    ): Response {
        $query = (string) $request->query->get('q', '');
        $result = $search->search($query, $_locale, 48);

        $products = [];

        if ($result['products'] !== []) {
            $ids = array_map(static fn (array $item): int => $item['id'], $result['products']);
            $entities = $entityManager->getRepository(Product::class)->findBy(['id' => $ids]);

            $indexed = [];
            foreach ($entities as $product) {
                $indexed[$product->getId()] = $product;
            }

            foreach ($ids as $id) {
                if (isset($indexed[$id])) {
                    $products[] = $indexed[$id];
                }
            }
        }

        return $this->render('shop/search/index.html.twig', [
            'query' => $result['query'],
            'total' => $result['total'],
            'products' => $products,
        ]);
    }

    #[Route('/{_locale}/search/suggest', name: 'cardnext_shop_search_suggest', methods: ['GET'], priority: 120)]
    public function suggest(
        string $_locale,
        Request $request,
        CardnextProductSearch $search,
    ): JsonResponse {
        $query = trim((string) $request->query->get('q', ''));

        if (mb_strlen($query) < 2) {
            return $this->json([
                'query' => $query,
                'total' => 0,
                'products' => [],
                'manufacturers' => [],
            ]);
        }

        $result = $search->search($query, $_locale, 7);

        $products = array_map(
            fn (array $item): array => [
                'name' => $item['name'],
                'code' => $item['code'],
                'manufacturer' => $item['manufacturer'],
                'url' => $this->generateUrl('sylius_shop_product_show', [
                    '_locale' => $_locale,
                    'slug' => $item['slug'],
                ]),
            ],
            $result['products'],
        );

        $manufacturers = array_map(
            fn (array $item): array => [
                'name' => $item['name'],
                'code' => $item['code'],
                'url' => $this->generateUrl('cardnext_shop_search', [
                    '_locale' => $_locale,
                    'q' => $item['name'],
                ]),
            ],
            $search->manufacturers($query, 4),
        );

        return $this->json([
            'query' => $result['query'],
            'total' => $result['total'],
            'products' => $products,
            'manufacturers' => $manufacturers,
        ]);
    }
}
