    font-size: .8rem;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-search-suggest__main > span {
    overflow: hidden;
    color: var(--cn-muted);
    font-size: .7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-search-suggest__arrow {
    flex: 0 0 auto;
    color: var(--cn-primary);
    font-weight: 800;
}

.cn-search-suggest__all {
    min-height: 46px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 9px 15px;
    color: var(--cn-primary-hover);
    background: var(--cn-surface-soft);
    font-size: .73rem;
    font-weight: 800;
    text-decoration: none;
}

.cn-search-suggest__empty {
    padding: 18px 15px;
    color: var(--cn-muted);
    font-size: .76rem;
}

.cn-search-page {
    padding: 58px 0 82px;
    background: #fff;
}

.cn-search-page__header {
    margin-bottom: 28px;
}

.cn-search-page__header .cn-title {
    margin: 7px 0 5px;
}

.cn-search-page__count {
    margin: 0;
    color: var(--cn-muted);
    font-size: .85rem;
}

.cn-search-page__products {
    margin-top: 26px;
}

.cn-search-empty {
    max-width: 680px;
    margin-top: 30px;
    padding: 34px;
    background: var(--cn-surface-soft);
    border: 1px solid var(--cn-border);
}

.cn-search-empty h2 {
    margin: 0 0 8px;
    color: var(--cn-ink);
    font-size: 1.2rem;
}

.cn-search-empty p {
    margin: 0;
    color: var(--cn-muted);
}

@media (max-width: 991.98px) {
    .cn-search-page {
        padding: 38px 0 58px;
    }
}

/* Cardnext search results layout fix */
.cn-search-page__products.products-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 18px !important;
    align-items: stretch;
}

.cn-search-page__products.products-grid > * {
    min-width: 0;
    height: 100%;
    padding: 0;
    background: #fff;
    border: 1px solid var(--cn-border);
}

/*
 * Sylius' standard product card uses an inline 3/4 aspect ratio.
 * Cardnext product photography is mostly square, therefore override it here
 * only on the dedicated search results page.
 */
.cn-search-page__products .link-reset > .mb-4 {
    margin-bottom: 0 !important;
}

.cn-search-page__products .link-reset > .mb-4 > div[style*="aspect-ratio"] {
    aspect-ratio: 1 / 1 !important;
    overflow: hidden !important;
    background: #fff !important;
    border-radius: 0 !important;
    border-bottom: 1px solid var(--cn-border);
}

.cn-search-page__products .link-reset > .mb-4 img {
    width: 100% !important;
    height: 100% !important;
    padding: 18px !important;
    object-fit: contain !important;
    object-position: center !important;
    background: #fff !important;
}

.cn-search-page__products .link-reset {
    display: block;
    color: inherit;
    text-decoration: none;
}

.cn-search-page__products .link-reset > :not(.mb-4) {
    padding-left: 14px;
    padding-right: 14px;
}

.cn-search-page__products > * > :last-child {
    padding: 10px 14px 14px;
}

@media (max-width: 1199.98px) {
    .cn-search-page__products.products-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 899.98px) {
    .cn-search-page__products.products-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 14px !important;
    }
}

@media (max-width: 639.98px) {
    .cn-search-page__products.products-grid {
        grid-template-columns: 1fr !important;
        gap: 12px !important;
    }

    /*
     * On phones keep result images deliberately shallower than a full square.
     * This avoids the extremely long result page visible with the default
     * Sylius 3/4 image box.
     */
    .cn-search-page__products .link-reset > .mb-4 > div[style*="aspect-ratio"] {
        aspect-ratio: 16 / 10 !important;
        max-height: 210px;
    }

    .cn-search-page__products .link-reset > .mb-4 img {
        padding: 14px !important;
    }
}

@media (max-width: 359.98px) {
    .cn-search-page__products .link-reset > .mb-4 > div[style*="aspect-ratio"] {
        max-height: 165px;
    }

    .cn-search-page__products .link-reset > .mb-4 img {
        padding: 10px !important;
    }
}

/* Cardnext search card content alignment */

/* Make the Sylius card fill the complete search grid cell. */
.cn-search-page__products [data-test-product] {
    display: flex;
    flex-direction: column;
    height: 100%;
}

/* Product details occupy the available card height. */
.cn-search-page__products [data-test-product] > .link-reset {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
}

/*
 * Reset the earlier generic padding rule and align the product title
 * exactly with the price below.
 */
.cn-search-page__products [data-test-product] > .link-reset > .h6 {
    min-height: 54px;
    margin: 0 !important;
    padding: 12px 14px 8px !important;
    color: var(--cn-ink);
    font-size: .88rem;
    font-weight: 700;
    line-height: 1.3;
}

/* Price block: same horizontal inset as title. */
.cn-search-page__products [data-test-product] > div:last-child {
    margin-top: auto;
    padding: 0 14px 15px !important;
}

/* Remove margins inherited from Bootstrap/Sylius price elements. */
.cn-search-page__products [data-test-product] > div:last-child > * {
    margin-left: 0 !important;
    margin-right: 0 !important;
}

.cn-search-page__products [data-test-product] > div:last-child p,
.cn-search-page__products [data-test-product] > div:last-child .h5,
.cn-search-page__products [data-test-product] > div:last-child .h6 {
    margin: 0 !important;
}

/* Remove the previous broad content padding so it cannot double-indent. */
.cn-search-page__products .link-reset > :not(.mb-4) {
    padding-left: 0;
    padding-right: 0;
}

/* Then explicitly restore only the title inset. */
.cn-search-page__products [data-test-product] > .link-reset > .h6 {
    padding-left: 14px !important;
    padding-right: 14px !important;
}

@media (max-width: 639.98px) {
    .cn-search-page__products [data-test-product] > .link-reset > .h6 {
        min-height: 0;
        padding-top: 11px !important;
    }

    .cn-search-page__products [data-test-product] > div:last-child {
        padding-bottom: 13px !important;
    }
}
