@charset "UTF-8";
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

/* ==========================================================================\n   CARDNEXT STOREFRONT DESIGN SYSTEM\n   Single source of truth. No SCSS partials, no page-polish imports.\n   ========================================================================== */

:root {
    --cn-primary: #e95126;
    --cn-primary-hover: #c83b16;
    --cn-primary-soft: #fff1ec;
    --cn-ink: #20272d;
    --cn-text: #3b454d;
    --cn-muted: #6b747b;
    --cn-subtle: #8b9499;
    --cn-border: #dce1e4;
    --cn-border-strong: #aeb6bb;
    --cn-surface: #ffffff;
    --cn-surface-soft: #f5f6f7;
    --cn-surface-softer: #f7f8f9;
    --cn-footer: #151b20;
    --cn-success: #23845d;
    --cn-warning: #9a6b27;
    --cn-danger: #b42318;
    --cn-container: 1420px;
    --cn-content: 1180px;
    --cn-radius: 4px;
    --cn-header-height: 76px;
    --cn-control-height: 48px;
    --cn-section-space: 80px;
    --cn-section-space-mobile: 56px;
    --cn-focus: 0 0 0 3px rgba(233,81,38,.12);
    --cn-shadow-menu: 0 16px 38px rgba(32,39,45,.10);
    --cn-transition: 180ms ease;
    --cn-font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }
html { font-size: 16px; scroll-behavior: smooth; scroll-padding-top: calc(var(--cn-header-height) + 16px); }
body {
    min-width: 320px;
    margin: 0;
    color: var(--cn-text);
    background: var(--cn-surface);
    font-family: var(--cn-font);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}
img, svg { max-width: 100%; }
img { height: auto; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
a { color: var(--cn-primary-hover); text-underline-offset: 3px; }
a:hover { color: var(--cn-primary); }
::selection { color: #fff; background: var(--cn-primary); }
[hidden] { display: none !important; }
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible {
    outline: 3px solid rgba(233,81,38,.28);
    outline-offset: 3px;
}

/* Layout primitives */
.cn-page { min-width: 0; color: var(--cn-text); background: var(--cn-surface); }
.cn-container { width: 100%; max-width: var(--cn-container); margin-inline: auto; padding-inline: 24px; }
.cn-container--narrow { max-width: var(--cn-content); }
.cn-section { padding-block: var(--cn-section-space); }
.cn-section--compact { padding-block: 38px; }
.cn-section--soft { background: var(--cn-surface-soft); }
.cn-section--dark { color: #fff; background: var(--cn-ink); }
.cn-stack { display: flex; flex-direction: column; gap: 18px; }
.cn-stack--sm { gap: 10px; }
.cn-stack--lg { gap: 28px; }
.cn-cluster { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.cn-grid { display: grid; gap: 18px; }
.cn-grid--2 { grid-template-columns: repeat(2,minmax(0,1fr)); }
.cn-grid--3 { grid-template-columns: repeat(3,minmax(0,1fr)); }
.cn-grid--4 { grid-template-columns: repeat(4,minmax(0,1fr)); }
.cn-grid--lined { gap: 0; border-top: 1px solid var(--cn-border); border-left: 1px solid var(--cn-border); }
.cn-split { display: grid; grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: 80px; align-items: start; }
.cn-split--contact { grid-template-columns: minmax(300px,.75fr) minmax(0,1.25fr); }
.cn-sticky { position: sticky; top: calc(var(--cn-header-height) + 54px); }
.cn-scroll-x { overflow-x: auto; scrollbar-width: none; }
.cn-scroll-x::-webkit-scrollbar { display: none; }
.cn-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; margin-bottom: 34px; }
.cn-divider { border-top: 1px solid var(--cn-border); }
.cn-visually-hidden {
    position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important;
    margin: -1px !important; overflow: hidden !important; clip: rect(0,0,0,0) !important;
    white-space: nowrap !important; border: 0 !important;
}

/* Typography */
.cn-kicker { display: inline-block; color: var(--cn-primary-hover); font-size: .73rem; font-weight: 800; letter-spacing: .105em; text-transform: uppercase; }
.cn-title { margin: 0; color: var(--cn-ink); font-weight: 800; letter-spacing: -.04em; line-height: 1.08; }
.cn-title--hero { font-size: clamp(2.85rem,4.2vw,4.35rem); letter-spacing: -.055em; line-height: 1.01; }
.cn-title--page { font-size: clamp(2.55rem,3.6vw,3.65rem); letter-spacing: -.05em; line-height: 1.02; }
.cn-title--section { font-size: clamp(2rem, 2.2vw, 3.2rem); }
.cn-title--sm { font-size: 1.2rem; letter-spacing: -.02em; }
.cn-lead { max-width: 760px; margin: 0; color: var(--cn-muted); font-size: 1rem; line-height: 1.72; }
.cn-meta { color: var(--cn-subtle); font-size: .74rem; }
.cn-prose { color: var(--cn-text); font-size: .94rem; line-height: 1.78; }
.cn-prose > :first-child { margin-top: 0; }
.cn-prose > :last-child { margin-bottom: 0; }
.cn-prose h2 { margin: 0 0 18px; color: var(--cn-ink); font-size: clamp(1.8rem,2.6vw,2.55rem); font-weight: 800; letter-spacing: -.035em; line-height: 1.08; }
.cn-prose h3 { margin: 28px 0 10px; color: var(--cn-ink); font-size: 1.15rem; font-weight: 800; line-height: 1.25; }
.cn-prose p { margin: 0 0 15px; }
.cn-prose ul, .cn-prose ol { margin: 0 0 18px; padding-left: 1.25rem; }
.cn-prose li + li { margin-top: 5px; }
.cn-prose a { color: var(--cn-primary-hover); }
.cn-prose--bordered { margin-top: 58px; padding-top: 30px; border-top: 1px solid var(--cn-border); }
.cn-badge { display: inline-flex; align-items: center; min-height: 24px; padding: 3px 8px; color: var(--cn-primary-hover); background: var(--cn-primary-soft); border: 1px solid rgba(233,81,38,.18); border-radius: 3px; font-size: .68rem; font-weight: 750; line-height: 1.2; }

/* Buttons – Bootstrap/Sylius bridge and Cardnext component use the same rules */
.cn-btn, .btn {
    min-height: var(--cn-control-height);
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 0 19px; border: 1px solid transparent; border-radius: var(--cn-radius);
    box-shadow: none; font-size: .84rem; font-weight: 750; line-height: 1.15; text-decoration: none;
    transition: color var(--cn-transition), background-color var(--cn-transition), border-color var(--cn-transition);
}
.cn-btn--primary, .btn-primary {
    --bs-btn-color: #fff;
    --bs-btn-bg: var(--cn-primary, #e95126);
    --bs-btn-border-color: var(--cn-primary, #e95126);
    --bs-btn-hover-color: #fff;
    --bs-btn-hover-bg: var(--cn-primary-hover, #c83b16);
    --bs-btn-hover-border-color: var(--cn-primary-hover, #c83b16);
    --bs-btn-active-color: #fff;
    --bs-btn-active-bg: var(--cn-primary-hover, #c83b16);
    --bs-btn-active-border-color: var(--cn-primary-hover, #c83b16);
    color: #fff !important;
    background: var(--cn-primary, #e95126) !important;
    border-color: var(--cn-primary, #e95126) !important;
}
.cn-btn--primary:hover, .cn-btn--primary:focus-visible, .btn-primary:hover, .btn-primary:focus-visible {
    color: #fff !important;
    background: var(--cn-primary-hover, #c83b16) !important;
    border-color: var(--cn-primary-hover, #c83b16) !important;
}
.cn-btn--secondary, .btn-secondary, .btn-outline-primary, .btn-outline-secondary {
    --bs-btn-color: var(--cn-ink);
    --bs-btn-bg: #fff;
    --bs-btn-border-color: var(--cn-border-strong);
    --bs-btn-hover-color: #fff;
    --bs-btn-hover-bg: var(--cn-ink);
    --bs-btn-hover-border-color: var(--cn-ink);
    color: var(--cn-ink) !important; background: #fff !important; border-color: var(--cn-border-strong) !important;
}
.cn-btn--secondary:hover, .cn-btn--secondary:focus-visible, .btn-secondary:hover, .btn-secondary:focus-visible,
.btn-outline-primary:hover, .btn-outline-primary:focus-visible, .btn-outline-secondary:hover, .btn-outline-secondary:focus-visible {
    color: #fff !important; background: var(--cn-ink) !important; border-color: var(--cn-ink) !important;
}
.cn-btn--dark { color: #fff; background: var(--cn-ink); border-color: var(--cn-ink); }
.cn-btn--dark:hover, .cn-btn--dark:focus-visible { color: #fff; background: #11171b; border-color: #11171b; }
.cn-btn--small { min-height: 38px; padding-inline: 13px; font-size: .72rem; }
.cn-btn--block { width: 100%; }
.cn-btn:disabled, .btn:disabled, .cn-btn.is-disabled { opacity: .45; cursor: not-allowed; }
.cn-link { display: inline-flex; align-items: center; gap: 8px; color: var(--cn-ink); font-size: .82rem; font-weight: 750; text-decoration: none; }
.cn-link:hover, .cn-link:focus-visible, .cn-link.is-active { color: var(--cn-primary-hover); }
.cn-link--arrow::after { color: var(--cn-primary); content: "\2192"; transition: transform var(--cn-transition); }
.cn-link--arrow:hover::after { transform: translateX(3px); }
.cn-link--small { font-size: .7rem; }

/* Forms */
.form-label, label.form-label { margin-bottom: 7px; color: var(--cn-ink); font-size: .8rem; font-weight: 700; }
.form-control, .form-select { min-height: var(--cn-control-height); padding: 10px 13px; color: var(--cn-ink); background: #fff; border: 1px solid var(--cn-border-strong); border-radius: var(--cn-radius); box-shadow: none; font-size: .84rem; }
textarea.form-control { min-height: 150px; resize: vertical; line-height: 1.6; }
.form-control::placeholder { color: #9ba3a8; }
.form-control:focus, .form-select:focus { color: var(--cn-ink); background: #fff; border-color: var(--cn-primary); box-shadow: var(--cn-focus); }
.form-check-input { border-color: var(--cn-border-strong); box-shadow: none; }
.form-check-input:checked { background-color: var(--cn-primary); border-color: var(--cn-primary); }
.form-check-input:focus { border-color: var(--cn-primary); box-shadow: var(--cn-focus); }
.invalid-feedback, .form-text, .text-body-secondary, .text-body-tertiary { color: var(--cn-muted) !important; }
.cn-form .mb-3 { margin-bottom: 20px !important; }

/* Generic Sylius/Bootstrap surfaces – login, account, cart, checkout */
.card { border: 1px solid var(--cn-border); border-radius: var(--cn-radius); box-shadow: none; }
.card-header { padding: 18px 20px; color: var(--cn-ink); background: #fff; border-bottom-color: var(--cn-border); font-weight: 750; }
.card-body { padding: 20px; }
.table { --bs-table-bg: transparent; --bs-table-border-color: var(--cn-border); color: var(--cn-text); font-size: .82rem; }
.table > :not(caption) > * > * { padding: 14px 12px; vertical-align: middle; }
.table thead th { color: #69737a; background: var(--cn-surface-softer); font-size: .7rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
.dropdown-menu { padding: 6px; border-color: var(--cn-border); border-radius: var(--cn-radius); box-shadow: var(--cn-shadow-menu); }
.dropdown-item { padding: 8px 10px; border-radius: 3px; color: var(--cn-text); font-size: .78rem; }
.dropdown-item:hover, .dropdown-item:focus { color: var(--cn-primary-hover); background: var(--cn-surface-soft); }
.alert { border-radius: var(--cn-radius); box-shadow: none; font-size: .82rem; }
.pagination { gap: 5px; }
.page-link { min-width: 40px; min-height: 40px; display: inline-grid; place-items: center; padding: 0 10px; color: var(--cn-ink); background: #fff; border-color: var(--cn-border); border-radius: var(--cn-radius) !important; box-shadow: none !important; font-size: .76rem; font-weight: 700; }
.active > .page-link, .page-link.active { color: #fff; background: var(--cn-ink); border-color: var(--cn-ink); }
.list-group-item { border-color: var(--cn-border); }
.nav-tabs { border-bottom-color: var(--cn-border); }
.offcanvas, .modal-content { border-color: var(--cn-border); border-radius: var(--cn-radius); box-shadow: 0 20px 60px rgba(32,39,45,.14); }
.offcanvas-header, .modal-header { border-bottom: 1px solid var(--cn-border); }
.modal-footer { border-top-color: var(--cn-border); }
.container.my-auto { width: 100%; max-width: var(--cn-content); padding-top: 56px; padding-bottom: 64px; }
.container.my-auto h1, .container.my-auto h2, .container.my-auto h3 { color: var(--cn-ink); font-weight: 800; letter-spacing: -.035em; }

/* Breadcrumbs */
.cn-breadcrumbs { background: var(--cn-surface-softer); border-top: 1px solid #eef0f1; border-bottom: 1px solid var(--cn-border); }
.cn-breadcrumbs__inner { min-height: 50px; display: flex; align-items: center; gap: 11px; overflow: hidden; color: #737e85; font-size: .76rem; white-space: nowrap; }
.cn-breadcrumbs a { color: inherit; font-weight: 500; text-decoration: none; }
.cn-breadcrumbs a:hover { color: var(--cn-primary-hover); }
.cn-breadcrumbs__sep { color: #b2b9bd; }
.cn-breadcrumbs [aria-current="page"] { min-width: 0; overflow: hidden; color: var(--cn-ink); font-weight: 600; text-overflow: ellipsis; }

/* Header */
.cn-utility { color: #68727a; background: #fff; border-bottom: 1px solid var(--cn-border); font-size: .72rem; }
.cn-utility__inner { min-height: 34px; display: flex; align-items: center; justify-content: flex-end; gap: 22px; }
.cn-utility a { color: inherit; text-decoration: none; }
.cn-utility a:hover { color: var(--cn-primary-hover); }
.cn-utility__market { font-weight: 700; }
.cn-header { position: sticky; top: 0; z-index: 1030; background: rgba(255,255,255,.98); border-bottom: 1px solid var(--cn-border); backdrop-filter: blur(8px); }
.cn-header__inner { min-height: var(--cn-header-height); display: grid; grid-template-columns: 200px minmax(0,1fr) auto; align-items: center; gap: 26px; }
.cn-logo { min-width: 0; display: inline-flex; align-items: center; text-decoration: none; }
.cn-logo img { display: block; width: 184px; max-width: 100%; }
.cn-nav-wrap, .cn-nav { min-width: 0; }






.cn-nav > ul {
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    gap: 2px;
    padding: 0;
    margin: 0;
    list-style: none;
}

.cn-nav__item { position: static; }

.cn-nav__link {
    position: relative;
    min-height: var(--cn-header-height);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 10px;
    color: var(--cn-ink);
    font-size: .79rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
}

.cn-nav__link::after {
    position: absolute;
    right: 10px;
    bottom: 0;
    left: 10px;
    height: 2px;
    content: "";
    background: var(--cn-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--cn-transition);
}

.cn-nav__chevron { width: 13px; height: 13px; flex: 0 0 13px; transition: transform var(--cn-transition); }
.cn-nav__item:hover > .cn-nav__link, .cn-nav__item:focus-within > .cn-nav__link { color: var(--cn-primary-hover); }
.cn-nav__item:hover > .cn-nav__link::after, .cn-nav__item:focus-within > .cn-nav__link::after { transform: scaleX(1); }







.cn-nav__mega {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 1200;
    width: min(calc(100vw - 40px), 1180px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    background: #fff;
    border: 1px solid var(--cn-border);
    border-top: 2px solid var(--cn-primary);
    box-shadow: 0 12px 28px rgba(32,39,45,.08);
    transform: translate(-50%, 5px);
    transition: opacity 140ms ease, transform 140ms ease, visibility 140ms ease;
}

.cn-nav__item.is-open > .cn-nav__mega {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
}

.cn-nav__mega-inner {
    padding: 0 22px 20px;
}

.cn-nav__mega-head {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--cn-border);
}

.cn-nav__mega-head strong {
    color: var(--cn-ink);
    font-size: .95rem;
    font-weight: 800;
    line-height: 1.2;
}

.cn-nav__mega-head > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--cn-muted);
    font-size: .7rem;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--cn-transition);
}

.cn-nav__mega-head > a svg,
.cn-nav__mega-link svg {
    width: 13px;
    height: 13px;
    flex: 0 0 13px;
    color: var(--cn-primary);
    transition: transform var(--cn-transition);
}

.cn-nav__mega-head > a:hover,
.cn-nav__mega-head > a:focus-visible,
.cn-nav__mega-link:hover,
.cn-nav__mega-link:focus-visible {
    color: var(--cn-primary-hover);
}

.cn-nav__mega-head > a:hover svg,
.cn-nav__mega-head > a:focus-visible svg,
.cn-nav__mega-link:hover svg,
.cn-nav__mega-link:focus-visible svg {
    transform: translateX(3px);
}

.cn-nav__mega-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    column-gap: 28px;
    padding-top: 10px;
}

.cn-nav__mega-link {
    min-width: 0;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 0 2px;
    color: var(--cn-ink);
    border-bottom: 1px solid var(--cn-border);
    font-size: .76rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    transition: color var(--cn-transition), padding-left var(--cn-transition);
}

.cn-nav__mega-link:hover,
.cn-nav__mega-link:focus-visible {
    padding-left: 5px;
}

.cn-nav__item.is-open > .cn-nav__link {
    color: var(--cn-primary-hover);
}

.cn-nav__item.is-open > .cn-nav__link::after {
    transform: scaleX(1);
}

.cn-nav__item.is-open .cn-nav__chevron {
    transform: rotate(180deg);
}

@media (max-width: 1279.98px) {
    .cn-nav__mega {
        width: calc(100vw - 24px);
    }

    .cn-nav__mega-inner {
        padding-inline: 18px;
    }

    .cn-nav__mega-grid {
        column-gap: 20px;
    }

    .cn-nav__mega-link {
        font-size: .72rem;
    }
}

.cn-header-actions { display: flex; align-items: center; justify-self: end; gap: 4px; white-space: nowrap; }
.cn-icon-btn { position: relative; width: 40px; height: 40px; display: grid; flex: 0 0 40px; padding: 0; place-items: center; color: var(--cn-ink); background: transparent; border: 0; border-radius: 50%; text-decoration: none; }
.cn-icon-btn:hover, .cn-icon-btn:focus-visible { color: var(--cn-primary-hover); background: var(--cn-surface-soft); }
.cn-icon-btn svg { width: 19px; height: 19px; stroke: currentColor; }
.cn-icon-btn--bordered { border: 1px solid var(--cn-border); }
.cn-cart-widget { display: contents; }
.cn-cart-badge { position: absolute; top: -2px; right: -1px; min-width: 17px; height: 17px; display: grid; padding: 0 4px; place-items: center; color: #fff; background: var(--cn-primary-hover); border: 2px solid #fff; border-radius: 20px; font-size: 8px; font-weight: 800; line-height: 1; }
.cn-menu-toggle { width: 44px; height: 44px; display: none; flex: 0 0 44px; flex-direction: column; align-items: center; justify-content: center; padding: 0; color: var(--cn-ink); background: transparent; border: 0; }
.cn-menu-toggle span { width: 24px; height: 2px; display: block; margin: 2.5px 0; background: currentColor; border-radius: 2px; }
.cn-search-panel { position: absolute; top: 100%; right: 0; left: 0; z-index: 1050; background: #fff; border-top: 1px solid #edf0f1; border-bottom: 1px solid var(--cn-border); box-shadow: 0 18px 36px rgba(32,39,45,.09); }
.cn-search-panel__inner { padding-top: 34px; padding-bottom: 40px; }
.cn-search-form { min-height: 60px; display: grid; grid-template-columns: 26px minmax(0,1fr) auto 38px; align-items: center; gap: 12px; padding: 0 8px 0 18px; background: #fff; border: 1px solid var(--cn-border-strong); border-radius: var(--cn-radius); }
.cn-search-form > svg { width: 21px; height: 21px; stroke: var(--cn-muted); }
.cn-search-form input { width: 100%; min-width: 0; height: 56px; padding: 0; color: var(--cn-ink); background: transparent; border: 0; outline: 0; font-size: .94rem; }
.cn-search-form input::placeholder { color: #899299; }
.cn-search-form--mobile { min-height: 46px; grid-template-columns: 20px minmax(0,1fr) 34px; gap: 8px; margin-bottom: 18px; padding: 0 6px 0 12px; background: var(--cn-surface-soft); border-color: var(--cn-border); }
.cn-search-form--mobile input { height: 44px; font-size: .86rem; }
.cn-drawer-overlay { position: fixed; inset: 0; z-index: 2000; background: rgba(21,27,32,.52); }
.cn-drawer { width: min(92vw,410px); height: 100%; margin-left: auto; overflow-y: auto; background: #fff; box-shadow: -20px 0 50px rgba(21,27,32,.18); }
.cn-drawer__head { min-height: 76px; display: flex; align-items: center; justify-content: space-between; padding: 0 22px; border-bottom: 1px solid var(--cn-border); }
.cn-drawer__body { padding: 16px 22px 30px; }
.cn-drawer__actions a { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 13px 0; color: var(--cn-ink); border-bottom: 1px solid var(--cn-border); font-size: .9rem; font-weight: 700; text-decoration: none; }

.cn-drawer-nav { display: grid; }
.cn-drawer-nav__group { border-bottom: 1px solid var(--cn-border); }
