.cn-gallery__thumbs { display: grid; grid-auto-flow: column; grid-auto-columns: 122px; justify-content: start; gap: 12px; margin-top: 14px; overflow-x: auto; overflow-y: hidden; padding: 0 0 3px; }
.cn-gallery__thumb {
    display: block;
