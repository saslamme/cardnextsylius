.cn-tabs__tab:first-child { border-left: 1px solid rgba(255,255,255,.08); }
.cn-tabs__tab:hover, .cn-tabs__tab:focus-visible, .cn-tabs__tab.is-active { color: #fff; background: rgba(255,255,255,.045); }
.cn-tabs__tab::after { position: absolute; right: 20px; bottom: 0; left: 20px; height: 3px; content: ""; background: var(--cn-primary); transform: scaleX(0); transform-origin: left center; }
.cn-tabs__tab.is-active::after { transform: scaleX(1); }
.cn-tabs__panel { padding: 48px 0 56px; }
.cn-tabs__panel--soft { background: var(--cn-surface-soft); }
.cn-tabs__panel[hidden] { display: none !important; }
.cn-specs { width: min(100%,980px); margin: 0; border-top: 1px solid var(--cn-border); }
.cn-specs__row { display: grid; grid-template-columns: minmax(180px,.38fr) minmax(0,.62fr); gap: 32px; padding: 14px 0; border-bottom: 1px solid var(--cn-border); }
.cn-specs__row dt { color: #707a81; font-size: .76rem; font-weight: 650; }
.cn-specs__row dd { margin: 0; color: var(--cn-ink); font-size: .82rem; font-weight: 700; }
.cn-resource-grid { max-width: 980px; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
.cn-resource { min-height: 82px; display: grid; grid-template-columns: 40px minmax(0,1fr) 30px; gap: 13px; align-items: center; padding: 15px; color: var(--cn-text); background: #fff; border: 1px solid var(--cn-border); border-left: 3px solid var(--cn-primary); border-radius: 3px; text-decoration: none; }
.cn-resource:hover { color: var(--cn-text); background: #fffaf8; border-color: rgba(233,81,38,.45); border-left-color: var(--cn-primary); }
.cn-resource__icon { width: 40px; height: 40px; display: grid; place-items: center; color: var(--cn-primary-hover); background: var(--cn-primary-soft); }
.cn-resource__icon svg { width: 19px; height: 19px; stroke: currentColor; }
.cn-resource__body { min-width: 0; }
.cn-resource__body strong { display: block; overflow: hidden; color: var(--cn-ink); font-size: .82rem; text-overflow: ellipsis; white-space: nowrap; }
.cn-resource__body span { display: block; margin-top: 3px; color: #7b858b; font-size: .7rem; }
.cn-resource__arrow { display: grid; place-items: center; color: var(--cn-primary-hover); font-size: .88rem; }

/* Generic panels / contact */
.cn-panel { padding: 36px 40px 40px; background: var(--cn-surface-soft); border: 1px solid var(--cn-border); border-radius: 0; }
.cn-panel__head { margin-bottom: 28px; padding-bottom: 22px; border-bottom: 1px solid var(--cn-border); }
.cn-panel__head .cn-title { margin-top: 8px; }
.cn-info-list { border-top: 1px solid var(--cn-border); }
.cn-info-list__item { display: grid; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--cn-border); }
.cn-info-list__item strong { color: var(--cn-ink); font-size: .9rem; }
.cn-info-list__item span { color: var(--cn-muted); font-size: .86rem; line-height: 1.55; }

@media (max-width: 1320px) {
    .cn-header__inner { grid-template-columns: 170px minmax(0,1fr) auto; gap: 16px; }
    .cn-logo img { width: 166px; }
    .cn-nav__link { padding-inline: 7px; font-size: .75rem; }
}
@media (max-width: 1199.98px) {
    :root { --cn-header-height: 72px; }
    .cn-utility { display: none; }
    .cn-desktop-only, .cn-nav-wrap { display: none !important; }
    .cn-menu-toggle { display: flex; }
    .cn-header__inner { grid-template-columns: minmax(0,1fr) auto; min-height: var(--cn-header-height); gap: 12px; }
    .cn-product-grid--4 { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .cn-split { grid-template-columns: 1fr; gap: 42px; }
    .cn-sticky { position: static; }
    .cn-footer__grid { grid-template-columns: 1.3fr repeat(2,1fr); }
    .cn-product-layout { grid-template-columns: minmax(0,1fr) minmax(390px,.9fr); gap: 42px; }
}
@media (max-width: 991.98px) {
    .cn-grid--3, .cn-grid--4 { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .cn-hero__grid { grid-template-columns: 1fr; }
    .cn-hero__copy { padding: 48px 24px; }
    .cn-hero__visual { min-height: 360px; border-top: 1px solid var(--cn-border); border-left: 0; }
    .cn-row { grid-template-columns: 48px 180px minmax(0,1fr) auto; }
    .cn-catalog { grid-template-columns: 1fr; gap: 24px; }
    .cn-sidebar { position: static; }
    .cn-product-layout { grid-template-columns: 1fr; gap: 34px; }
    .cn-summary { position: static; }
    .cn-footer__grid { grid-template-columns: 1fr 1fr; }
    .cn-footer__brand { grid-column: 1 / -1; }
}
@media (max-width: 767.98px) {
    :root { --cn-section-space: var(--cn-section-space-mobile); --cn-control-height: 46px; }
    .cn-container { padding-inline: 18px; }
    .cn-section-head { align-items: flex-start; flex-direction: column; }
    .cn-grid--2, .cn-grid--3, .cn-grid--4, .cn-product-grid, .cn-product-grid--4, .cn-product-grid--compact { grid-template-columns: 1fr; }
    .cn-hero__copy { padding: 46px 0; }
    .cn-hero__visual { min-height: 300px; }
    .cn-title--hero { font-size: clamp(2.45rem,12vw,3.35rem); }
    .cn-row { grid-template-columns: 42px 1fr; gap: 14px; }
    .cn-row__text, .cn-row > .cn-link { grid-column: 2; }
    .cn-cta__inner { align-items: flex-start; flex-direction: column; padding-block: 32px; }
    .cn-cta__inner .cn-btn { width: 100%; }
    .cn-toolbar { align-items: flex-start; flex-direction: column; }
    .cn-toolbar__actions { width: 100%; }
    .cn-gallery__stage { min-height: 360px; padding: 12px; }
    .cn-gallery__image { width: 100%; height: 336px; }
    .cn-gallery__thumbs { grid-auto-columns: 88px; overflow-x: auto; }
    .cn-gallery__thumb {
        width: 88px;
        height: 88px;
        min-width: 88px;
        min-height: 88px;
        max-width: 88px;
        max-height: 88px;
        padding: 7px;
    }
    .cn-price-panel__top { grid-template-columns: 1fr; gap: 13px; }
    .cn-stock { text-align: left; }
    .cn-purchase form { grid-template-columns: 86px minmax(0,1fr); }
    .cn-qty { width: 86px; }
    .cn-purchase__secondary, .cn-resource-grid { grid-template-columns: 1fr; }
    .cn-specs__row { grid-template-columns: 1fr; gap: 4px; }
    .cn-tabs__tab { min-height: 54px; padding-inline: 18px; font-size: .73rem; }
    .cn-tabs, .cn-tabs__list { min-height: 54px; }
    .cn-tabs__panel { padding: 36px 0 44px; }
    .cn-panel { padding: 26px 20px 24px; }
    .cn-footer__grid { grid-template-columns: 1fr; }
    .cn-footer__brand { grid-column: auto; }
    .cn-footer__bottom { align-items: flex-start; flex-direction: column; }
}
@media (max-width: 479.98px) {
    .cn-cluster > .cn-btn { width: 100%; }
    .cn-header__inner { gap: 6px; }
    .cn-logo img { width: 138px; }
    .cn-icon-btn, .cn-menu-toggle { width: 40px; height: 40px; flex-basis: 40px; }
}
@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; animation: none !important; }
}

/* ==========================================================================
   Shared icon sizing
   ========================================================================== */

/* Icons inside buttons always use a controlled size. */
.cn-btn > svg,
.btn > svg {
    width: 18px;
    height: 18px;
    max-width: 18px;
    max-height: 18px;
    flex: 0 0 18px;
    display: block;
    stroke: currentColor;
}

/* Slightly smaller icons for compact buttons. */
.cn-btn--small > svg,
.btn-sm > svg {
    width: 16px;
    height: 16px;
    max-width: 16px;
    max-height: 16px;
    flex-basis: 16px;
}


/* Purchase button participates in the form grid without stretching vertically. */
.cn-purchase__submit {
    width: 100%;
    min-height: 50px;
    height: 50px;
    align-self: end;
    grid-column: 2;
}



/* Cardnext category square media responsive */

@media (max-width: 767.98px) {
    .cn-product-card__media img,
    .cn-product-card__image {
        inset: 16px;
        width: calc(100% - 32px) !important;
        height: calc(100% - 32px) !important;
    }

    .cn-product-card__placeholder {
        inset: 14px;
    }
}


/* Cardnext category card gap responsive */

@media (max-width: 991.98px) {
    .cn-product-grid--lined {
        gap: 14px;
    }
}

@media (max-width: 767.98px) {
    .cn-product-grid--lined {
        gap: 12px;
    }
}
