.cn-hero { overflow: hidden; background: #fff; border-bottom: 1px solid var(--cn-border); }
.cn-hero__grid { min-height: 438px; display: grid; grid-template-columns: minmax(0,.96fr) minmax(460px,1.04fr); align-items: stretch; gap: 0; }
