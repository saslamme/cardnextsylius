{% set type = hookable_metadata.configuration.type|default('billing') %}
{% set title = hookable_metadata.configuration.title %}

<header class="cn-checkout-section__header">
    <div>
        <div class="cn-checkout-section__kicker">
            {{ type == 'billing' ? '01' : '02' }}
        </div>

        <h2 class="cn-checkout-section__title">
            {{ title|trans }}
        </h2>
    </div>

    <span class="cn-checkout-section__status">
        {{ type == 'billing' ? 'Rechnungsdaten' : 'Lieferdaten' }}
    </span>
</header>
