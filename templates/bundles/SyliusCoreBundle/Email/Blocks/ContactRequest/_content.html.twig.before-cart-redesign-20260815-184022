<div style="text-align: left; font-family: Arial, sans-serif;">
    <div style="margin-bottom: 18px;">
        <strong>Neue Kontaktanfrage</strong>
    </div>

    <table cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin-bottom: 24px;">
        <tr>
            <td style="padding: 5px 12px 5px 0; width: 140px; color: #6b747b;">Vorname</td>
            <td style="padding: 5px 0;"><strong>{{ data.firstName|default('') }}</strong></td>
        </tr>
        <tr>
            <td style="padding: 5px 12px 5px 0; color: #6b747b;">Name</td>
            <td style="padding: 5px 0;"><strong>{{ data.lastName|default('') }}</strong></td>
        </tr>
        {% if data.company|default('') %}
            <tr>
                <td style="padding: 5px 12px 5px 0; color: #6b747b;">Unternehmen</td>
                <td style="padding: 5px 0;">{{ data.company }}</td>
            </tr>
        {% endif %}
        {% if data.phoneNumber|default('') %}
            <tr>
                <td style="padding: 5px 12px 5px 0; color: #6b747b;">Telefon</td>
                <td style="padding: 5px 0;">{{ data.phoneNumber }}</td>
            </tr>
        {% endif %}
        <tr>
            <td style="padding: 5px 12px 5px 0; color: #6b747b;">E-Mail</td>
            <td style="padding: 5px 0;"><a href="mailto:{{ data.email }}">{{ data.email }}</a></td>
        </tr>
    </table>

    <div style="color: #6b747b; margin-bottom: 6px;">
        <strong>Nachricht</strong>
    </div>
    <div style="line-height: 1.6;">{{ data.message|nl2br }}</div>

    <div style="margin-top: 24px; color: #8b9499; font-size: 12px;">
        Datenschutzbestimmungen wurden beim Absenden akzeptiert.
    </div>
</div>
