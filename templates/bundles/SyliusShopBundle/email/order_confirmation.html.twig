{% extends '@SyliusCore/Email/orderConfirmation.html.twig' %}

{% block body %}
        {% import 'shared/order/_configured_item_snapshot.html.twig' as snapshot %}
        {% set is_de = localeCode starts with 'de' %}
        {% set emailBranding = cardnext_channel_email_branding(channel) %}
        {% set order_url = sylius_bundle_loaded_checker('SyliusShopBundle')
            ? sylius_channel_url(
                path('sylius_shop_order_show', {
                    'tokenValue': order.tokenValue,
                    '_locale': localeCode
                }),
                channel
            )
            : null
        %}

        {% set billing = order.billingAddress %}
        {% set shipping = order.shippingAddress %}
        {% set shipment = order.shipments|first %}
        {% set payment = order.payments|first %}

        <div style="margin:0;padding:0;background:#f5f6f8;font-family:Arial,Helvetica,sans-serif;color:#05053f;line-height:1.5;">
            <div style="max-width:680px;margin:0 auto;padding:32px 16px;">

                <div style="padding:0 4px 22px;text-align:left;">
                    {% if sylius_bundle_loaded_checker('SyliusShopBundle') %}
                        {% set homepage_url = sylius_channel_url(path('sylius_shop_homepage', {'_locale': localeCode}), channel) %}
                        <a href="{{ homepage_url|e('html_attr') }}" style="display:inline-block;text-decoration:none;">
                            <img src="{{ emailBranding.logoUrl|e('html_attr') }}" alt="{{ emailBranding.brandName|e('html_attr') }}" width="190" style="display:block;width:190px;max-width:100%;height:auto;border:0;">
                        </a>
                    {% else %}
                        <img src="{{ emailBranding.logoUrl|e('html_attr') }}" alt="{{ emailBranding.brandName|e('html_attr') }}" width="190" style="display:block;width:190px;max-width:100%;height:auto;border:0;">
                    {% endif %}
                </div>

                <div style="overflow:hidden;border:1px solid #e4e7ec;border-radius:10px;background:#ffffff;">
                    <div style="padding:30px;border-bottom:1px solid #e4e7ec;">
                        <div style="margin-bottom:7px;color:#f04b23;font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;">
                            {{ is_de ? 'Bestellbestätigung' : 'Order confirmation' }}
                        </div>

                        <h1 style="margin:0 0 10px;font-size:25px;line-height:1.2;font-weight:750;color:#05053f;">
                            {{ is_de ? 'Vielen Dank für Ihre Bestellung!' : 'Thank you for your order!' }}
                        </h1>

                        <p style="margin:0;color:#667085;font-size:14px;">
                            {% if billing and billing.firstName %}
                                {{ billing.firstName }},
                            {% endif %}
                            {{ is_de
                                ? 'Ihre Bestellung wurde erfolgreich übermittelt. Nachfolgend finden Sie alle Bestelldetails.'
                                : 'Your order has been submitted successfully. You can find all order details below.'
                            }}
                        </p>
                    </div>

                    <div style="padding:22px 30px;border-bottom:1px solid #e4e7ec;background:#fafafa;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                            <tr>
                                <td style="padding:0 12px 0 0;vertical-align:top;">
                                    <div style="color:#7b8494;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">
                                        {{ is_de ? 'Bestellnummer' : 'Order number' }}
                                    </div>
                                    <div style="margin-top:3px;font-size:17px;font-weight:800;color:#05053f;">
                                        {{ order.number }}
                                    </div>
                                </td>
                                <td style="padding:0 0 0 12px;vertical-align:top;text-align:right;">
                                    <div style="color:#7b8494;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">
                                        {{ 'sylius.ui.total'|trans({}, null, localeCode) }}
                                    </div>
                                    <div style="margin-top:3px;font-size:18px;font-weight:800;color:#05053f;">
                                        {{ order.total|sylius_format_money(order.currencyCode, localeCode) }}
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="padding:28px 30px 12px;">
                        <h2 style="margin:0 0 15px;font-size:16px;font-weight:750;color:#05053f;">
                            {{ 'sylius.ui.items'|trans({}, null, localeCode) }}
                        </h2>

                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                            {% for item in order.items %}
                                <tr>
                                    <td style="padding:13px 12px 13px 0;border-top:1px solid #eef0f3;vertical-align:top;">
                                        <div style="font-size:14px;font-weight:700;color:#05053f;">{{ item.productName }}</div>

                                        {% if item.variantName and item.variantName != item.productName %}
                                            <div style="margin-top:3px;color:#7b8494;font-size:12px;">{{ item.variantName }}</div>
                                        {% endif %}

                                        {% if item.variant and item.variant.code %}
                                            <div style="margin-top:3px;color:#7b8494;font-size:11px;">
                                                {{ is_de ? 'Art.-Nr.' : 'SKU' }} {{ item.variant.code }}
                                            </div>
                                        {% endif %}
                                    </td>

                                    <td style="width:55px;padding:13px 8px;border-top:1px solid #eef0f3;text-align:center;vertical-align:top;color:#667085;font-size:13px;">
                                        {{ item.quantity }} ×
                                    </td>

                                    <td style="width:110px;padding:13px 0 13px 12px;border-top:1px solid #eef0f3;text-align:right;vertical-align:top;font-size:14px;font-weight:750;color:#05053f;">
                                        {{ item.total|sylius_format_money(order.currencyCode, localeCode) }}
                                    </td>
                                </tr>
                            {% endfor %}
                            {% for item in order.configuredItems %}
                                <tr>
                                    <td style="padding:13px 12px 13px 0;border-top:1px solid #eef0f3;vertical-align:top;">
                                        <div style="font-size:14px;font-weight:700;color:#05053f;">{{ item.configuratorName }}</div>
                                        <div style="margin-top:3px;color:#7b8494;font-size:11px;">{{ 'cardnext.order.configured_product'|trans({}, null, localeCode) }}</div>
                                        {{ snapshot.render(item.selectionsSnapshot, 'email') }}
                                        {% if item.leadTimeName or item.workingDays %}
                                            <div style="margin-top:7px;color:#667085;font-size:12px;">
                                                <strong>{{ 'cardnext.order.production_time'|trans({}, null, localeCode) }}:</strong>
                                                {% if item.leadTimeName %}{{ item.leadTimeName }}{% endif %}
                                                {% if item.leadTimeName and item.workingDays %} &middot; {% endif %}
                                                {% if item.workingDays %}{{ 'cardnext.order.working_days'|trans({'%days%': item.workingDays}, null, localeCode) }}{% endif %}
                                            </div>
                                        {% endif %}
                                        <div style="margin-top:7px;color:#667085;font-size:12px;">
                                            {{ 'sylius.ui.unit_price'|trans({}, null, localeCode) }}: {{ item.unitAmount|sylius_format_money(order.currencyCode, localeCode) }}
                                        </div>
                                    </td>
                                    <td style="width:55px;padding:13px 8px;border-top:1px solid #eef0f3;text-align:center;vertical-align:top;color:#667085;font-size:13px;">
                                        <span style="font-size:11px;">{{ 'sylius.ui.quantity'|trans({}, null, localeCode) }}:</span><br>{{ item.quantity }}
                                    </td>
                                    <td style="width:110px;padding:13px 0 13px 12px;border-top:1px solid #eef0f3;text-align:right;vertical-align:top;font-size:14px;font-weight:750;color:#05053f;">
                                        <span style="color:#667085;font-size:11px;font-weight:400;">{{ 'sylius.ui.total'|trans({}, null, localeCode) }}:</span><br>{{ item.total|sylius_format_money(order.currencyCode, localeCode) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </div>

                    <div style="padding:8px 30px 26px;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                            <tr>
                                <td style="padding:7px 0;color:#667085;font-size:13px;">
                                    {{ 'sylius.ui.subtotal'|trans({}, null, localeCode) }}
                                </td>
                                <td style="padding:7px 0;text-align:right;color:#05053f;font-size:13px;">
                                    {{ order.itemsTotal|sylius_format_money(order.currencyCode, localeCode) }}
                                </td>
                            </tr>

                            {% if order.configuredItems|length > 0 %}
                                {% set configuredItemsTotal = 0 %}
                                {% for item in order.configuredItems %}
                                    {% set configuredItemsTotal = configuredItemsTotal + item.total %}
                                {% endfor %}
                                <tr>
                                    <td style="padding:7px 0;color:#667085;font-size:13px;">{{ 'cardnext.order.configured_items'|trans({}, null, localeCode) }}</td>
                                    <td style="padding:7px 0;text-align:right;color:#05053f;font-size:13px;">{{ configuredItemsTotal|sylius_format_money(order.currencyCode, localeCode) }}</td>
                                </tr>
                            {% endif %}

                            {% if order.shippingTotal != 0 %}
                                <tr>
                                    <td style="padding:7px 0;color:#667085;font-size:13px;">
                                        {{ 'sylius.ui.shipping_total'|trans({}, null, localeCode) }}
                                    </td>
                                    <td style="padding:7px 0;text-align:right;color:#05053f;font-size:13px;">
                                        {{ order.shippingTotal|sylius_format_money(order.currencyCode, localeCode) }}
                                    </td>
                                </tr>
                            {% endif %}

                            {% if order.taxTotal != 0 %}
                                <tr>
                                    <td style="padding:7px 0;color:#667085;font-size:13px;">
                                        {{ 'sylius.ui.taxes_total'|trans({}, null, localeCode) }}
                                    </td>
                                    <td style="padding:7px 0;text-align:right;color:#05053f;font-size:13px;">
                                        {{ order.taxTotal|sylius_format_money(order.currencyCode, localeCode) }}
                                    </td>
                                </tr>
                            {% endif %}

                            <tr>
                                <td style="padding:13px 0 0;border-top:1px solid #e4e7ec;color:#05053f;font-size:15px;font-weight:800;">
                                    {{ 'sylius.ui.total'|trans({}, null, localeCode) }}
                                </td>
                                <td style="padding:13px 0 0;border-top:1px solid #e4e7ec;text-align:right;color:#05053f;font-size:17px;font-weight:800;">
                                    {{ order.total|sylius_format_money(order.currencyCode, localeCode) }}
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="padding:0 30px 28px;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                            <tr>
                                <td width="50%" style="padding:18px 14px 18px 0;border-top:1px solid #e4e7ec;vertical-align:top;">
                                    <div style="margin-bottom:8px;color:#7b8494;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">
                                        {{ 'sylius.ui.billing_address'|trans({}, null, localeCode) }}
                                    </div>

                                    {% if billing %}
                                        <div style="font-size:13px;color:#05053f;">
                                            {% if billing.company %}{{ billing.company }}<br>{% endif %}
                                            {{ billing.firstName }} {{ billing.lastName }}<br>
                                            {{ billing.street }}<br>
                                            {{ billing.postcode }} {{ billing.city }}<br>
                                            {{ billing.countryCode|sylius_country_name(localeCode) }}
                                        </div>
                                    {% endif %}
                                </td>

                                <td width="50%" style="padding:18px 0 18px 14px;border-top:1px solid #e4e7ec;vertical-align:top;">
                                    <div style="margin-bottom:8px;color:#7b8494;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">
                                        {{ 'sylius.ui.shipping_address'|trans({}, null, localeCode) }}
                                    </div>

                                    {% if shipping %}
                                        <div style="font-size:13px;color:#05053f;">
                                            {% if shipping.company %}{{ shipping.company }}<br>{% endif %}
                                            {{ shipping.firstName }} {{ shipping.lastName }}<br>
                                            {{ shipping.street }}<br>
                                            {{ shipping.postcode }} {{ shipping.city }}<br>
                                            {{ shipping.countryCode|sylius_country_name(localeCode) }}
                                        </div>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    </div>

                    {% if shipment or payment %}
                        <div style="padding:20px 30px;border-top:1px solid #e4e7ec;background:#fafafa;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                <tr>
                                    {% if shipment %}
                                        <td width="50%" style="padding-right:12px;vertical-align:top;">
                                            <div style="color:#7b8494;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">
                                                {{ 'sylius.ui.shipping_method'|trans({}, null, localeCode) }}
                                            </div>
                                            <div style="margin-top:3px;color:#05053f;font-size:13px;font-weight:700;">
                                                {{ shipment.method.name|default('') }}
                                            </div>
                                        </td>
                                    {% endif %}

                                    {% if payment %}
                                        <td width="50%" style="padding-left:12px;vertical-align:top;text-align:right;">
                                            <div style="color:#7b8494;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">
                                                {{ 'sylius.ui.payment_method'|trans({}, null, localeCode) }}
                                            </div>
                                            <div style="margin-top:3px;color:#05053f;font-size:13px;font-weight:700;">
                                                {{ payment.method.name|default('') }}
                                            </div>
                                        </td>
                                    {% endif %}
                                </tr>
                            </table>
                        </div>
                    {% endif %}

                    {% if order_url %}
                        <div style="padding:25px 30px 30px;text-align:center;border-top:1px solid #e4e7ec;">
                            <a href="{{ order_url|e('html_attr') }}" style="display:inline-block;padding:13px 22px;border-radius:6px;background:#f04b23;color:#ffffff;font-size:13px;font-weight:700;text-decoration:none;">
                                {{ is_de ? 'Bestellung ansehen' : 'View order' }}
                            </a>
                        </div>
                    {% endif %}
                </div>

                <div style="padding:22px 6px 0;color:#8a93a3;font-size:11px;line-height:1.65;text-align:center;">
                    <div style="font-weight:700;color:#667085;">{{ emailBranding.brandName }}</div>
                    {% if channel.hostname %}<div>{{ channel.hostname }}{% if emailBranding.replyToAddress %} · {{ emailBranding.replyToAddress }}{% endif %}</div>{% endif %}
                    <div style="margin-top:4px;">
                        {{ is_de
                            ? 'Bei Fragen zu Ihrer Bestellung helfen wir Ihnen gerne weiter.'
                            : 'If you have any questions about your order, we will be happy to help.'
                        }}
                    </div>
                </div>
            </div>
        </div>
{% endblock %}
