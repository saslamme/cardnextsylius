{% set comparison_taxon = product.mainTaxon %}{% for i in 1..8 %}{% if comparison_taxon and comparison_taxon.parent and comparison_taxon.parent.code != 'products' %}{% set comparison_taxon = comparison_taxon.parent %}{% endif %}{% endfor %}
<aside class="cn-summary" {{ attributes }}><div class="cn-summary__inner" {{ sylius_test_html_attribute('product-box') }}>{% hook 'summary' with { product, variant } %}<button class="cn-btn cn-btn--secondary cn-compare-detail" type="button" data-compare-toggle data-product-code="{{ product.code }}" data-product-name="{{ product.name }}" data-product-group="{{ comparison_taxon ? comparison_taxon.code : '' }}" data-compare-url="{{ path('cardnext_shop_product_compare', {_locale: app.request.locale}) }}" aria-pressed="false" aria-label="{{ product.name }} zum Vergleich hinzufügen">Zum Vergleich hinzufügen</button></div></aside>
