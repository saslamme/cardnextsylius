{% set product = hookable_metadata.context.product %}{% set first_image = product.images.first %}
<div class="cn-gallery" data-cn-product-gallery>
<div class="cn-gallery__stage">
{% if product.mainTaxon %}<span class="cn-gallery__badge">{{ product.mainTaxon.name }}</span>{% endif %}
{% if first_image %}{% set main_path = first_image.path|imagine_filter('sylius_shop_product_large_thumbnail') %}<img class="cn-gallery__image" src="{{ main_path }}" alt="{{ product.name }}" data-cn-product-main-image>
{% else %}<div class="cn-gallery__placeholder" aria-label="Noch kein Produktbild hinterlegt"><svg viewBox="0 0 320 220" aria-hidden="true"><rect x="48" y="55" width="224" height="120" rx="8" fill="#e7eaec" stroke="#cbd0d4"/><rect x="72" y="82" width="176" height="54" rx="5" fill="#20272d"/><path d="M107 136h106v45H107z" fill="#fff" stroke="#d7dcdf"/><path d="M120 149h80v5h-80zm0 12h52v5h-52z" fill="#e95126"/></svg><span>Produktbild folgt</span></div>{% endif %}
</div>
{% if product.images|length > 1 %}<div class="cn-gallery__thumbs" aria-label="Weitere Produktbilder">{% for image in product.images %}{% set thumb_path = image.path|imagine_filter('sylius_shop_product_small_thumbnail') %}{% set large_path = image.path|imagine_filter('sylius_shop_product_large_thumbnail') %}<button class="cn-gallery__thumb {{ loop.first ? 'is-active' : '' }}" type="button" data-cn-product-thumb data-cn-product-image="{{ large_path }}" aria-label="Produktbild {{ loop.index }} anzeigen" aria-pressed="{{ loop.first ? 'true' : 'false' }}"><img src="{{ thumb_path }}" alt="" loading="lazy"></button>{% endfor %}</div>{% endif %}
<div class="cn-note"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8h.01M11 11h1v5h1"/></svg>Abbildung kann je nach gewählter Variante abweichen.</div>
</div>
