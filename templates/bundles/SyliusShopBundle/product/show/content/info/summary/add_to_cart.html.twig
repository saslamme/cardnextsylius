{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}
{% form_theme form '@SyliusShop/form/theme.html.twig' %}
{% set visible_product_attributes = cardnext_visible_product_attributes(product.attributes) %}

<div class="cn-product__purchase" {{ attributes }}>
    {% if product.enabledVariants.empty() or product.simple and not sylius_inventory_is_available(product.enabledVariants.first) %}
        <div class="cn-product__out-of-stock" {{ sylius_test_html_attribute('product-out-of-stock') }}>
            {{ 'sylius.ui.out_of_stock'|trans }}
        </div>
    {% else %}
        {{ loader.render() }}
        <div {{ sylius_test_html_attribute('product-selecting-variant') }}>
            {{ form_start(form, {'attr': {'data-action': 'live#action:prevent live#$render', 'data-live-action-param': 'addToCart'}}) }}
                {{ form_errors(form) }}
                {% hook 'add_to_cart' with { product, form } %}
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    {% endif %}

    <div class="cn-product__purchase-secondary">
        <a class="cn-product__secondary-action" href="{{ path('sylius_shop_contact_request') }}">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0v5a2 2 0 0 1-2 2h-2v-7h4M4 12v7h4v-7H4Z"/></svg>
            Beratung
        </a>
        {% if visible_product_attributes|length > 0 %}
            <a class="cn-product__secondary-action" href="#specifications">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v5h5M10 13h5M10 16h5"/></svg>
                Technische Daten
            </a>
        {% endif %}
    </div>

    <div class="cn-product__purchase-note">
        <div>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true"><path d="M4 7h12v10H4zM16 10h3l2 3v4h-5z"/><circle cx="8" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></svg>
            Versandart und Lieferkosten werden im Checkout anhand der Lieferadresse ermittelt.
        </div>
        <div>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.5 7.6 7 10 4.5-2.4 7-5.5 7-10V6Z"/><path d="m9 12 2 2 4-4"/></svg>
            B2B-Fachhandel mit persönlicher Beratung.
        </div>
    </div>
</div>
