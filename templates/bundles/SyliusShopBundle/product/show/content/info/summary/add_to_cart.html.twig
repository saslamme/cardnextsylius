{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Product\AddToCartFormComponent #}

{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% set cn_cart_return_route = app.request.attributes.get('_route') %}
{% set cn_cart_return_parameters = (app.request.attributes.get('_route_params')|default({}))|merge({
    'cnCart': 'open'
}) %}

<div class="cn-purchase position-relative" {{ attributes }}>
    {% if product.enabledVariants.empty() or product.simple and not sylius_inventory_is_available(product.enabledVariants.first) %}
        <div {{ sylius_test_html_attribute('product-out-of-stock') }}>{{ 'sylius.ui.out_of_stock'|trans }}</div>
    {% else %}
        {{ loader.render() }}

        <div class="my-4" {{ sylius_test_html_attribute('product-selecting-variant') }}>
            {{ form_start(form, {
                'attr': {
                    'data-action': 'live#action:prevent live#$render',
                    'data-live-action-param': 'addToCart',
                    'data-live-route-name-param': cn_cart_return_route,
                    'data-live-route-parameters-param': cn_cart_return_parameters|json_encode,
                    'data-live-add-flash-message-param': 'false'
                }
            }) }}

            {{ form_errors(form) }}

            {% hook 'add_to_cart' with { product, form } %}

            {{ form_end(form, {'render_rest': false}) }}
        </div>
    {% endif %}
</div>
