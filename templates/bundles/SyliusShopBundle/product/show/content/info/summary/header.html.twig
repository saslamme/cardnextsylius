{% set product = hookable_metadata.context.product %}{% set variant = hookable_metadata.context.variant|default(null) %}{% set manufacturer = product.manufacturer %}
<div class="cn-summary__header"><div class="cn-brand">{% if manufacturer %}{% if manufacturer.logoPath %}<img src="{{ asset(manufacturer.logoPath) }}" alt="{{ manufacturer.name }}">{% else %}<span>{{ manufacturer.name }}</span>{% endif %}{% else %}<span>{{ 'cardnext.storefront.product_detail.default_brand'|trans }}</span>{% endif %}</div>
<h1 class="cn-title cn-title--page" {{ sylius_test_html_attribute('product-name', product.name) }}>{{ product.name }}</h1>
<div class="cn-meta cn-cluster"><span>{{ 'cardnext.storefront.product_detail.product_code'|trans }}: <strong>{{ product.code }}</strong></span>{% if variant %}<span>{{ 'cardnext.storefront.product_card.sku'|trans }}: <strong>{{ variant.code }}</strong></span>{% endif %}</div></div>
