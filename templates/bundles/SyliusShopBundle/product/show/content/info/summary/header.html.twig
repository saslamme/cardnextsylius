{% set product = hookable_metadata.context.product %}
{% set variant = hookable_metadata.context.variant|default(null) %}
{% set manufacturer = product.manufacturer %}

<div class="cn-product__summary-header">
    <div class="cn-product__brandline {{ manufacturer and manufacturer.logoPath ? 'cn-product__brandline--logo-only' : '' }}">
        {% if manufacturer %}
            {% if manufacturer.logoPath %}
                <img
                    class="cn-product__brand-logo"
                    src="{{ asset(manufacturer.logoPath) }}"
                    alt="{{ manufacturer.name }}"
                >
            {% else %}
                <span class="cn-product__manufacturer-name">{{ manufacturer.name }}</span>
            {% endif %}
        {% else %}
            <span>Cardnext Sortiment</span>
        {% endif %}
    </div>

    <h1 {{ sylius_test_html_attribute('product-name', product.name) }}>{{ product.name }}</h1>

    <div class="cn-product__identifiers">
        <span>Produktcode: <strong>{{ product.code }}</strong></span>
        {% if variant %}
            <span>Art.-Nr.: <strong>{{ variant.code }}</strong></span>
        {% endif %}
    </div>
</div>
