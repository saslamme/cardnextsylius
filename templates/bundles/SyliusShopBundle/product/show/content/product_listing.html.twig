{% set product = hookable_metadata.context.product %}
{% set configuration = hookable_metadata.context.configuration %}
{% set attributes = product.getAttributesByLocale(configuration.request.locale, configuration.request.defaultLocale, sylius_base_locale)|sylius_sort_by('attribute.position') %}
{% set visible_attributes = cardnext_visible_product_attributes(attributes) %}
{% set documents = product.getPublicDocuments(sylius.localeCode) %}
{% set outgoing_compatibilities = product.getPublicCompatibilities() %}
{% set incoming_compatibilities = product.getPublicReverseCompatibilities() %}
{% set compatibility_count = outgoing_compatibilities|length + incoming_compatibilities|length %}

<nav class="cn-product__nav cn-product__nav--tabs" aria-label="Produktinformationen" data-cn-product-tabs>
    <div class="cardnext-container cn-product__nav-inner" role="tablist" aria-label="Produktinformationen">
        <button
            class="cn-product__tab is-active"
            id="tab-overview"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="overview"
            data-cn-product-tab="overview"
        >
            Beschreibung
        </button>

        {% if visible_attributes|length > 0 %}
            <button
                class="cn-product__tab"
                id="tab-specifications"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="specifications"
                data-cn-product-tab="specifications"
                tabindex="-1"
            >
                Technische Daten
            </button>
        {% endif %}

        {% if documents|length > 0 %}
            <button
                class="cn-product__tab"
                id="tab-downloads"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="downloads"
                data-cn-product-tab="downloads"
                tabindex="-1"
            >
                Downloads
            </button>
        {% endif %}

        {% if compatibility_count > 0 %}
            <button
                class="cn-product__tab"
                id="tab-compatibility"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="compatibility"
                data-cn-product-tab="compatibility"
                tabindex="-1"
            >
                Kompatible Produkte
            </button>
        {% endif %}

        {% if product.associations|length > 0 %}
            <button
                class="cn-product__tab"
                id="tab-accessories"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="accessories"
                data-cn-product-tab="accessories"
                tabindex="-1"
            >
                Zubehör &amp; Empfehlungen
            </button>
        {% endif %}
    </div>
</nav>

<div class="cn-product__tabpanels" data-cn-product-tabpanels>
    <section
        class="cn-product__section cn-product__tabpanel is-active"
        id="overview"
        role="tabpanel"
        aria-labelledby="tab-overview"
        data-cn-product-panel="overview"
    >
        <div class="cardnext-container">
            <div class="cn-product__description" {{ sylius_test_html_attribute('product-details') }}>
                {% if product.description %}
                    {{ product.description|raw }}
                {% elseif product.shortDescription %}
                    {{ product.shortDescription|raw }}
                {% endif %}
            </div>
        </div>
    </section>

    {% if visible_attributes|length > 0 %}
        <section
            class="cn-product__section cn-product__section--light cn-product__tabpanel"
            id="specifications"
            role="tabpanel"
            aria-labelledby="tab-specifications"
            data-cn-product-panel="specifications"
            hidden
        >
            <div class="cardnext-container">
                <dl class="cn-product__spec-table" {{ sylius_test_html_attribute('product-attributes') }}>
                    {% for attribute_value in visible_attributes %}
                        <div class="cn-product__spec-row">
                            <dt {{ sylius_test_html_attribute('product-attribute-name', attribute_value.name) }}>
                                {{ attribute_value.name }}
                            </dt>
                            <dd {{ sylius_test_html_attribute('product-attribute-value', attribute_value.name) }}>
                                {% include [
                                    '@SyliusAttribute/Types/' ~ attribute_value.type ~ '.html.twig',
                                    '@SyliusAttribute/Types/default.html.twig'
                                ] with {
                                    'attribute': attribute_value,
                                    'locale': configuration.request.locale,
                                    'fallbackLocale': configuration.request.defaultLocale
                                } %}
                            </dd>
                        </div>
                    {% endfor %}
                </dl>
            </div>
        </section>
    {% endif %}

    {% if documents|length > 0 %}
        <section
            class="cn-product__section cn-product__tabpanel"
            id="downloads"
            role="tabpanel"
            aria-labelledby="tab-downloads"
            data-cn-product-panel="downloads"
            hidden
        >
            <div class="cardnext-container">
                <div class="cn-product__downloads">
                    {% for document in documents %}
                        <a
                            class="cn-product__download"
                            href="{{ asset(document.filePath) }}"
                            target="_blank"
                            rel="noopener"
                        >
                            <span class="cn-product__download-icon">
                                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true">
                                    <path d="M7 3h7l4 4v14H7z"/>
                                    <path d="M14 3v5h5M10 13h5M10 16h5"/>
                                </svg>
                            </span>

                            <span class="cn-product__download-body">
                                <strong>{{ document.title }}</strong>
                                <span>
                                    {{ document.typeLabel }}
                                    {% if document.locale %} · {{ document.locale }}{% endif %}
                                    {% if document.formattedFileSize %} · {{ document.formattedFileSize }}{% endif %}
                                </span>
                            </span>

                            <span class="cn-product__download-arrow" aria-hidden="true">↗</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {% if compatibility_count > 0 %}
        <section
            class="cn-product__section cn-product__section--light cn-product__tabpanel"
            id="compatibility"
            role="tabpanel"
            aria-labelledby="tab-compatibility"
            data-cn-product-panel="compatibility"
            hidden
        >
            <div class="cardnext-container">
                {% if outgoing_compatibilities|length > 0 %}
                    <div class="cn-product__association">
                        <h3>Kompatibel mit</h3>

                        <div class="cn-product__association-grid">
                            {% for relation in outgoing_compatibilities %}
                                {% include 'shop/product/compatibility_card.html.twig' with {
                                    product: relation.targetProduct,
                                    relation: relation
                                } only %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if incoming_compatibilities|length > 0 %}
                    <div class="cn-product__association">
                        <h3>Passend zu diesem Produkt</h3>

                        <div class="cn-product__association-grid">
                            {% for relation in incoming_compatibilities %}
                                {% include 'shop/product/compatibility_card.html.twig' with {
                                    product: relation.sourceProduct,
                                    relation: relation
                                } only %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {% if product.associations|length > 0 %}
        <section
            class="cn-product__section cn-product__section--light cn-product__tabpanel"
            id="accessories"
            role="tabpanel"
            aria-labelledby="tab-accessories"
            data-cn-product-panel="accessories"
            hidden
        >
            <div class="cardnext-container">
                {% hook 'product_listing' %}
            </div>
        </section>
    {% endif %}
</div>
