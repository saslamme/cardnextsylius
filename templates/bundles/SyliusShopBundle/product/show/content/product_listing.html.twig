{% set product = hookable_metadata.context.product %}
{% set configuration = hookable_metadata.context.configuration %}
{% set attributes = product.getAttributesByLocale(configuration.request.locale, configuration.request.defaultLocale, sylius_base_locale)|sylius_sort_by('attribute.position') %}
{% set visible_attributes = cardnext_visible_product_attributes(attributes) %}
{% set documents = product.getPublicDocuments(sylius.localeCode) %}
{% set outgoing_compatibilities = product.getPublicCompatibilities() %}
{% set incoming_compatibilities = product.getPublicReverseCompatibilities() %}
{% set compatibility_count = outgoing_compatibilities|length + incoming_compatibilities|length %}
{% set device_groups = cardnext_device_groups(product) %}
{% set linked_device = cardnext_linked_device(product) %}
<nav class="cn-tabs" aria-label="{{ 'cardnext.storefront.product_detail.tabs.label'|trans }}" data-cn-product-tabs>
<div class="cn-container cn-tabs__list" role="tablist" aria-label="{{ 'cardnext.storefront.product_detail.tabs.label'|trans }}">
<button class="cn-tabs__tab is-active" id="tab-overview" type="button" role="tab" aria-selected="true" aria-controls="overview" data-cn-product-tab="overview">{{ 'cardnext.storefront.product_detail.tabs.description'|trans }}</button>
{% if visible_attributes|length > 0 %}<button class="cn-tabs__tab" id="tab-specifications" type="button" role="tab" aria-selected="false" aria-controls="specifications" data-cn-product-tab="specifications" tabindex="-1">{{ 'cardnext.storefront.product_detail.tabs.specifications'|trans }}</button>{% endif %}
{% if documents|length > 0 %}<button class="cn-tabs__tab" id="tab-downloads" type="button" role="tab" aria-selected="false" aria-controls="downloads" data-cn-product-tab="downloads" tabindex="-1">{{ 'cardnext.storefront.product_detail.tabs.downloads'|trans }}</button>{% endif %}
{% if compatibility_count > 0 or device_groups|length > 0 or linked_device %}<button class="cn-tabs__tab" id="tab-compatibility" type="button" role="tab" aria-selected="false" aria-controls="compatibility" data-cn-product-tab="compatibility" tabindex="-1">{{ 'cardnext.storefront.product_detail.tabs.compatibility'|trans }}</button>{% endif %}
{% if product.associations|length > 0 %}<button class="cn-tabs__tab" id="tab-accessories" type="button" role="tab" aria-selected="false" aria-controls="accessories" data-cn-product-tab="accessories" tabindex="-1">{{ 'cardnext.storefront.product_detail.tabs.accessories'|trans }}</button>{% endif %}
</div></nav>
<div data-cn-product-tabpanels>
<section class="cn-tabs__panel is-active" id="overview" role="tabpanel" aria-labelledby="tab-overview" data-cn-product-panel="overview"><div class="cn-container"><div class="cn-prose" {{ sylius_test_html_attribute('product-details') }}>{% if product.description %}{{ product.description|raw }}{% elseif product.shortDescription %}{{ product.shortDescription|raw }}{% endif %}</div></div></section>
{% if visible_attributes|length > 0 %}<section class="cn-tabs__panel cn-tabs__panel--soft" id="specifications" role="tabpanel" aria-labelledby="tab-specifications" data-cn-product-panel="specifications" hidden><div class="cn-container"><dl class="cn-specs" {{ sylius_test_html_attribute('product-attributes') }}>{% for attribute_value in visible_attributes %}<div class="cn-specs__row"><dt {{ sylius_test_html_attribute('product-attribute-name', attribute_value.name) }}>{{ attribute_value.name }}</dt><dd {{ sylius_test_html_attribute('product-attribute-value', attribute_value.name) }}>{% include ['@SyliusAttribute/Types/' ~ attribute_value.type ~ '.html.twig','@SyliusAttribute/Types/default.html.twig'] with {'attribute': attribute_value,'locale': configuration.request.locale,'fallbackLocale': configuration.request.defaultLocale} %}</dd></div>{% endfor %}</dl></div></section>{% endif %}
{% if documents|length > 0 %}<section class="cn-tabs__panel" id="downloads" role="tabpanel" aria-labelledby="tab-downloads" data-cn-product-panel="downloads" hidden><div class="cn-container"><div class="cn-resource-grid">{% for document in documents %}<a class="cn-resource" href="{{ asset(document.filePath) }}" target="_blank" rel="noopener"><span class="cn-resource__icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v5h5M10 13h5M10 16h5"/></svg></span><span class="cn-resource__body"><strong>{{ document.title }}</strong><span>{{ ('cardnext.storefront.product_detail.documents.types.' ~ document.type)|trans }}{% if document.locale %} · {{ document.locale }}{% endif %}{% if document.formattedFileSize %} · {{ document.formattedFileSize }}{% endif %}</span></span><span class="cn-resource__arrow" aria-hidden="true">↗</span></a>{% endfor %}</div></div></section>{% endif %}
{% if compatibility_count > 0 or device_groups|length > 0 or linked_device %}<section class="cn-tabs__panel cn-tabs__panel--soft" id="compatibility" role="tabpanel" aria-labelledby="tab-compatibility" data-cn-product-panel="compatibility" hidden><div class="cn-container">
{% if device_groups|length > 0 %}<div class="cn-device-compatibility"><h3 class="cn-title cn-title--sm">{{ 'cardnext.storefront.product_detail.compatibility.compatible_with'|trans }}</h3>{% for group in device_groups %}<div class="cn-device-compatibility__group"><strong>{{ group.name }}</strong><div>{% for device in group.devices %}<a href="{{ path('cardnext_shop_consumable_finder', {_locale: app.request.locale, device: device.slug}) }}">{{ device.name }} →</a>{% endfor %}</div></div>{% endfor %}</div>{% endif %}
{% if linked_device %}<div class="cn-device-compatibility"><h3 class="cn-title cn-title--sm">{{ 'cardnext.storefront.product_detail.compatibility.consumables'|trans }}</h3><p>{{ 'cardnext.storefront.product_detail.compatibility.consumables_text'|trans({'%product%': linked_device.manufacturer.name ~ ' ' ~ linked_device.name}) }}</p><a class="cn-link cn-link--arrow" href="{{ path('cardnext_shop_consumable_finder', {_locale: app.request.locale, device: linked_device.slug}) }}">{{ 'cardnext.storefront.product_detail.compatibility.find_consumables'|trans }}</a></div>{% endif %}
{% if outgoing_compatibilities|length > 0 %}<div class="cn-stack cn-stack--sm mb-5"><h3 class="cn-title cn-title--sm">{{ 'cardnext.storefront.product_detail.compatibility.compatible_with'|trans }}</h3><div class="cn-product-grid cn-product-grid--compact">{% for relation in outgoing_compatibilities %}{% include 'shop/product/compatibility_card.html.twig' with {product: relation.targetProduct, relation: relation} only %}{% endfor %}</div></div>{% endif %}
{% if incoming_compatibilities|length > 0 %}<div class="cn-stack cn-stack--sm"><h3 class="cn-title cn-title--sm">{{ 'cardnext.storefront.product_detail.compatibility.suitable_for_product'|trans }}</h3><div class="cn-product-grid cn-product-grid--compact">{% for relation in incoming_compatibilities %}{% include 'shop/product/compatibility_card.html.twig' with {product: relation.sourceProduct, relation: relation} only %}{% endfor %}</div></div>{% endif %}
</div></section>{% endif %}
{% if product.associations|length > 0 %}<section class="cn-tabs__panel cn-tabs__panel--soft" id="accessories" role="tabpanel" aria-labelledby="tab-accessories" data-cn-product-panel="accessories" hidden><div class="cn-container">{% hook 'product_listing' %}</div></section>{% endif %}
</div>
