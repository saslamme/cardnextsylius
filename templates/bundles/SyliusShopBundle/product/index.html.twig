{% import '@SyliusShop/shared/pagination/pagination.html.twig' as pagination %}
{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% set route = app.request.attributes.get('_route') %}
{% set route_parameters = app.request.attributes.all('_route_params')|merge(app.request.query.all) %}
{% set current_sorting = app.request.query.all('sorting') %}
{% set current_limit = app.request.query.get('limit', 9) %}
{% set result_count = resources.data.nbResults %}
{% block content %}
<main class="cn-page" id="main-content">
    {{ component('sylius_shop:product:show:breadcrumbs', {template: 'shop/category/breadcrumbs.html.twig'}) }}
    {{ component('sylius_shop:product:show:header', {template: 'shop/category/hero.html.twig'}) }}
    {{ component('sylius_shop:product:show:taxonomy', {template: 'shop/category/subcategories.html.twig'}) }}
    <section class="cn-section cn-section--compact" aria-label="Produktübersicht">
        <div class="cn-container cn-catalog">
            <aside class="cn-sidebar" aria-label="Produktfilter">
                <div class="cn-sidebar__head"><h2>Filter</h2>{% if app.request.query.has('criteria') %}<a href="{{ path('sylius_shop_product_index', {'slug': app.request.attributes.get('slug')}) }}">Zurücksetzen</a>{% endif %}</div>
                <form class="cn-filter-form" method="get" action="{{ path('sylius_shop_product_index', {'slug': app.request.attributes.get('slug')}) }}">
                    {% for key, value in current_sorting %}<input type="hidden" name="sorting[{{ key }}]" value="{{ value }}">{% endfor %}
                    <input type="hidden" name="limit" value="{{ current_limit }}"><input type="hidden" name="page" value="1">
                    {% for filter in products.definition.enabledFilters %}{% if filter.name != 'search' %}<div class="cn-filter">{{ sylius_grid_render_filter(products, filter) }}</div>{% endif %}{% endfor %}
                    <button class="cn-btn cn-btn--secondary cn-btn--small cn-btn--block mt-3" type="submit">Filter anwenden</button>
                </form>
            </aside>
            <div>
                <div class="cn-toolbar">
                    <div class="cn-toolbar__count"><strong>{{ result_count }} {{ result_count == 1 ? 'Produkt' : 'Produkte' }}</strong></div>
                    <div class="cn-toolbar__actions">
                        <div class="dropdown"><button class="cn-btn cn-btn--secondary cn-btn--small dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Sortieren</button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {}, 'page': 1})) }}">Position</a>
                                <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'name': 'asc'}, 'page': 1})) }}">Name A–Z</a>
                                <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'name': 'desc'}, 'page': 1})) }}">Name Z–A</a>
                                <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'createdAt': 'desc'}, 'page': 1})) }}">Neueste zuerst</a>
                                <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'price': 'asc'}, 'page': 1})) }}">Preis aufsteigend</a>
                                <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'price': 'desc'}, 'page': 1})) }}">Preis absteigend</a>
                            </div>
                        </div>
                        <div class="dropdown"><button class="cn-btn cn-btn--secondary cn-btn--small dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">{{ current_limit }} pro Seite</button>
                            <div class="dropdown-menu dropdown-menu-end">{% for limit in [9,18,27] %}<a class="dropdown-item" href="{{ path(route, route_parameters|merge({'limit': limit, 'page': 1})) }}">{{ limit }} pro Seite</a>{% endfor %}</div>
                        </div>
                    </div>
                </div>
                {% if resources.data|length > 0 %}
                    <div class="cn-product-grid cn-product-grid--lined" {{ sylius_test_html_attribute('products') }}>{% for product in resources.data %}{{ component('sylius_shop:product:card', {product: product, template: 'shop/category/product_card.html.twig'}) }}{% endfor %}</div>
                    <div class="mt-4">{{ pagination.simple(resources.data) }}</div>
                {% else %}
                    <div class="cn-panel"><strong>Keine Produkte gefunden.</strong><p class="mb-0 mt-1">Ändern Sie die Suche oder wählen Sie eine andere Produktkategorie.</p></div>
                {% endif %}
            </div>
        </div>
        {{ component('sylius_shop:product:show:header', {template: 'shop/category/bottom_description.html.twig'}) }}
    </section>
</main>
{% endblock %}
