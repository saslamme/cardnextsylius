{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% block title %}Cardnext – Kartendrucker, RFID & Auto-ID{% endblock %}
{% block content %}
<main id="main-content" class="cn-page">
<section class="cn-hero" aria-labelledby="cn-hero-title">
    <div class="cn-container cn-hero__grid">
        <div class="cn-stack cn-hero__copy">
            <span class="cn-kicker">Professionelle Identifikationstechnik</span>
            <h1 class="cn-title cn-title--hero" id="cn-hero-title">Technologie für sichere Identitäten.</h1>
            <p class="cn-lead">Kartendrucker, RFID-Leser, Plastikkarten und Auto-ID-Lösungen für Unternehmen, Integratoren und professionelle Anwender.</p>
            <div class="cn-cluster"><a class="cn-btn cn-btn--primary" href="#products">Produkte entdecken →</a><a class="cn-btn cn-btn--secondary" href="{{ path('sylius_shop_contact_request') }}">Beratung anfragen</a></div>
        </div>
        <div class="cn-hero__visual cn-hero__visual--photo" aria-label="Kartendrucker, RFID-Leser und Plastikkarten">
            <img class="cn-hero__photo" src="{{ asset('cardnext/homepage/hero-card-printer.webp') }}" alt="Professioneller Kartendrucker mit Plastikkarten am Arbeitsplatz" width="1600" height="900" loading="eager" fetchpriority="high">
</div>
    </div>
</section>
<section class="cn-home-categories" aria-labelledby="cn-popular-title">
    <div class="cn-container">
        <div class="cn-home-categories__head">
            <h2 id="cn-popular-title">Beliebte Kategorien</h2>
            <a class="cn-link cn-link--arrow" href="{{ path('sylius_shop_product_index', {'slug': 'produkte', '_locale': app.request.locale}) }}">
                Alle Kategorien
            </a>
        </div>

        {% set homeCategories = [
            {'name': 'Kartendrucker', 'slug': 'kartendrucker', 'image': 'kartendrucker.webp'},
            {'name': 'RFID-Leser', 'slug': 'rfid-leser', 'image': 'rfid-leser.webp'},
            {'name': 'Plastikkarten', 'slug': 'plastikkarten', 'image': 'plastikkarten.webp'},
            {'name': 'Kartenzubehör', 'slug': 'kartenzubehoer', 'image': 'kartenzubehoer.webp'},
            {'name': 'Farbbänder', 'slug': 'farbbaender', 'image': 'farbbaender.webp'},
            {'name': 'Barcode-Scanner', 'slug': 'barcode-scanner', 'image': 'barcode-scanner.webp'},
            {'name': 'Zeiterfassung', 'slug': 'zeiterfassung', 'image': 'zeiterfassung.webp'},
            {'name': 'Zutrittskontrolle', 'slug': 'zutrittskontrolle', 'image': 'zutrittskontrolle.webp'}
        ] %}

        <div class="cn-home-categories__grid">
            {% for category in homeCategories %}
                <a
                    class="cn-home-category"
                    href="{{ path('sylius_shop_product_index', {'slug': category.slug, '_locale': app.request.locale}) }}"
                >
                    <span class="cn-home-category__media">
                        <img
                            src="{{ asset('cardnext/homepage/categories/' ~ category.image) }}"
                            alt=""
                            width="1200"
                            height="580"
                            loading="lazy"
                        >
                    </span>
                    <span class="cn-home-category__label">
                        <strong>{{ category.name }}</strong>
                        <span aria-hidden="true">&#8594;</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
<section class="cn-home-service" id="services" aria-labelledby="cn-home-service-title">
    <div class="cn-container cn-home-service__grid">
        <div class="cn-home-service__feature">
            <div class="cn-home-service__copy">
                <span class="cn-kicker">Mehr als Hardware</span>
                <h2 class="cn-title cn-title--section" id="cn-home-service-title">
                    Technologieversorgung mit persönlichem Service.
                </h2>
                <p class="cn-lead">
                    Wir liefern nicht nur das Produkt. Wir helfen bei Auswahl, Kompatibilität und Konfiguration – und der zuverlässigen Versorgung mit passendem Zubehör und Verbrauchsmaterial.
                </p>
                <a class="cn-btn cn-btn--secondary" href="{{ path('sylius_shop_contact_request') }}">
                    Mehr über unseren Service &#8594;
                </a>
            </div>

            <div class="cn-home-service__photo">
                <img
                    src="{{ asset('cardnext/homepage/service-consultation.webp') }}"
                    alt="Persönliche Beratung zu professioneller Identifikationstechnik"
                    width="1200"
                    height="1060"
                    loading="lazy"
                >
            </div>
        </div>

        <div class="cn-home-service__list">
            <a class="cn-home-service__item" href="{{ path('sylius_shop_contact_request') }}">
                <span class="cn-home-service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <circle cx="9" cy="8" r="3"/>
                        <circle cx="16.5" cy="9.5" r="2.5"/>
                        <path d="M3.5 20c.5-4 2.6-6 5.5-6s5 2 5.5 6"/>
                        <path d="M13 15.2c1-.8 2.2-1.2 3.5-1.2 2.4 0 4 1.7 4.3 5"/>
                    </svg>
                </span>
                <span class="cn-home-service__item-copy">
                    <strong>Auswahl &amp; Beratung</strong>
                    <span>Wir finden die passende Lösung für Ihren Bedarf.</span>
                </span>
                <span class="cn-home-service__arrow" aria-hidden="true">&#8594;</span>
            </a>

            <a class="cn-home-service__item" href="{{ path('sylius_shop_contact_request') }}">
                <span class="cn-home-service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <circle cx="12" cy="12" r="3.2"/>
                        <path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4"/>
                    </svg>
                </span>
                <span class="cn-home-service__item-copy">
                    <strong>Konfiguration</strong>
                    <span>Kompatibel und optimal eingestellt.</span>
                </span>
                <span class="cn-home-service__arrow" aria-hidden="true">&#8594;</span>
            </a>

            <a class="cn-home-service__item" href="{{ path('sylius_shop_contact_request') }}">
                <span class="cn-home-service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M3.5 7.5h6l1.6 2H20.5v9.5H3.5z"/>
                        <path d="M3.5 7.5V5h6l1.5 2"/>
                    </svg>
                </span>
                <span class="cn-home-service__item-copy">
                    <strong>Projektgeschäft</strong>
                    <span>Individuelle Konzepte für Ihr Unternehmen.</span>
                </span>
                <span class="cn-home-service__arrow" aria-hidden="true">&#8594;</span>
            </a>

            <a class="cn-home-service__item" href="{{ path('sylius_shop_product_index', {'slug': 'farbbaender', '_locale': app.request.locale}) }}">
                <span class="cn-home-service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="m12 3 7 4v10l-7 4-7-4V7z"/>
                        <path d="m5 7 7 4 7-4M12 11v10"/>
                        <circle cx="12" cy="7.2" r="1.2"/>
                    </svg>
                </span>
                <span class="cn-home-service__item-copy">
                    <strong>Verbrauchsmaterial</strong>
                    <span>Farbbänder, Karten und Reinigungskarten direkt verfügbar.</span>
                </span>
                <span class="cn-home-service__arrow" aria-hidden="true">&#8594;</span>
            </a>
        </div>
    </div>
</section>
<section class="cn-section" id="products"><div class="cn-container"><div class="cn-section-head"><div class="cn-stack cn-stack--sm"><span class="cn-kicker">Ausgewählte Produkte</span><h2 class="cn-title cn-title--section">Professionelle Hardware.</h2></div></div>{% set homepage_products = cardnext_homepage_products(4) %}
            {% include 'shop/homepage/product_list.html.twig' with { products: homepage_products } only %}</div></section>
<section class="cn-section cn-section--soft" id="industries"><div class="cn-container">
    <div class="cn-stack cn-stack--sm mb-4"><span class="cn-kicker">Einsatzbereiche</span><h2 class="cn-title cn-title--section">Technologie, die zu Ihrem Einsatz passt.</h2><p class="cn-lead">Von der Mitarbeiterausweiserstellung bis zur RFID-gestützten Identifikation: Produkte und Zubehör werden nach Anwendung gedacht, nicht nur nach Hersteller.</p></div>
    <div class="cn-grid cn-grid--3">
        <article class="cn-card"><div class="cn-card__media cn-card__media--photo"><img class="cn-card__photo" src="{{ asset('cardnext/homepage/industry-id-cards.webp') }}" alt="Mitarbeiterausweis in einem professionellen Kartenhalter" width="1200" height="700" loading="lazy"></div><div class="cn-card__body"><h3>Ausweise & Kartenausgabe</h3><p>Kartendrucker, Farbbänder, Plastikkarten und Zubehör für Mitarbeiterausweise, Besucherkarten und Mitgliedsausweise.</p><a class="cn-link cn-link--arrow" href="#products">Lösungen ansehen</a></div></article>
        <article class="cn-card"><div class="cn-card__media cn-card__media--photo"><img class="cn-card__photo" src="{{ asset('cardnext/homepage/industry-rfid.webp') }}" alt="Kontaktlose Identifikation mit RFID-Karte an einem Zutrittsleser" width="1200" height="700" loading="lazy"></div><div class="cn-card__body"><h3>Sichere Identifikation</h3><p>RFID-Leser, Smartcards und Identmedien für Login, Zutritt und eindeutige Benutzeridentifikation.</p><a class="cn-link cn-link--arrow" href="#products">Lösungen ansehen</a></div></article>
        <article class="cn-card"><div class="cn-card__media cn-card__media--photo"><img class="cn-card__photo" src="{{ asset('cardnext/homepage/industry-logistics.webp') }}" alt="Barcode-Erfassung in einem professionellen Lager" width="1200" height="700" loading="lazy"></div><div class="cn-card__body"><h3>Lager & Logistik</h3><p>RFID- und Barcode-Technologie für Erfassung, Rückverfolgbarkeit und effiziente Materialbewegungen.</p><a class="cn-link cn-link--arrow" href="#products">Lösungen ansehen</a></div></article>
    </div>
</div></section>
<section class="cn-section" id="why-cardnext"><div class="cn-container"><div class="cn-split mb-4"><div class="cn-stack cn-stack--sm"><span class="cn-kicker">Warum Cardnext</span><h2 class="cn-title cn-title--section">Technik. Know-how. Verlässlichkeit.</h2></div><p class="cn-lead">Ein fokussierter Partner für professionelle Identifikations- und Auto-ID-Technik – mit direkter Beratung und einem klar strukturierten Produktsortiment.</p></div><div class="cn-grid cn-grid--4 cn-grid--lined">{% set advantages = [['01','Spezialisiertes Sortiment','Fokus auf Kartendruck, RFID, Identifikation und professionelle Auto-ID-Technik.'],['02','Herstellerübergreifend','Produkte verschiedener etablierter Hersteller können passend zur Anwendung verglichen werden.'],['03','Kompatibilität im Blick','Zubehör und Verbrauchsmaterial werden technisch den passenden Geräten zugeordnet.'],['04','Persönlicher Kontakt','Bei Projekt- und Beratungsbedarf gibt es einen direkten Ansprechpartner statt anonymer Shop-Prozesse.']] %}{% for item in advantages %}<div class="cn-feature"><span class="cn-feature__index">{{ item[0] }}</span><h3>{{ item[1] }}</h3><p>{{ item[2] }}</p></div>{% endfor %}</div></div></section>
<section class="cn-cta cn-cta--support">
    <img class="cn-cta__background"
        src="{{ asset('cardnext/homepage/support-advisor.webp') }}"
        alt=""
        width="1800"
        height="360"
        loading="lazy"
        aria-hidden="true">
    <div class="cn-container cn-cta__inner">
        <div class="cn-cta__copy">
            <h2>Nicht sicher, welches Produkt passt?</h2>
            <p>Wir helfen Ihnen bei der Auswahl.</p>
        </div>

        <a class="cn-btn cn-btn--primary cn-cta__button" href="{{ path('sylius_shop_contact_request') }}">
            Jetzt beraten lassen &#8594;
        </a>
    </div>
</section>

<div class="cn-promise-bar">
    <div class="cn-container cn-promise-grid">
        <div class="cn-promise">
            <span class="cn-promise__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M3 6.5h11v10H3z"/>
                    <path d="M14 10h3.3l3 3v3.5H14z"/>
                    <circle cx="7" cy="18" r="1.8"/>
                    <circle cx="17.5" cy="18" r="1.8"/>
                </svg>
            </span>
            <span class="cn-promise__copy">
                <strong>Schneller Versand</strong>
                <span>Für verfügbare Lagerartikel</span>
            </span>
        </div>

        <div class="cn-promise">
            <span class="cn-promise__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="12" cy="8" r="3.2"/>
                    <path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/>
                </svg>
            </span>
            <span class="cn-promise__copy">
                <strong>Persönliche Beratung</strong>
                <span>Vor und nach dem Kauf</span>
            </span>
        </div>

        <div class="cn-promise">
            <span class="cn-promise__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3.5" y="6" width="17" height="12" rx="1.8"/>
                    <path d="M3.5 10h17"/>
                    <path d="M7 15h3"/>
                </svg>
            </span>
            <span class="cn-promise__copy">
                <strong>Sichere Zahlung</strong>
                <span>Professionelle Zahlungsabwicklung</span>
            </span>
        </div>

        <div class="cn-promise">
            <span class="cn-promise__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M8 7V5.5C8 4.7 8.7 4 9.5 4h5c.8 0 1.5.7 1.5 1.5V7"/>
                    <rect x="3.5" y="7" width="17" height="12.5" rx="1.8"/>
                    <path d="M3.5 12h17"/>
                    <path d="M10 12v2h4v-2"/>
                </svg>
            </span>
            <span class="cn-promise__copy">
                <strong>Projektgeschäft</strong>
                <span>Individuelle Lösungen auf Anfrage</span>
            </span>
        </div>
    </div>
</div>
</main>
{% endblock %}
