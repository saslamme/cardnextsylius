{% set cms = cardnext_cms_homepage() %}
{% extends cms ? '@SyliusShop/shared/layout/base.html.twig' : 'bundles/SyliusShopBundle/homepage/_legacy.html.twig' %}

{% block title %}{% if cms %}{{ cms.translation.metaTitle ?: cms.translation.title }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block metatags %}
{% if cms %}
    {{ parent() }}
    {% set seoTitle = cms.translation.metaTitle ?: cms.translation.title %}
    {% set seoDescription = cms.translation.metaDescription %}
    {% if seoDescription %}<meta name="description" content="{{ seoDescription }}">{% endif %}
    <meta name="robots" content="{{ (cms.translation.robotsIndex ? 'index' : 'noindex') ~ ',' ~ (cms.translation.robotsFollow ? 'follow' : 'nofollow') }}">
    <link rel="canonical" href="{{ cms.translation.canonicalUrl ?: absolute_url('/') }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ cms.translation.canonicalUrl ?: absolute_url('/') }}">
    <meta property="og:title" content="{{ cms.translation.ogTitle ?: seoTitle }}">
    {% if cms.translation.ogDescription ?: seoDescription %}<meta property="og:description" content="{{ cms.translation.ogDescription ?: seoDescription }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ cms.translation.ogTitle ?: seoTitle }}">
    {% if cms.translation.ogDescription ?: seoDescription %}<meta name="twitter:description" content="{{ cms.translation.ogDescription ?: seoDescription }}">{% endif %}
{% else %}{{ parent() }}{% endif %}
{% endblock %}

{% block content %}
{% if cms %}
<main id="main-content" class="cn-page cardnext-cms cardnext-cms--homepage cardnext-cms--{{ cms.page.layout.renderer }}">
    {% set blocks = cms.page.blocks|filter(block => block.enabled and block.locale == cms.locale)|sort((a, b) => a.position <=> b.position) %}
    {% set promoBlocks = blocks|filter(block => block.type == 'homepage_promo') %}
    {% set promosRendered = false %}
    {% for block in blocks %}
        {% if block.type == 'homepage_promo' %}
            {% if not promosRendered %}{% include 'shop/cms/block/_homepage_promos.html.twig' with {promoBlocks: promoBlocks} only %}{% set promosRendered = true %}{% endif %}
        {% else %}
            {% include cardnext_cms_block_template(block.type) with {config: block.configuration, homepage: true} only %}
        {% endif %}
    {% endfor %}
</main>
{% else %}{{ parent() }}{% endif %}
{% endblock %}
