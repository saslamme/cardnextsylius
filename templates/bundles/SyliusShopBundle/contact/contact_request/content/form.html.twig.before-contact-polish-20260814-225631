{% set form = hookable_metadata.context.form %}

{{ form_start(form, {
    'action': path('sylius_shop_contact_request'),
    'attr': {
        'novalidate': 'novalidate',
        'class': 'cn-contact-form__form'
    }
}) }}

    <div class="cn-contact-form__row">
        {{ form_row(form.firstName, {
            'attr': {
                'autocomplete': 'given-name',
                'placeholder': 'Vorname'
            }
        }) }}

        {{ form_row(form.lastName, {
            'attr': {
                'autocomplete': 'family-name',
                'placeholder': 'Name'
            }
        }) }}
    </div>

    <div class="cn-contact-form__row">
        {{ form_row(form.company, {
            'attr': {
                'autocomplete': 'organization',
                'placeholder': 'Unternehmen'
            }
        }) }}

        {{ form_row(form.phoneNumber, {
            'attr': {
                'autocomplete': 'tel',
                'placeholder': '+49 ...'
            }
        }) }}
    </div>

    {{ form_row(form.email, sylius_test_form_attribute('contact-email')|merge({
        'attr': {
            'placeholder': 'name@unternehmen.de',
            'autocomplete': 'email'
        }
    })) }}

    {{ form_row(form.message, sylius_test_form_attribute('contact-message')|merge({
        'attr': {
            'placeholder': 'Produkt, Hersteller, Artikelnummer oder Anwendungsfall …',
            'rows': 6
        }
    })) }}

    <div class="cn-contact-form__privacy">
        {{ form_row(form.privacyAccepted) }}
        <p>
            Weitere Informationen zur Verarbeitung Ihrer Daten finden Sie in unserer Datenschutzerklärung.
        </p>
    </div>

    <button
        type="submit"
        class="cn-contact-form__submit"
        {{ sylius_test_html_attribute('contact-send') }}
    >
        Nachricht senden
        <span aria-hidden="true">&#8594;</span>
    </button>

{{ form_end(form, {'render_rest': false}) }}
