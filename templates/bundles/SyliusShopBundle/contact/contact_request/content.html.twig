<main class="cn-contact-page cn-contact-page--compact">
    <section class="cn-contact-main">
        <div class="cardnext-container">
            <div class="cn-contact-main__grid">
                <aside class="cn-contact-intro">
                    <span class="cardnext-smallcap">Kontakt & Beratung</span>
                    <h1>Wie können wir helfen?</h1>
                    <p class="cn-contact-intro__lead">
                        Sie haben eine Frage zu einem Produkt, zur Kompatibilität oder zu einem Projekt?
                        Schreiben Sie uns kurz, worum es geht.
                    </p>

                    <div class="cn-contact-intro__items">
                        <div>
                            <strong>Produktberatung</strong>
                            <span>Passende Hardware, Zubehör und Verbrauchsmaterialien.</span>
                        </div>
                        <div>
                            <strong>Technische Fragen</strong>
                            <span>Schnittstellen, RFID, Kodierung und Kompatibilität.</span>
                        </div>
                        <div>
                            <strong>Projektgeschäft</strong>
                            <span>Größere Mengen, Rollouts und wiederkehrende Bedarfe.</span>
                        </div>
                    </div>
                </aside>

                <div class="cn-contact-form">
                    {% hook 'content' %}
                </div>
            </div>
        </div>
    </section>
</main>
