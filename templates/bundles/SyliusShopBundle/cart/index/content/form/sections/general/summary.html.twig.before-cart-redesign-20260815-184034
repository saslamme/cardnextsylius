{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}
<div class="position-relative" {{ attributes }}>
    {{ loader.render() }}
    <section class="cn-cart-summary">
        <header class="cn-cart-summary__header">
            <div><span class="cn-cart-summary__kicker">Bestellung</span><h2>{{ 'sylius.ui.summary'|trans }}</h2></div>
        </header>
        <div class="cn-cart-summary__body">{% hook 'summary' with {cart} %}</div>
    </section>
</div>
