{% set form = hookable_metadata.context.form %}
{% set prefixes = hookable_metadata.prefixes|merge(['sylius_shop.shared.form']) %}

<section class="cn-checkout-section cn-checkout-section--address">
    <div class="cn-checkout-section__header">
        <div>
            <div class="cn-checkout-section__kicker">01</div>
            <h2 class="cn-checkout-section__title">{{ 'sylius.ui.billing_address'|trans }}</h2>
        </div>
    </div>

    <div class="cn-checkout-section__body">
        <div class="cn-checkout-address-book">
            {{ component('sylius_shop:checkout:address:address_book', {type: 'billingAddress'}) }}
        </div>

        {% hook 'address' with { _prefixes: prefixes, 'form': form.billingAddress, 'type': 'billing' } %}
    </div>
</section>
