{% if hookable_metadata.context.default_address is defined %}
    {% set default_address = hookable_metadata.context.default_address %}
    <section class="cn-address-card cn-address-card--default">
        <div class="cn-address-card__accent"></div>
        <div class="cn-address-card__body" {{ sylius_test_html_attribute('default-address') }}>
            {% hook 'default' with { address: default_address } %}
        </div>
    </section>
{% endif %}
