{% set billing = order.billingAddress %}
{% set shipping = order.shippingAddress %}
{% set shipment = order.shipments|first %}
{% set payment = order.payments|first %}
{% set customer = order.customer %}
{% set configuredItemsTotal = 0 %}
{% import 'shared/order/_configured_item_snapshot.html.twig' as configuredItemSnapshot %}

{% for configuredItem in order.configuredItems %}
    {% set configuredItemsTotal = configuredItemsTotal + configuredItem.total %}
{% endfor %}

<div style="margin:0;padding:24px;background:#f5f6f8;font-family:Arial,Helvetica,sans-serif;color:#05053f;">
    <div style="max-width:720px;margin:0 auto;background:#fff;border:1px solid #e4e7ec;border-radius:10px;overflow:hidden;">

        <div style="padding:25px 28px;background:#05053f;color:#fff;">
            <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#b9c7d8;">
                Neue Bestellung
            </div>
            <div style="margin-top:5px;font-size:23px;font-weight:800;">
                Bestellung #{{ order.number }}
            </div>
            <div style="margin-top:5px;font-size:13px;color:#d4dce5;">
                {% if customer %}{{ customer.email }}{% endif %}
            </div>
        </div>

        <div style="padding:22px 28px;background:#fafafa;border-bottom:1px solid #e4e7ec;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td style="font-size:12px;color:#6d7b8d;">
                        Bestellwert
                        <div style="margin-top:3px;font-size:20px;font-weight:800;color:#05053f;">
                            {{ order.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </div>
                    </td>
                    <td style="font-size:12px;color:#6d7b8d;text-align:right;">
                        Positionen
                        <div style="margin-top:3px;font-size:20px;font-weight:800;color:#05053f;">
                            {{ order.items|length + order.configuredItems|length }}
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div style="padding:24px 28px;">
            <div style="margin-bottom:12px;font-size:14px;font-weight:800;">Artikel</div>

            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                {% for item in order.items %}
                    <tr>
                        <td style="padding:11px 10px 11px 0;border-top:1px solid #eef0f3;vertical-align:top;">
                            <div style="font-size:13px;font-weight:700;">{{ item.productName }}</div>
                            {% if item.variant and item.variant.code %}
                                <div style="margin-top:2px;font-size:11px;color:#7b8494;">
                                    Art.-Nr. {{ item.variant.code }}
                                </div>
                            {% endif %}
                        </td>
                        <td style="width:60px;padding:11px 8px;border-top:1px solid #eef0f3;text-align:center;vertical-align:top;font-size:12px;color:#667085;">
                            {{ item.quantity }} ×
                        </td>
                        <td style="width:110px;padding:11px 0 11px 10px;border-top:1px solid #eef0f3;text-align:right;vertical-align:top;font-size:13px;font-weight:700;">
                            {{ item.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </td>
                    </tr>
                {% endfor %}
                {% for item in order.configuredItems %}
                    <tr>
                        <td style="padding:11px 10px 11px 0;border-top:1px solid #eef0f3;vertical-align:top;">
                            <div style="font-size:13px;font-weight:700;">{{ item.configuratorName }}</div>
                            <div style="margin-top:2px;font-size:11px;color:#7b8494;">Konfiguriertes Produkt</div>

                            <div style="margin-top:7px;">
                                {{ configuredItemSnapshot.render(item.selectionsSnapshot, 'email') }}
                            </div>

                            {% if item.leadTimeName or item.workingDays is not null %}
                                <div style="margin-top:7px;font-size:11px;color:#7b8494;">Produktionszeit</div>
                                <div style="margin-top:2px;font-size:12px;color:#05053f;">
                                    {% if item.leadTimeName %}{{ item.leadTimeName }}{% endif %}{% if item.leadTimeName and item.workingDays is not null %} · {% endif %}{% if item.workingDays is not null %}ca. {{ item.workingDays }} Arbeitstage{% endif %}
                                </div>
                            {% endif %}
                        </td>
                        <td style="width:100px;padding:11px 8px;border-top:1px solid #eef0f3;text-align:center;vertical-align:top;font-size:12px;color:#667085;">
                            <div>{{ item.quantity }} ×</div>
                            <div style="margin-top:3px;font-size:11px;white-space:nowrap;">
                                {{ item.unitAmount|sylius_format_money(order.currencyCode, order.localeCode) }} / Stück
                            </div>
                        </td>
                        <td style="width:110px;padding:11px 0 11px 10px;border-top:1px solid #eef0f3;text-align:right;vertical-align:top;font-size:13px;font-weight:700;">
                            {{ item.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>

        <div style="padding:0 28px 24px;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                {% if order.items|length > 0 %}
                    <tr>
                        <td style="padding:7px 0;font-size:12px;color:#667085;">Artikel</td>
                        <td style="padding:7px 0;text-align:right;font-size:12px;">
                            {{ order.itemsTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </td>
                    </tr>
                {% endif %}
                {% if order.configuredItems|length > 0 %}
                    <tr>
                        <td style="padding:7px 0;font-size:12px;color:#667085;">Konfigurierte Artikel</td>
                        <td style="padding:7px 0;text-align:right;font-size:12px;">
                            {{ configuredItemsTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </td>
                    </tr>
                {% endif %}
                <tr>
                    <td style="padding:7px 0;font-size:12px;color:#667085;">Versand</td>
                    <td style="padding:7px 0;text-align:right;font-size:12px;">
                        {{ order.shippingTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:7px 0;font-size:12px;color:#667085;">Steuern</td>
                    <td style="padding:7px 0;text-align:right;font-size:12px;">
                        {{ order.taxTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:12px 0 0;border-top:1px solid #e4e7ec;font-size:14px;font-weight:800;">Gesamt</td>
                    <td style="padding:12px 0 0;border-top:1px solid #e4e7ec;text-align:right;font-size:16px;font-weight:800;">
                        {{ order.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
            </table>
        </div>

        <div style="padding:22px 28px;border-top:1px solid #e4e7ec;background:#fafafa;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td width="50%" style="padding-right:14px;vertical-align:top;">
                        <div style="margin-bottom:7px;font-size:11px;font-weight:700;text-transform:uppercase;color:#7b8494;">Rechnungsadresse</div>
                        {% if billing %}
                            <div style="font-size:12px;line-height:1.55;">
                                {% if billing.company %}{{ billing.company }}<br>{% endif %}
                                {{ billing.firstName }} {{ billing.lastName }}<br>
                                {{ billing.street }}<br>
                                {{ billing.postcode }} {{ billing.city }}<br>
                                {{ billing.countryCode }}
                            </div>
                        {% endif %}
                    </td>

                    <td width="50%" style="padding-left:14px;vertical-align:top;">
                        <div style="margin-bottom:7px;font-size:11px;font-weight:700;text-transform:uppercase;color:#7b8494;">Lieferadresse</div>
                        {% if shipping %}
                            <div style="font-size:12px;line-height:1.55;">
                                {% if shipping.company %}{{ shipping.company }}<br>{% endif %}
                                {{ shipping.firstName }} {{ shipping.lastName }}<br>
                                {{ shipping.street }}<br>
                                {{ shipping.postcode }} {{ shipping.city }}<br>
                                {{ shipping.countryCode }}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>

        <div style="padding:18px 28px;border-top:1px solid #e4e7ec;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td style="font-size:12px;color:#667085;">
                        Versandart
                        <div style="margin-top:2px;font-weight:700;color:#05053f;">
                            {{ shipment ? shipment.method.name : '—' }}
                        </div>
                    </td>
                    <td style="font-size:12px;color:#667085;text-align:right;">
                        Zahlungsart
                        <div style="margin-top:2px;font-weight:700;color:#05053f;">
                            {{ payment ? payment.method.name : '—' }}
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        {% if order.notes %}
            <div style="padding:18px 28px;border-top:1px solid #e4e7ec;">
                <div style="margin-bottom:5px;font-size:11px;font-weight:700;text-transform:uppercase;color:#7b8494;">Kundenhinweis</div>
                <div style="font-size:12px;white-space:pre-line;">{{ order.notes }}</div>
            </div>
        {% endif %}

        <div style="padding:18px 28px;border-top:1px solid #e4e7ec;background:#fafafa;font-size:11px;color:#7b8494;">
            Antworten auf diese E-Mail gehen direkt an
            {% if customer and customer.email %}<strong>{{ customer.email }}</strong>{% else %}den Kunden{% endif %}.
        </div>
    </div>
</div>
