<h1>Neue Angebotsanfrage {{ quote.number }}</h1><p><strong>{{ quote.company }}</strong><br>{{ quote.contactName }} · {{ quote.email }} · {{ quote.phone }}<br>Channel: {{ quote.channelCode }} · Land: {{ quote.countryCode }}</p><ul>{% for item in quote.items %}<li>{{ item.quantity }} × {{ item.productName }} ({{ item.variantCode }})</li>{% endfor %}</ul><p>Ungefährer Warenwert: {{ quote.estimatedTotal|sylius_format_money(quote.currencyCode) }}<br>Beratung: {{ quote.needsAdvice?'Ja':'Nein' }}<br>Kompatibilitätsprüfung: {{ quote.needsCompatibilityCheck?'Ja':'Nein' }}</p><p>{{ quote.message }}</p><p><a href="{{ adminUrl }}">Anfrage im Backend öffnen →</a></p>
