<h1>{{ 'quote_mail.request_title'|trans }}</h1><p>{{ 'quote_mail.request_greeting'|trans({'%name%': quote.contactName}) }}</p><p>{{ 'quote_mail.request_reference'|trans({'%number%': quote.number}) }}</p><p>{{ 'quote_mail.request_body'|trans({'%count%': quote.items|length}) }}</p><ul>{% for item in quote.items %}<li>{{ item.quantity }} × {{ item.productName }}</li>{% endfor %}</ul><p>{{ 'quote_mail.regards'|trans({'%brand%': emailBranding ? emailBranding.brandName : 'Cardnext'}) }}</p>
