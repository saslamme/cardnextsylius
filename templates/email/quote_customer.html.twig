{% import 'shared/order/_configured_item_snapshot.html.twig' as configured %}
<h1>{{ 'quote_mail.request_title'|trans }}</h1><p>{{ 'quote_mail.request_greeting'|trans({'%name%': quote.contactName}) }}</p><p>{{ 'quote_mail.request_reference'|trans({'%number%': quote.number}) }}</p><p>{{ 'quote_mail.request_body'|trans({'%count%': quote.items|length}) }}</p><ul>{% for item in quote.items %}<li>{{ item.quantity }} × {{ item.productName }}{% if item.itemType.value == 'configured' %} — {{ 'cardnext.quote.configured_product'|trans }}{{ configured.render(item.configuredSnapshot.selectionsSnapshot, 'email') }}{% if item.configuredSnapshot.leadTimeName %}<div>{{ 'cardnext.quote.production_time'|trans }}: {{ item.configuredSnapshot.leadTimeName }}</div>{% endif %}{% endif %}</li>{% endfor %}</ul><p>{{ 'quote_mail.regards'|trans({'%brand%': emailBranding ? emailBranding.brandName : 'Cardnext'}) }}</p>
