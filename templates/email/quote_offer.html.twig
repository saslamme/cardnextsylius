<p>{{ 'quote_mail.greeting'|trans({'%name%':quote.customerContactName}) }}</p><p>{{ 'quote_mail.offer'|trans({'%number%':quote.number}) }}</p><p><strong>{{ 'quote_public.total'|trans }}:</strong> {{ (quote.grandTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}{% if quote.validUntil %}<br><strong>{{ 'quote_public.valid_until'|trans }}:</strong> {{ quote.validUntil|format_date(locale=quote.localeCode) }}{% endif %}</p><p><a href="{{ publicUrl }}">{{ 'quote_mail.view'|trans }}</a></p><p>{{ 'quote_mail.attachment'|trans }}</p><p>Cardnext</p>
