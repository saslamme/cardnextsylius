{% set billing = order.billingAddress %}
{% set shipping = order.shippingAddress %}
{% set shipment = order.shipments|first %}
{% set payment = order.payments|first %}
{% set customer = order.customer %}

<div style="margin:0;padding:24px;background:#f3f5f8;font-family:Arial,Helvetica,sans-serif;color:#182638;">
    <div style="max-width:720px;margin:0 auto;background:#fff;border:1px solid #dfe5ec;border-radius:10px;overflow:hidden;">

        <div style="padding:25px 28px;background:#182638;color:#fff;">
            <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#b9c7d8;">
                Neue Bestellung
            </div>
            <div style="margin-top:5px;font-size:23px;font-weight:800;">
                Bestellung #{{ order.number }}
            </div>
            <div style="margin-top:5px;font-size:13px;color:#d4dce5;">
                {% if customer %}{{ customer.email }}{% endif %}
            </div>
        </div>

        <div style="padding:22px 28px;background:#fafbfd;border-bottom:1px solid #e7ebf0;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td style="font-size:12px;color:#6d7b8d;">
                        Bestellwert
                        <div style="margin-top:3px;font-size:20px;font-weight:800;color:#182638;">
                            {{ order.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </div>
                    </td>
                    <td style="font-size:12px;color:#6d7b8d;text-align:right;">
                        Positionen
                        <div style="margin-top:3px;font-size:20px;font-weight:800;color:#182638;">
                            {{ order.items|length }}
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div style="padding:24px 28px;">
            <div style="margin-bottom:12px;font-size:14px;font-weight:800;">Artikel</div>

            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                {% for item in order.items %}
                    <tr>
                        <td style="padding:11px 10px 11px 0;border-top:1px solid #edf0f3;vertical-align:top;">
                            <div style="font-size:13px;font-weight:700;">{{ item.productName }}</div>
                            {% if item.variant and item.variant.code %}
                                <div style="margin-top:2px;font-size:11px;color:#788698;">
                                    Art.-Nr. {{ item.variant.code }}
                                </div>
                            {% endif %}
                        </td>
                        <td style="width:60px;padding:11px 8px;border-top:1px solid #edf0f3;text-align:center;vertical-align:top;font-size:12px;color:#68768a;">
                            {{ item.quantity }} ×
                        </td>
                        <td style="width:110px;padding:11px 0 11px 10px;border-top:1px solid #edf0f3;text-align:right;vertical-align:top;font-size:13px;font-weight:700;">
                            {{ item.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>

        <div style="padding:0 28px 24px;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td style="padding:7px 0;font-size:12px;color:#68768a;">Zwischensumme</td>
                    <td style="padding:7px 0;text-align:right;font-size:12px;">
                        {{ order.itemsTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:7px 0;font-size:12px;color:#68768a;">Versand</td>
                    <td style="padding:7px 0;text-align:right;font-size:12px;">
                        {{ order.shippingTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:7px 0;font-size:12px;color:#68768a;">Steuern</td>
                    <td style="padding:7px 0;text-align:right;font-size:12px;">
                        {{ order.taxTotal|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
                <tr>
                    <td style="padding:12px 0 0;border-top:1px solid #dfe5ec;font-size:14px;font-weight:800;">Gesamt</td>
                    <td style="padding:12px 0 0;border-top:1px solid #dfe5ec;text-align:right;font-size:16px;font-weight:800;">
                        {{ order.total|sylius_format_money(order.currencyCode, order.localeCode) }}
                    </td>
                </tr>
            </table>
        </div>

        <div style="padding:22px 28px;border-top:1px solid #e7ebf0;background:#fafbfd;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td width="50%" style="padding-right:14px;vertical-align:top;">
                        <div style="margin-bottom:7px;font-size:11px;font-weight:700;text-transform:uppercase;color:#788698;">Rechnungsadresse</div>
                        {% if billing %}
                            <div style="font-size:12px;line-height:1.55;">
                                {% if billing.company %}{{ billing.company }}<br>{% endif %}
                                {{ billing.firstName }} {{ billing.lastName }}<br>
                                {{ billing.street }}<br>
                                {{ billing.postcode }} {{ billing.city }}<br>
                                {{ billing.countryCode }}
                            </div>
                        {% endif %}
                    </td>

                    <td width="50%" style="padding-left:14px;vertical-align:top;">
                        <div style="margin-bottom:7px;font-size:11px;font-weight:700;text-transform:uppercase;color:#788698;">Lieferadresse</div>
                        {% if shipping %}
                            <div style="font-size:12px;line-height:1.55;">
                                {% if shipping.company %}{{ shipping.company }}<br>{% endif %}
                                {{ shipping.firstName }} {{ shipping.lastName }}<br>
                                {{ shipping.street }}<br>
                                {{ shipping.postcode }} {{ shipping.city }}<br>
                                {{ shipping.countryCode }}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>

        <div style="padding:18px 28px;border-top:1px solid #e7ebf0;">
            <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                    <td style="font-size:12px;color:#68768a;">
                        Versandart
                        <div style="margin-top:2px;font-weight:700;color:#182638;">
                            {{ shipment ? shipment.method.name : '—' }}
                        </div>
                    </td>
                    <td style="font-size:12px;color:#68768a;text-align:right;">
                        Zahlungsart
                        <div style="margin-top:2px;font-weight:700;color:#182638;">
                            {{ payment ? payment.method.name : '—' }}
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        {% if order.notes %}
            <div style="padding:18px 28px;border-top:1px solid #e7ebf0;">
                <div style="margin-bottom:5px;font-size:11px;font-weight:700;text-transform:uppercase;color:#788698;">Kundenhinweis</div>
                <div style="font-size:12px;white-space:pre-line;">{{ order.notes }}</div>
            </div>
        {% endif %}

        <div style="padding:18px 28px;border-top:1px solid #e7ebf0;background:#fafbfd;font-size:11px;color:#788698;">
            Antworten auf diese E-Mail gehen direkt an
            {% if customer and customer.email %}<strong>{{ customer.email }}</strong>{% else %}den Kunden{% endif %}.
        </div>
    </div>
</div>
