<!doctype html><html lang="{{ quote.localeCode|replace({'_':'-'}) }}"><head><meta charset="UTF-8"><style>
@page{margin:35mm 18mm 30mm}*{box-sizing:border-box}body{font-family:'DejaVu Sans',sans-serif;color:#202a35;font-size:9.5pt;line-height:1.45}header{border-bottom:2px solid #176f8f;padding-bottom:14px;margin-bottom:25px}.brand{font-size:21pt;font-weight:bold;color:#176f8f;letter-spacing:.5px}.doc{float:right;text-align:right}.doc h1{font-size:18pt;letter-spacing:2px;margin:0 0 8px}.meta{font-size:8.5pt}.issuer{font-size:7.5pt;color:#607080;margin-bottom:7px}.addresses{width:100%;margin-bottom:28px}.addresses td{width:50%;vertical-align:top}.addresses .recipient{font-size:10pt}.label{color:#607080;font-size:8pt;text-transform:uppercase;letter-spacing:.7px}.items{width:100%;border-collapse:collapse;margin:18px 0}.items thead{display:table-header-group}.items tr{page-break-inside:avoid}.items th{background:#edf3f5;color:#244653;text-align:left;font-size:8pt;padding:7px;border-bottom:1px solid #aac1ca}.items td{padding:9px 7px;border-bottom:1px solid #dce4e7;vertical-align:top}.num{text-align:right;white-space:nowrap}.article-meta{font-size:7.5pt;color:#71808a}.totals{width:48%;margin-left:52%;border-collapse:collapse}.totals td{padding:4px}.totals .rule td{border-top:1px solid #8798a0}.totals .grand td{border-top:2px solid #176f8f;font-size:12pt;font-weight:bold;padding-top:8px}.tax-note{margin-left:52%;padding:8px;background:#f4f6f7;font-size:8pt}.terms{margin-top:28px;page-break-inside:avoid}.term{margin-bottom:10px}.footer{position:fixed;bottom:-21mm;left:0;right:0;border-top:1px solid #ccd6da;padding-top:6px;color:#64747c;font-size:7pt}.footer table{width:100%}
</style></head><body><header><div class="doc"><h1>ANGEBOT</h1><div class="meta">Angebotsnummer: <strong>{{ quote.number }}</strong><br>Version: {{ quote.version }}<br>Angebotsdatum: {{ quote.quoteDate|format_date(locale=quote.localeCode) }}{% if quote.validUntil %}<br>Gültig bis: {{ quote.validUntil|format_date(locale=quote.localeCode) }}{% endif %}</div></div><div class="brand">CARDNEXT</div><div>{{ issuer.company }}</div><div style="clear:both"></div></header>
<table class="addresses"><tr><td class="recipient"><div class="issuer">{{ issuer.company }}{% if issuer.street %} · {{ issuer.street }}{% endif %}{% if issuer.city %} · {{ issuer.postalCode }} {{ issuer.city }}{% endif %}</div><strong>{{ quote.customerCompany }}</strong><br>{% if quote.customerContactName %}{{ quote.customerContactName }}<br>{% endif %}{% if quote.customerStreet %}{{ quote.customerStreet }} {{ quote.customerHouseNumber }}<br>{% endif %}{% if quote.customerCity %}{{ quote.customerPostalCode }} {{ quote.customerCity }}<br>{% endif %}{{ quote.customerCountryCode }}</td><td>{% if quote.customerNumber %}<span class="label">Kundennummer</span><br>{{ quote.customerNumber }}<br>{% endif %}{% if quote.projectReference %}<span class="label">Projekt</span><br>{{ quote.projectReference }}<br>{% endif %}{% if quote.customerPurchaseOrderNumber %}<span class="label">Bestellnummer</span><br>{{ quote.customerPurchaseOrderNumber }}{% endif %}</td></tr></table>
<p>Sehr geehrte Damen und Herren,</p><p>vielen Dank für Ihre Anfrage. Gerne bieten wir Ihnen die folgenden Positionen an:</p>
<table class="items"><thead><tr><th>Pos.</th><th>Artikel / Beschreibung</th><th class="num">Menge</th><th class="num">Einzelpreis netto</th><th class="num">Gesamt netto</th></tr></thead><tbody>{% for item in quote.items %}<tr><td>{{ item.position }}</td><td><strong>{{ item.name }}</strong>{% if item.productCode or item.variantCode %}<div class="article-meta">{% if item.productCode %}Artikel {{ item.productCode }}{% endif %}{% if item.variantCode %} · Variante {{ item.variantCode }}{% endif %}</div>{% endif %}{% if item.description %}<div>{{ item.description|nl2br }}</div>{% endif %}</td><td class="num">{{ item.quantity }}</td><td class="num">{{ (item.unitPrice / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td><td class="num">{{ (item.lineTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endfor %}</tbody></table>
<table class="totals"><tr><td>Zwischensumme Produkte netto</td><td class="num">{{ (quote.subtotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% if quote.shippingTotal %}<tr><td>Versand netto</td><td class="num">{{ (quote.shippingTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endif %}{% if quote.serviceTotal %}<tr><td>Service netto</td><td class="num">{{ (quote.serviceTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endif %}<tr class="rule"><td>Nettosumme</td><td class="num">{{ ((quote.subtotal + quote.shippingTotal + quote.serviceTotal) / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% for rate,tax in taxes %}<tr><td>MwSt. {{ (rate / 100)|format_number({fraction_digit:2}, locale=quote.localeCode) }} %</td><td class="num">{{ (tax / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endfor %}<tr class="grand"><td>Gesamtsumme brutto</td><td class="num">{{ (quote.grandTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr></table>{% if quote.taxNote %}<div class="tax-note">{{ quote.taxNote }}</div>{% endif %}
<div class="terms">{% if quote.deliveryTerms %}<div class="term"><span class="label">Lieferbedingungen</span><br>{{ quote.deliveryTerms|nl2br }}</div>{% endif %}{% if quote.paymentTerms %}<div class="term"><span class="label">Zahlungsbedingungen</span><br>{{ quote.paymentTerms|nl2br }}</div>{% endif %}{% if quote.validUntil %}<div class="term"><span class="label">Gültigkeit</span><br>Dieses Angebot ist gültig bis {{ quote.validUntil|format_date(locale=quote.localeCode) }}.</div>{% endif %}{% if quote.customerNote %}<div class="term"><span class="label">Kundenhinweis</span><br>{{ quote.customerNote|nl2br }}</div>{% endif %}</div>
<div class="footer"><table><tr><td>{{ issuer.company }}{% if issuer.street %} · {{ issuer.street }}{% endif %}{% if issuer.city %} · {{ issuer.postalCode }} {{ issuer.city }}{% endif %}<br>{% if issuer.email %}{{ issuer.email }} · {% endif %}{{ issuer.website }}</td><td>{% if issuer.vatId %}USt-IdNr. {{ issuer.vatId }}<br>{% endif %}{% if issuer.registrationNumber %}{{ issuer.registrationCourt }} · {{ issuer.registrationNumber }}{% endif %}</td><td>{% if issuer.managingDirector %}Geschäftsführung: {{ issuer.managingDirector }}{% endif %}{% if issuer.iban %}<br>{{ issuer.bankName }} · IBAN {{ issuer.iban }} · BIC {{ issuer.bic }}{% endif %}</td></tr></table></div></body></html>
