<!doctype html>
<html lang="{{ quote.localeCode|replace({'_':'-'}) }}">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 31mm 18mm 35mm; }
        * { box-sizing: border-box; }
        body { font-family: 'DejaVu Sans', sans-serif; color: #202a35; font-size: 9.5pt; line-height: 1.45; }
        header { border-bottom: 2px solid #176f8f; padding-bottom: 14px; margin-bottom: 24px; }
        .brand { font-size: 21pt; font-weight: bold; color: #176f8f; letter-spacing: .5px; }
        .doc { float: right; text-align: right; }
        .doc h1 { font-size: 18pt; letter-spacing: 2px; margin: 0 0 8px; }
        .meta { font-size: 8.5pt; }
        .sender-line { font-size: 7pt; color: #71808a; margin-bottom: 7px; text-decoration: underline; text-underline-offset: 2px; }
        .addresses { width: 100%; margin-bottom: 25px; }
        .addresses td { width: 55%; vertical-align: top; }
        .addresses td.references { width: 45%; padding-left: 25px; color: #44545d; font-size: 8.5pt; }
        .recipient { font-size: 10pt; }
        .label { color: #607080; font-size: 8pt; text-transform: uppercase; letter-spacing: .7px; }
        .reference { margin-bottom: 7px; }
        .items { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 18px 0; }
        .items thead { display: table-header-group; }
        .items tr { page-break-inside: avoid; }
        .items th { background: #edf3f5; color: #244653; text-align: left; font-size: 8pt; padding: 7px 5px; border-bottom: 1px solid #aac1ca; }
        .items td { padding: 8px 5px; border-bottom: 1px solid #dce4e7; vertical-align: top; overflow-wrap: anywhere; word-wrap: break-word; }
        .items .position { width: 7%; }
        .items .description { width: 43%; }
        .items .quantity { width: 10%; text-align: center; white-space: nowrap; }
        .items .price { width: 20%; text-align: right; white-space: nowrap; }
        .article-meta { margin-top: 2px; font-size: 7pt; line-height: 1.3; color: #71808a; overflow-wrap: anywhere; word-wrap: break-word; }
        .variant { white-space: nowrap; }
        .summary { page-break-inside: avoid; }
        .totals { width: 50%; margin-left: 50%; border-collapse: collapse; }
        .totals td { padding: 4px; }
        .num { text-align: right; white-space: nowrap; }
        .totals .rule td { border-top: 1px solid #8798a0; padding-top: 6px; }
        .totals .grand td { border-top: 2px solid #176f8f; font-size: 11.5pt; font-weight: bold; padding-top: 8px; }
        .tax-note { margin: 10px 0 0 50%; padding: 7px 8px; border-left: 2px solid #176f8f; background: #f4f6f7; font-size: 8pt; }
        .terms { margin-top: 24px; }
        .term { margin-bottom: 10px; page-break-inside: avoid; }
        .footer { position: fixed; bottom: -27mm; left: 0; right: 0; border-top: 1px solid #ccd6da; padding-top: 6px; color: #64747c; font-size: 6.8pt; line-height: 1.35; }
        .footer table { width: 88%; border-collapse: collapse; }
        .footer td { width: 50%; vertical-align: top; padding-right: 8px; }
        .footer .bank { padding-top: 3px; color: #75838a; }
    </style>
</head>
<body>
<header>
    <div class="doc">
        <h1>ANGEBOT</h1>
        <div class="meta">
            Angebotsnummer: <strong>{{ quote.number }}</strong><br>
            Version: {{ quote.version }}<br>
            Angebotsdatum: {{ quote.quoteDate|format_date(locale=quote.localeCode) }}
            {% if quote.validUntil %}<br>Gültig bis: {{ quote.validUntil|format_date(locale=quote.localeCode) }}{% endif %}
        </div>
    </div>
    <div class="brand">CARDNEXT</div>
    <div style="clear:both"></div>
</header>

<table class="addresses">
    <tr>
        <td class="recipient">
            {% set senderAddress = [] %}
            {% if issuer.company %}{% set senderAddress = senderAddress|merge([issuer.company]) %}{% endif %}
            {% if issuer.street %}{% set senderAddress = senderAddress|merge([issuer.street]) %}{% endif %}
            {% if issuer.postalCode or issuer.city %}{% set senderAddress = senderAddress|merge([(issuer.postalCode ~ ' ' ~ issuer.city)|trim]) %}{% endif %}
            {% if senderAddress %}<div class="sender-line">{{ senderAddress|join(' · ') }}</div>{% endif %}
            {% if quote.customerCompany %}<strong>{{ quote.customerCompany }}</strong><br>{% endif %}
            {% if quote.customerContactName %}{{ quote.customerContactName }}<br>{% endif %}
            {% if quote.customerStreet or quote.customerHouseNumber %}{{ quote.customerStreet }}{% if quote.customerStreet and quote.customerHouseNumber %} {% endif %}{{ quote.customerHouseNumber }}<br>{% endif %}
            {% if quote.customerPostalCode or quote.customerCity %}{{ quote.customerPostalCode }}{% if quote.customerPostalCode and quote.customerCity %} {% endif %}{{ quote.customerCity }}<br>{% endif %}
            {% if quote.customerCountryCode %}{{ quote.customerCountryCode }}{% endif %}
        </td>
        <td class="references">
            {% if quote.customerNumber %}<div class="reference"><span class="label">Kundennummer</span><br>{{ quote.customerNumber }}</div>{% endif %}
            {% if quote.projectReference %}<div class="reference"><span class="label">Projekt</span><br>{{ quote.projectReference }}</div>{% endif %}
            {% if quote.customerPurchaseOrderNumber %}<div class="reference"><span class="label">Bestellnummer Kunde</span><br>{{ quote.customerPurchaseOrderNumber }}</div>{% endif %}
        </td>
    </tr>
</table>

<p>Sehr geehrte Damen und Herren,</p>
<p>vielen Dank für Ihre Anfrage. Gerne bieten wir Ihnen die folgenden Positionen an:</p>

<table class="items">
    <thead><tr><th class="position">Pos.</th><th class="description">Artikel / Beschreibung</th><th class="quantity">Menge</th><th class="price">Einzelpreis netto</th><th class="price">Gesamt netto</th></tr></thead>
    <tbody>
    {% for item in quote.items %}
        <tr>
            <td class="position">{{ item.position }}</td>
            <td class="description">
                <strong>{{ item.name }}</strong>
                {% if item.productCode or item.variantCode %}<div class="article-meta">{% if item.productCode %}Art.-Nr. {{ item.productCode }}{% endif %}{% if item.productCode and item.variantCode %} · {% endif %}{% if item.variantCode %}<span class="variant">Variante&nbsp;{{ item.variantCode }}</span>{% endif %}</div>{% endif %}
                {% if item.description %}<div>{{ item.description|nl2br }}</div>{% endif %}
            </td>
            <td class="quantity">{{ item.quantity }}</td>
            <td class="price">{{ (item.unitPrice / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td>
            <td class="price">{{ (item.lineTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<div class="summary">
    <table class="totals">
        <tr><td>Zwischensumme Produkte netto</td><td class="num">{{ (quote.subtotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>
        {% if quote.shippingTotal != 0 %}<tr><td>Versand netto</td><td class="num">{{ (quote.shippingTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endif %}
        {% if quote.serviceTotal != 0 %}<tr><td>Service netto</td><td class="num">{{ (quote.serviceTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endif %}
        <tr class="rule"><td>Nettosumme</td><td class="num">{{ ((quote.subtotal + quote.shippingTotal + quote.serviceTotal) / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>
        {% for rate,tax in taxes %}<tr><td>MwSt. {{ (rate / 100)|format_number({fraction_digit:2}, locale=quote.localeCode) }} %</td><td class="num">{{ (tax / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>{% endfor %}
        <tr class="grand"><td>Gesamtsumme brutto</td><td class="num">{{ (quote.grandTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td></tr>
    </table>
    {% if hasZeroTax and quote.taxNote %}<div class="tax-note">{{ quote.taxNote|nl2br }}</div>{% endif %}
</div>

<div class="terms">
    {% if quote.paymentTerms %}<div class="term"><span class="label">Zahlungsbedingungen</span><br>{{ quote.paymentTerms|nl2br }}</div>{% endif %}
    {% if quote.deliveryTerms %}<div class="term"><span class="label">Lieferbedingungen</span><br>{{ quote.deliveryTerms|nl2br }}</div>{% endif %}
    {% if quote.validUntil %}<div class="term"><span class="label">Gültigkeit</span><br>Dieses Angebot ist gültig bis {{ quote.validUntil|format_date(locale=quote.localeCode) }}.</div>{% endif %}
    {% if quote.customerNote %}<div class="term"><span class="label">Hinweis</span><br>{{ quote.customerNote|nl2br }}</div>{% endif %}
</div>

<div class="footer">
    <table>
        <tr>
            <td>
                {% if issuer.company %}{{ issuer.company }}<br>{% endif %}
                {% if issuer.street or issuer.postalCode or issuer.city %}{{ issuer.street }}{% if issuer.street and (issuer.postalCode or issuer.city) %} · {% endif %}{{ issuer.postalCode }}{% if issuer.postalCode and issuer.city %} {% endif %}{{ issuer.city }}<br>{% endif %}
                {% set contacts = [] %}{% if issuer.phone %}{% set contacts = contacts|merge([issuer.phone]) %}{% endif %}{% if issuer.email %}{% set contacts = contacts|merge([issuer.email]) %}{% endif %}{% if issuer.website %}{% set contacts = contacts|merge([issuer.website]) %}{% endif %}{% if contacts %}{{ contacts|join(' · ') }}{% endif %}
            </td>
            <td>
                {% if issuer.vatId %}USt-IdNr. {{ issuer.vatId }}<br>{% endif %}
                {% if issuer.registrationCourt or issuer.registrationNumber %}Handelsregister: {{ issuer.registrationCourt }}{% if issuer.registrationCourt and issuer.registrationNumber %} · {% endif %}{{ issuer.registrationNumber }}<br>{% endif %}
                {% if issuer.managingDirector %}Geschäftsführung: {{ issuer.managingDirector }}{% endif %}
            </td>
        </tr>
        {% set bank = [] %}{% if issuer.bankName %}{% set bank = bank|merge([issuer.bankName]) %}{% endif %}{% if issuer.iban %}{% set bank = bank|merge(['IBAN ' ~ issuer.iban]) %}{% endif %}{% if issuer.bic %}{% set bank = bank|merge(['BIC ' ~ issuer.bic]) %}{% endif %}
        {% if bank %}<tr><td colspan="2" class="bank">{{ bank|join(' · ') }}</td></tr>{% endif %}
    </table>
</div>
</body>
</html>
