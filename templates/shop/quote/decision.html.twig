<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Cardnext</title><style>body{font:18px system-ui;background:#f4f7f8;color:#20303a}.card{max-width:650px;margin:10vh auto;background:white;padding:40px;border-radius:10px}h1{color:#176f8f}</style></head><body><main class="card"><h1>{{ 'quote_public.thanks'|trans }}</h1><p>{{ (accepted ? 'quote_public.accept_success':'quote_public.reject_success')|trans }}</p><p>{{ 'quote_public.title'|trans }}: {{ quote.number }}<br>{{ 'quote_public.version'|trans }}: {{ quote.version }}</p></main></body></html>
