<!doctype html>
<html lang="{{ quote.localeCode|replace({'_':'-'}) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'quote_public.title'|trans }} {{ quote.number }}</title>
    <style>
        :root{--navy:#05053f;--orange:#f04b23;--muted:#697386;--line:#e4e7ec;--paper:#fff;--canvas:#f5f6f8}
        *{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--navy);font:15px/1.55 Arial,Helvetica,sans-serif}.wrap{max-width:1120px;margin:auto;padding:34px 24px 56px}.header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:26px}.header img{display:block;max-width:190px;height:auto}.eyebrow{color:var(--orange);font-size:12px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}.card{overflow:hidden;background:var(--paper);border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 30px rgba(5,5,63,.05);margin:18px 0}.hero{padding:34px 38px;border-top:4px solid var(--orange)}h1{margin:5px 0 10px;font-size:34px;line-height:1.15}h2{margin:0 0 18px;font-size:20px}p{margin:8px 0}.meta,.customer,.terms,.actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.meta{margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}.label{display:block;margin-bottom:3px;color:var(--muted);font-size:11px;font-weight:800;letter-spacing:.7px;text-transform:uppercase}.customer,.terms{padding:25px 38px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse}th{padding:13px 16px;background:#f8f8fa;color:var(--muted);font-size:11px;letter-spacing:.6px;text-align:left;text-transform:uppercase}td{padding:17px 16px;border-top:1px solid #eef0f3;vertical-align:top}.num{text-align:right;white-space:nowrap}.description{color:var(--muted);font-size:13px}.summary{display:flex;justify-content:flex-end;padding:20px 16px 25px}.summary dl{width:340px;margin:0}.summary div{display:flex;justify-content:space-between;padding:6px 0}.summary .grand{margin-top:7px;padding-top:14px;border-top:2px solid var(--navy);font-size:19px;font-weight:800}.alert{margin:24px 0 0;padding:14px 16px;border-left:4px solid var(--orange);background:#fff5f1}.toolbar{display:flex;justify-content:flex-end}.btn{display:inline-block;border:0;border-radius:6px;padding:13px 20px;background:var(--orange);color:#fff;font-weight:700;text-decoration:none;cursor:pointer}.btn-secondary{background:var(--navy)}.actions{grid-template-columns:1fr 1fr;padding:30px 38px}.decision{padding:24px;border:1px solid var(--line);border-radius:8px}.decision p{color:var(--muted)}input,textarea{display:block;width:100%;padding:11px 12px;margin:5px 0 14px;border:1px solid #cfd4dc;border-radius:5px;font:inherit}textarea{min-height:88px;resize:vertical}.check{display:flex;align-items:flex-start;gap:9px;margin:5px 0 16px}.check input{width:auto;margin:5px 0}.footer{text-align:center;color:var(--muted);font-size:12px;margin-top:28px}
        @media(max-width:720px){.wrap{padding:22px 12px 40px}.header{align-items:flex-start;flex-direction:column}.hero,.customer,.terms,.actions{padding:24px 20px}.meta,.customer,.terms,.actions{grid-template-columns:1fr}h1{font-size:27px}.toolbar{justify-content:stretch}.toolbar .btn{width:100%;text-align:center}}
    </style>
</head>
<body>
<main class="wrap">
    <header class="header">
        <img src="{{ asset('cardnext/cardnext.svg') }}"
             alt="Cardnext"
             width="190">
        <span class="eyebrow">{{ 'quote_public.title'|trans }}</span>
    </header>

    <section class="card hero">
        <span class="eyebrow">{{ 'quote_public.title'|trans }}</span>
        <h1>{{ quote.number }}</h1>
        {% if quote.projectReference %}<p>{{ quote.projectReference }}</p>{% endif %}
        <div class="meta">
            <div><span class="label">{{ 'quote_public.version'|trans }}</span><strong>{{ quote.version }}</strong></div>
            <div><span class="label">{{ 'quote_public.date'|trans }}</span>{{ quote.quoteDate ? quote.quoteDate|format_date(locale=quote.localeCode) : '–' }}</div>
            <div><span class="label">{{ 'quote_public.valid_until'|trans }}</span>{{ quote.validUntil ? quote.validUntil|format_date(locale=quote.localeCode) : '–' }}</div>
        </div>
        {% if expired %}<p class="alert">{{ 'quote_public.expired'|trans }}</p>{% elseif quote.status.value == 'accepted' %}<p class="alert">{{ 'quote_public.already_accepted'|trans }} {{ quote.acceptedAt|format_datetime(locale=quote.localeCode) }}.</p>{% elseif quote.status.value == 'rejected' %}<p class="alert">{{ 'quote_public.already_rejected'|trans }}</p>{% elseif quote.status.value == 'superseded' %}<p class="alert">{{ 'quote_public.superseded'|trans }}</p>{% endif %}
    </section>

    <section class="card customer">
        <div><span class="label">{{ 'quote_public.company'|trans }}</span><strong>{{ quote.customerCompany }}</strong></div>
        <div><span class="label">{{ 'quote_public.contact'|trans }}</span>{{ quote.customerContactName }}</div>
        {% if quote.projectReference %}<div><span class="label">{{ 'quote_public.project'|trans }}</span>{{ quote.projectReference }}</div>{% endif %}
    </section>

    <section class="card">
        <div class="table-wrap"><table><thead><tr><th>#</th><th>{{ 'quote_public.item'|trans }}</th><th class="num">{{ 'quote_public.quantity'|trans }}</th><th class="num">{{ 'quote_public.unit_price'|trans }}</th><th class="num">{{ 'quote_public.net'|trans }}</th></tr></thead><tbody>
        {% for item in quote.items %}<tr><td>{{ item.position }}</td><td><strong>{{ item.name }}</strong>{% if item.description %}<div class="description">{{ item.description|nl2br }}</div>{% endif %}</td><td class="num">{{ item.quantity }}</td><td class="num">{{ (item.unitPrice/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</td><td class="num"><strong>{{ (item.lineTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</strong></td></tr>{% endfor %}
        </tbody></table></div>
        <div class="summary"><dl>
            <div><dt>{{ 'quote_public.shipping'|trans }}</dt><dd>{{ (quote.shippingTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd></div>
            <div><dt>{{ 'quote_public.service'|trans }}</dt><dd>{{ (quote.serviceTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd></div>
            <div><dt>{{ 'quote_public.tax'|trans }}</dt><dd>{{ (quote.taxTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd></div>
            <div class="grand"><dt>{{ 'quote_public.total'|trans }}</dt><dd>{{ (quote.grandTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd></div>
        </dl></div>
    </section>

    {% if quote.deliveryTerms or quote.paymentTerms or quote.customerNote %}<section class="card terms">{% if quote.deliveryTerms %}<div><span class="label">{{ 'quote_public.delivery'|trans }}</span><p>{{ quote.deliveryTerms|nl2br }}</p></div>{% endif %}{% if quote.paymentTerms %}<div><span class="label">{{ 'quote_public.payment'|trans }}</span><p>{{ quote.paymentTerms|nl2br }}</p></div>{% endif %}{% if quote.customerNote %}<div><span class="label">{{ 'quote_public.note'|trans }}</span><p>{{ quote.customerNote|nl2br }}</p></div>{% endif %}</section>{% endif %}

    <div class="toolbar"><a class="btn btn-secondary" href="{{ path('cardnext_shop_quote_public_pdf',{_locale:quote.localeCode,number:quote.number,version:quote.version,token:token}) }}">{{ 'quote_public.pdf'|trans }}</a></div>

    {% if quote.status.value == 'sent' and not expired %}<section class="card actions">
        <form class="decision" method="post" action="{{ path('cardnext_shop_quote_accept',{_locale:quote.localeCode,number:quote.number,version:quote.version,token:token}) }}"><h2>{{ 'quote_public.accept'|trans }}</h2><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_'~quote.id) }}"><label>{{ 'quote_public.name'|trans }}<input name="name" maxlength="255" required></label><label class="check"><input type="checkbox" name="binding" value="1" required><span>{{ 'quote_public.binding'|trans }}</span></label><button class="btn">{{ 'quote_public.accept'|trans }}</button></form>
        <form class="decision" method="post" action="{{ path('cardnext_shop_quote_reject',{_locale:quote.localeCode,number:quote.number,version:quote.version,token:token}) }}"><h2>{{ 'quote_public.reject'|trans }}</h2><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_'~quote.id) }}"><label>{{ 'quote_public.name'|trans }}<input name="name" maxlength="255" required></label><label>{{ 'quote_public.reason'|trans }}<textarea name="reason" maxlength="2000"></textarea></label><button class="btn btn-secondary">{{ 'quote_public.reject'|trans }}</button></form>
    </section>{% endif %}
    <footer class="footer">Cardnext</footer>
</main>
</body>
</html>
