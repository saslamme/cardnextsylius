<!doctype html><html lang="{{ quote.localeCode|replace({'_':'-'}) }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ 'quote_public.title'|trans }} {{ quote.number }}</title><style>body{margin:0;background:#f4f7f8;color:#202a35;font:16px/1.5 system-ui,sans-serif}.wrap{max-width:1050px;margin:auto;padding:24px}.brand{color:#176f8f;font-size:1.5rem;font-weight:800}.card{background:#fff;border-radius:10px;padding:24px;margin:18px 0;box-shadow:0 2px 10px #0001}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}table{width:100%;border-collapse:collapse}th,td{padding:12px;border-bottom:1px solid #dce4e7;text-align:left}.num{text-align:right}.total{font-size:1.2rem;font-weight:bold}.btn{display:inline-block;border:0;border-radius:5px;padding:11px 16px;margin:4px;background:#176f8f;color:#fff;text-decoration:none;cursor:pointer}.reject{background:#68747b}.alert{padding:14px;background:#fff1cc;border-left:4px solid #d89b00}input,textarea{display:block;box-sizing:border-box;width:100%;max-width:480px;padding:9px;margin:5px 0 12px}label.check input{display:inline;width:auto}@media(max-width:650px){.wrap{padding:12px}.table{overflow:auto}.card{padding:16px}}</style></head><body><main class="wrap"><div class="brand">CARDNEXT</div>
<section class="card"><h1>{{ 'quote_public.title'|trans }} {{ quote.number }}</h1><div class="grid"><div>{{ 'quote_public.version'|trans }}: <strong>{{ quote.version }}</strong></div><div>{{ 'quote_public.date'|trans }}: {{ quote.quoteDate ? quote.quoteDate|format_date(locale=quote.localeCode) : '–' }}</div><div>{{ 'quote_public.valid_until'|trans }}: {{ quote.validUntil ? quote.validUntil|format_date(locale=quote.localeCode) : '–' }}</div></div>{% if expired %}<p class="alert">{{ 'quote_public.expired'|trans }}</p>{% elseif quote.status.value == 'accepted' %}<p class="alert">{{ 'quote_public.already_accepted'|trans }} {{ quote.acceptedAt|format_datetime(locale=quote.localeCode) }}.</p>{% elseif quote.status.value == 'rejected' %}<p class="alert">{{ 'quote_public.already_rejected'|trans }}</p>{% elseif quote.status.value == 'superseded' %}<p class="alert">{{ 'quote_public.superseded'|trans }}</p>{% endif %}</section>
<section class="card grid"><div><small>{{ 'quote_public.company'|trans }}</small><br><strong>{{ quote.customerCompany }}</strong></div><div><small>{{ 'quote_public.contact'|trans }}</small><br>{{ quote.customerContactName }}</div>{% if quote.projectReference %}<div><small>{{ 'quote_public.project'|trans }}</small><br>{{ quote.projectReference }}</div>{% endif %}</section>
<section class="card table"><table><thead><tr><th>#</th><th>{{ 'quote_public.item'|trans }}</th><th class="num">{{ 'quote_public.quantity'|trans }}</th><th class="num">{{ 'quote_public.unit_price'|trans }}</th><th class="num">{{ 'quote_public.net'|trans }}</th></tr></thead><tbody>{% for item in quote.items %}<tr><td>{{ item.position }}</td><td><strong>{{ item.name }}</strong>{% if item.description %}<br>{{ item.description|nl2br }}{% endif %}</td><td class="num">{{ item.quantity }}</td><td class="num">{{ (item.unitPrice/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</td><td class="num">{{ (item.lineTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</td></tr>{% endfor %}</tbody></table><p class="num">{{ 'quote_public.shipping'|trans }}: {{ (quote.shippingTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}<br>{{ 'quote_public.service'|trans }}: {{ (quote.serviceTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}<br>{{ 'quote_public.tax'|trans }}: {{ (quote.taxTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}<br><span class="total">{{ 'quote_public.total'|trans }}: {{ (quote.grandTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</span></p></section>
<section class="card grid">{% if quote.deliveryTerms %}<div><strong>{{ 'quote_public.delivery'|trans }}</strong><p>{{ quote.deliveryTerms|nl2br }}</p></div>{% endif %}{% if quote.paymentTerms %}<div><strong>{{ 'quote_public.payment'|trans }}</strong><p>{{ quote.paymentTerms|nl2br }}</p></div>{% endif %}{% if quote.customerNote %}<div><strong>{{ 'quote_public.note'|trans }}</strong><p>{{ quote.customerNote|nl2br }}</p></div>{% endif %}</section>
<a class="btn" href="{{ path('cardnext_shop_quote_public_pdf',{_locale:quote.localeCode,number:quote.number,version:quote.version,token:token}) }}">{{ 'quote_public.pdf'|trans }}</a>
{% if quote.status.value == 'sent' and not expired %}<section class="card grid"><form method="post" action="{{ path('cardnext_shop_quote_accept',{_locale:quote.localeCode,number:quote.number,version:quote.version,token:token}) }}"><h2>{{ 'quote_public.accept'|trans }}</h2><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_'~quote.id) }}"><label>{{ 'quote_public.name'|trans }}<input name="name" maxlength="255" required></label><label class="check"><input type="checkbox" name="binding" value="1" required> {{ 'quote_public.binding'|trans }}</label><button class="btn">{{ 'quote_public.accept'|trans }}</button></form><form method="post" action="{{ path('cardnext_shop_quote_reject',{_locale:quote.localeCode,number:quote.number,version:quote.version,token:token}) }}"><h2>{{ 'quote_public.reject'|trans }}</h2><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_'~quote.id) }}"><label>{{ 'quote_public.name'|trans }}<input name="name" maxlength="255" required></label><label>{{ 'quote_public.reason'|trans }}<textarea name="reason" maxlength="2000"></textarea></label><button class="btn reject">{{ 'quote_public.reject'|trans }}</button></form></section>{% endif %}</main></body></html>
