{% set firstTaxon = taxons|first %}
{% set rootTaxon = firstTaxon ? firstTaxon.parent : null %}

{% if rootTaxon %}
    <form
        class="cn-mobile-search"
        method="get"
        action="{{ path('sylius_shop_product_index', {
            'slug': rootTaxon.slug,
            '_locale': rootTaxon.translation.locale
        }) }}"
        role="search"
    >
        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <circle cx="11" cy="11" r="6.5"/>
            <path d="m16 16 4.2 4.2"/>
        </svg>

        <input
            type="search"
            name="criteria[search][value]"
            placeholder="Produkte durchsuchen …"
            autocomplete="off"
            aria-label="Produkte durchsuchen"
        >

        <button type="submit" aria-label="Suchen">
            <svg aria-hidden="true" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.7">
                <path d="M3 8h9M9 4l4 4-4 4"/>
            </svg>
        </button>
    </form>
{% endif %}

<nav class="cn-mobile-nav" aria-label="Produktkategorien">
    {% for taxon in taxons %}
        {% set children = taxon.children %}

        {% if children|length %}
            <details class="cn-mobile-nav__group">
                <summary>
                    <span>{{ taxon.name }}</span>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="m4 6 4 4 4-4"/>
                    </svg>
                </summary>

                <div class="cn-mobile-nav__children">
                    <a
                        class="cn-mobile-nav__all"
                        href="{{ path('sylius_shop_product_index', {
                            'slug': taxon.slug,
                            '_locale': taxon.translation.locale
                        }) }}"
                    >
                        Alle {{ taxon.name }}
                    </a>

                    {% for child in children %}
                        <a href="{{ path('sylius_shop_product_index', {
                            'slug': child.slug,
                            '_locale': child.translation.locale
                        }) }}">
                            {{ child.name }}
                        </a>
                    {% endfor %}
                </div>
            </details>
        {% else %}
            <a
                class="cn-mobile-nav__single"
                href="{{ path('sylius_shop_product_index', {
                    'slug': taxon.slug,
                    '_locale': taxon.translation.locale
                }) }}"
            >
                <span>{{ taxon.name }}</span>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M3 8h9M9 4l4 4-4 4"/>
                </svg>
            </a>
        {% endif %}
    {% endfor %}
</nav>
