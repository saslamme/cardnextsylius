<header class="cn-header" data-cardnext-header>
    <div class="cn-container cn-header__inner">
        <a class="cn-logo" href="{{ path('sylius_shop_homepage') }}" aria-label="Cardnext Startseite">
            <img src="{{ asset('cardnext/cardnext.svg') }}" width="184" height="36" alt="Cardnext">
        </a>

        {{ component('sylius_shop:common:taxon_menu', { template: 'shop/layout/header/categories.html.twig' }) }}

        <div class="cn-header-actions">
            <button class="cn-icon-btn cn-desktop-only" type="button" data-cardnext-search-open aria-label="Produkte suchen" aria-expanded="false" aria-controls="cardnext-product-search">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.2 4.2"/></svg>
            </button>

            {% if is_granted('ROLE_USER') %}
                <a class="cn-icon-btn cn-desktop-only" href="{{ path('sylius_shop_account_dashboard') }}" aria-label="Mein Konto">
            {% else %}
                <a class="cn-icon-btn cn-desktop-only" href="{{ path('sylius_shop_login') }}" aria-label="Anmelden">
            {% endif %}
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/></svg>
            </a>

            {{ component('sylius_shop:cart:widget', { template: 'shop/layout/header/cart.html.twig' }) }}

            <button class="cn-menu-toggle" type="button" data-cardnext-menu-open aria-label="Navigation öffnen" aria-controls="cardnext-mobile-navigation">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<div class="cn-drawer-overlay" data-cardnext-mobile-overlay hidden>
    <aside class="cn-drawer" id="cardnext-mobile-navigation" aria-label="Mobile Navigation">
        <div class="cn-drawer__head">
            <a class="cn-logo" href="{{ path('sylius_shop_homepage') }}"><img src="{{ asset('cardnext/cardnext.svg') }}" width="170" height="33" alt="Cardnext"></a>
            <button type="button" class="cn-icon-btn cn-icon-btn--bordered" data-cardnext-menu-close aria-label="Navigation schließen">×</button>
        </div>
        <div class="cn-drawer__body">
            {{ component('sylius_shop:common:taxon_menu', { template: 'shop/layout/header/mobile_categories.html.twig' }) }}
            <div class="cn-drawer__actions">
                {% if is_granted('ROLE_USER') %}<a href="{{ path('sylius_shop_account_dashboard') }}"><span>Mein Konto</span><span>→</span></a>{% else %}<a href="{{ path('sylius_shop_login') }}"><span>Anmelden</span><span>→</span></a>{% endif %}
                <a href="{{ path('sylius_shop_cart_summary') }}"><span>Warenkorb</span><span>→</span></a>
                <a href="{{ path('sylius_shop_contact_request') }}"><span>Kontakt & Beratung</span><span>→</span></a>
            </div>
        </div>
    </aside>
</div>
