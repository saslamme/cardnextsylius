<header class="cardnext-header cn-shop-header" data-cardnext-header>
    <div class="cardnext-container cn-shop-header__inner">
        <div class="cn-shop-header__top">
            <a class="cn-shop-header__logo" href="{{ path('sylius_shop_homepage') }}" aria-label="Cardnext Startseite">
                <img src="{{ asset('cardnext/cardnext.svg') }}" width="184" height="36" alt="Cardnext">
            </a>

            <form
                class="cn-shop-header__search"
                method="get"
                action="{{ path('sylius_shop_product_index', {
                    'slug': 'produkte',
                    '_locale': app.request.locale
                }) }}"
                role="search"
            >
                <label class="visually-hidden" for="cn-header-search-input">Produkte suchen</label>

                <div class="cn-shop-header__search-box">
                    <input
                        id="cn-header-search-input"
                        class="cn-shop-header__search-input"
                        type="search"
                        name="criteria[search][value]"
                        placeholder="Produkte, Hersteller oder Artikelnummer suchen"
                        autocomplete="off"
                        aria-label="Produkte suchen"
                    >

                    <button
                        class="cn-shop-header__search-button"
                        type="submit"
                        aria-label="Suche starten"
                    >
                        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="6.5"/>
                            <path d="m16 16 4.2 4.2"/>
                        </svg>
                    </button>
                </div>
            </form>

            <div class="cn-shop-header__actions">
                {% if is_granted('ROLE_USER') %}
                    <a class="cn-shop-header__action" href="{{ path('sylius_shop_account_dashboard') }}" aria-label="Mein Konto">
                {% else %}
                    <a class="cn-shop-header__action" href="{{ path('sylius_shop_login') }}" aria-label="Anmelden">
                {% endif %}
                        <span class="cn-shop-header__action-icon">
                            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="3.4"/>
                                <path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/>
                            </svg>
                        </span>
                        <span class="cn-shop-header__action-label">Mein Konto</span>
                    </a>

                {{ component('sylius_shop:cart:widget', { template: 'shop/layout/header/cart.html.twig' }) }}

                <button class="cardnext-menu-toggle cn-shop-header__menu-toggle" type="button" data-cardnext-menu-open aria-label="Navigation öffnen" aria-controls="cardnext-mobile-navigation">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="cn-shop-header__nav">
            {{ component('sylius_shop:common:taxon_menu', {
                template: 'shop/layout/header/categories.html.twig'
            }) }}
        </div>
    </div>
</header>

<div class="cardnext-mobile-overlay" data-cardnext-mobile-overlay hidden>
    <aside class="cardnext-mobile-nav" id="cardnext-mobile-navigation" aria-label="Mobile Navigation">
        <div class="cardnext-mobile-nav__head">
            <a class="cardnext-logo" href="{{ path('sylius_shop_homepage') }}">
                <img src="{{ asset('cardnext/cardnext.svg') }}" width="170" height="33" alt="Cardnext">
            </a>
            <button type="button" class="cardnext-mobile-nav__close" data-cardnext-menu-close aria-label="Navigation schließen">×</button>
        </div>
        <div class="cardnext-mobile-nav__body">
            {{ component('sylius_shop:common:taxon_menu', {
                template: 'shop/layout/header/mobile_categories.html.twig'
            }) }}
            <div class="cardnext-mobile-nav__actions">
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('sylius_shop_account_dashboard') }}"><span>Mein Konto</span><span>→</span></a>
                {% else %}
                    <a href="{{ path('sylius_shop_login') }}"><span>Anmelden</span><span>→</span></a>
                {% endif %}
                <a href="{{ path('sylius_shop_cart_summary') }}"><span>Warenkorb</span><span>→</span></a>
                <a href="{{ path('sylius_shop_contact_request') }}"><span>Kontakt & Beratung</span><span>→</span></a>
            </div>
        </div>
    </aside>
</div>
