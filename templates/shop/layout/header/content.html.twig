{% set branding = cardnext_channel_branding() %}
<header class="cardnext-header cn-shop-header" data-cardnext-header data-cn-brand="{{ branding.themeKey }}">
    <div class="cardnext-container cn-shop-header__inner">
        <div class="cn-shop-header__top">
            <a class="cn-shop-header__logo" href="{{ path('sylius_shop_homepage') }}" aria-label="{{ 'cardnext.storefront.header.home'|trans({'%brand%': branding.brandName}) }}">
                <img src="{{ asset(branding.logoPath) }}" width="184" height="36" alt="{{ branding.brandName }}">
            </a>

            <form
                class="cn-shop-header__search"
                method="get"
                action="{{ path('cardnext_shop_search', {}) }}"
                role="search"
                data-cn-smart-search-form
                data-cn-suggest-url="{{ path('cardnext_shop_search_suggest', {}) }}"
            >
                <label class="visually-hidden" for="cn-header-search-input">{{ 'cardnext.storefront.header.search_label'|trans }}</label>

                <div class="cn-shop-header__search-box">
                    <input
                        id="cn-header-search-input"
                        class="cn-shop-header__search-input"
                        type="search"
                        name="q"
                        placeholder="{{ 'cardnext.storefront.header.search_placeholder'|trans }}"
                        autocomplete="off"
                        aria-label="{{ 'cardnext.storefront.header.search_label'|trans }}"
                        data-cn-smart-search-input
                    >

                    <button
                        class="cn-shop-header__search-button"
                        type="submit"
                        aria-label="{{ 'cardnext.storefront.header.search_submit'|trans }}"
                    >
                        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="6.5"/>
                            <path d="m16 16 4.2 4.2"/>
                        </svg>
                    </button>
                </div>

                <div class="cn-search-suggest" data-cn-search-suggest hidden aria-live="polite"></div>
            </form>

            <div class="cn-shop-header__actions">
                {% if is_granted('ROLE_USER') %}
                    <a class="cn-shop-header__action" href="{{ path('sylius_shop_account_dashboard') }}" aria-label="{{ 'cardnext.storefront.header.account'|trans }}">
                {% else %}
                    <a class="cn-shop-header__action" href="{{ path('sylius_shop_login') }}" aria-label="{{ 'cardnext.storefront.header.login'|trans }}">
                {% endif %}
                        <span class="cn-shop-header__action-icon">
                            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="3.4"/>
                                <path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/>
                            </svg>
                        </span>
                        <span class="cn-shop-header__action-label">{{ 'cardnext.storefront.header.account'|trans }}</span>
                    </a>

                <a class="cn-shop-header__action cn-quote-header" href="{{ path('cardnext_shop_quote_cart', {}) }}" aria-label="{{ 'cardnext.quote.cart'|trans }}">
                    <span class="cn-shop-header__action-icon">
                        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6.5 3.5h8l3 3V20.5h-11z"/>
                            <path d="M14.5 3.5v3h3M9 11h6M9 14.5h6"/>
                        </svg>
                    </span>
                    <span class="cn-shop-header__action-label">{{ 'cardnext.quote.header'|trans({'%count%': cardnext_quote_cart_count()}) }}</span>
                </a>

                {{ component('sylius_shop:cart:widget', { template: 'shop/layout/header/cart.html.twig' }) }}

                <button class="cardnext-menu-toggle cn-shop-header__menu-toggle" type="button" data-cardnext-menu-open aria-label="{{ 'cardnext.storefront.header.open_navigation'|trans }}" aria-controls="cardnext-mobile-navigation">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="cn-shop-header__nav">
            {{ component('sylius_shop:common:taxon_menu', {
                template: 'shop/layout/header/categories.html.twig'
            }) }}
        </div>
    </div>
</header>

<div class="cardnext-mobile-overlay" data-cardnext-mobile-overlay hidden>
    <aside class="cardnext-mobile-nav" id="cardnext-mobile-navigation" aria-label="{{ 'cardnext.storefront.header.mobile_navigation'|trans }}">
        <div class="cardnext-mobile-nav__head">
            <a class="cardnext-logo" href="{{ path('sylius_shop_homepage') }}">
                <img src="{{ asset(branding.logoPath) }}" width="170" height="33" alt="{{ branding.brandName }}">
            </a>
            <button type="button" class="cardnext-mobile-nav__close" data-cardnext-menu-close aria-label="{{ 'cardnext.storefront.header.close_navigation'|trans }}">×</button>
        </div>
        <div class="cardnext-mobile-nav__body">
            {% include 'shop/layout/header/_market_selector.html.twig' %}
            {{ component('sylius_shop:common:taxon_menu', {
                template: 'shop/layout/header/mobile_categories.html.twig'
            }) }}
            <div class="cardnext-mobile-nav__actions">
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('sylius_shop_account_dashboard') }}"><span>{{ 'cardnext.storefront.header.account'|trans }}</span><span>→</span></a>
                {% else %}
                    <a href="{{ path('sylius_shop_login') }}"><span>{{ 'cardnext.storefront.header.login'|trans }}</span><span>→</span></a>
                {% endif %}
                <a href="{{ path('cardnext_shop_quote_cart', {}) }}"><span>{{ 'cardnext.quote.header'|trans({'%count%': cardnext_quote_cart_count()}) }}</span><span>→</span></a>
                <a href="{{ path('sylius_shop_cart_summary') }}"><span>{{ 'cardnext.storefront.header.cart'|trans }}</span><span>→</span></a>
                <a href="{{ path('sylius_shop_contact_request') }}"><span>{{ 'cardnext.storefront.header.contact_advice'|trans }}</span><span>→</span></a>
            </div>
        </div>
    </aside>
</div>
