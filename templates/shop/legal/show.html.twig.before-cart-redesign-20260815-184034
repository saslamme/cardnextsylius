{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ page.metaTitle ?: page.title }}{% endblock %}

{% block metatags %}
    {{ parent() }}
    {% if page.metaDescription %}
        <meta name="description" content="{{ page.metaDescription }}">
    {% endif %}
{% endblock %}

{% block content %}
    <main class="cn-legal-page">
        <div class="cn-container cn-legal-page__inner">
            <header class="cn-legal-page__header">
                <span class="cn-kicker">Rechtliches</span>
                <h1 class="cn-title cn-title--page">{{ page.title }}</h1>
                <p class="cn-meta">Zuletzt aktualisiert: {{ page.updatedAt|date('d.m.Y') }}</p>
            </header>

            <article class="cn-legal-content">
                {{ page.content|raw }}
            </article>
        </div>
    </main>
{% endblock %}
