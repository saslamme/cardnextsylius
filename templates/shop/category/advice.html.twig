<section class="cn-section cn-section--soft"><div class="cn-container cn-split"><div class="cn-stack cn-stack--sm"><span class="cn-kicker">{{ 'cardnext.storefront.advice.kicker'|trans }}</span>{% if taxon.code|lower == 'card_printers' %}<h2 class="cn-title cn-title--section">{{ 'cardnext.storefront.advice.printer_title'|trans }}</h2>{% else %}<h2 class="cn-title cn-title--section">{{ 'cardnext.storefront.advice.generic_title'|trans({'%category%': taxon.name}) }}</h2>{% endif %}</div><div class="cn-prose">{% if taxon.code|lower == 'card_printers' %}<p>{{ 'cardnext.storefront.advice.printer_text'|trans }}</p><p>{{ 'cardnext.storefront.advice.printer_operation'|trans }}</p>{% else %}<p>{{ 'cardnext.storefront.advice.generic_text'|trans }}</p>{% endif %}<div class="cn-cluster"><a class="cn-link cn-link--arrow" href="{{ path('sylius_shop_contact_request', {'_locale': app.request.locale}) }}">{{ 'cardnext.storefront.advice.contact'|trans }}</a><a class="cn-link cn-link--arrow" href="{{ path('sylius_shop_homepage', {'_locale': app.request.locale}) }}#products">{{ 'cardnext.storefront.advice.more'|trans }}</a></div></div></div></section>
