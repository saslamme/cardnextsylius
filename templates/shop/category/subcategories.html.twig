{% if taxon.children|length > 0 %}
<nav class="cn-chipbar" aria-label="{{ 'cardnext.storefront.catalog.subcategories_aria'|trans({'%category%': taxon.name}) }}"><div class="cn-container cn-chip-list">
<a class="cn-chip is-active" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug}) }}">{{ 'cardnext.storefront.catalog.all_category'|trans({'%category%': taxon.name}) }}</a>
{% for child in taxon.children %}<a class="cn-chip" href="{{ path('sylius_shop_product_index', {'slug': child.slug}) }}">{{ child.name }}</a>{% endfor %}
</div></nav>
{% endif %}
