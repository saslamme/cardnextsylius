{% set navigation_parent = taxon.parent ?: taxon %}
{% set navigation_items = navigation_parent.children|length > 0 ? navigation_parent.children : taxon.children %}

{% if navigation_items|length > 0 %}
    <div class="cn-category__filter-group">
        <div class="cn-category__filter-label">Kategorien</div>
        <nav class="cn-category__taxonomy" aria-label="Produktkategorien">
            {% for item in navigation_items %}
                <a class="{{ item.code == taxon.code ? 'is-active' : '' }}" href="{{ path('sylius_shop_product_index', {'slug': item.slug}) }}">
                    <span>{{ item.name }}</span>
                    <span aria-hidden="true">→</span>
                </a>
            {% endfor %}
        </nav>
    </div>
{% endif %}
