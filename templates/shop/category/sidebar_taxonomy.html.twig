{% set navigation_parent = taxon.parent ?: taxon %}{% set navigation_items = navigation_parent.children|length > 0 ? navigation_parent.children : taxon.children %}{% if navigation_items|length > 0 %}<div class="cn-filter"><details class="cn-accordion" open><summary>{{ 'cardnext.storefront.catalog.categories'|trans }}</summary><div class="cn-accordion__panel"><div class="cn-stack cn-stack--sm">{% for item in navigation_items %}<a class="cn-link {{ item.code == taxon.code ? 'is-active' : '' }}" href="{{ path('sylius_shop_product_index', {'_locale': app.request.locale, 'slug': item.slug}) }}">{{ item.name }}</a>{% endfor %}</div></div></details></div>{% endif %}
