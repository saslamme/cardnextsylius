<article class="cn-product-card" {{ sylius_test_html_attribute('product', product.code) }}>
    <a class="cn-product-card__media" href="{{ cardnext_product_url(product) }}" tabindex="-1" aria-hidden="true">
        {% if product.images|length > 0 %}
            {{ component('sylius_shop:main_image', {
                product: product,
                class: 'cn-product-card__image',
                filter: 'cardnext_product_card'
            }) }}
        {% else %}
            <span class="cn-product-card__placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/>
                    <circle cx="9" cy="10" r="1.5"/>
                    <path d="m5.5 17 4.5-4 3 2.5 2.5-2 3 3.5"/>
                </svg>
                <span>{{ 'cardnext.storefront.product_card.image_pending'|trans }}</span>
            </span>
        {% endif %}
    </a>

    <div class="cn-product-card__body">
        <div class="cn-product-card__code">{{ product.code }}</div>

        <h2 class="cn-product-card__title">
            <a href="{{ cardnext_product_url(product) }}" {{ sylius_test_html_attribute('product-name', product.name) }}>
                {{ product.name }}
            </a>
        </h2>

        {% if variant %}
            <div class="cn-status {{ variant.tracked and variant.onHand <= 0 ? 'cn-status--warning' : '' }}">
                {{ (variant.tracked and variant.onHand <= 0 ? 'cardnext.storefront.product_card.on_request' : 'cardnext.storefront.product_card.available')|trans }}
            </div>
            <div class="cn-product-card__sku">{{ 'cardnext.storefront.product_card.sku'|trans }} {{ variant.code }}</div>
        {% endif %}

        <div class="cn-product-card__meta">
            <div class="cn-product-card__price">
                {% if channel_pricing and channel_pricing.price is not null %}
                    {% set from_price = cardnext_b2b_variant_from_price(variant) %}
                    {% if from_price.is_from_price %}
                        <span class="cn-product-card__from">{{ 'cardnext.storefront.product_card.from_price'|trans }}</span>
                        <span>{{ from_price.formatted_price }}</span>
                    {% else %}
                        {{ component('sylius_shop:product:card:price', {
                            variant: variant,
                            template: '@SyliusShop/product/common/price.html.twig'
                        }) }}
                    {% endif %}
                {% endif %}
            </div>

            <a class="cn-link cn-link--arrow cn-link--small" href="{{ cardnext_product_url(product) }}">
                {{ 'cardnext.storefront.product_card.details'|trans }}
            </a>
        </div>
        {% if show_quote_action and variant and channel_pricing and channel_pricing.price is not null %}
            <form class="cn-quote-add" method="post" action="{{ path('cardnext_shop_quote_cart_add', {}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('quote_add') }}">
                <input type="hidden" name="variantCode" value="{{ variant.code }}">
                <input type="hidden" name="quantity" value="1">
                <button class="cn-link cn-link--small" type="submit" aria-label="{{ 'cardnext.quote.add_product'|trans({'%product%': product.name}) }}">{{ 'cardnext.quote.add'|trans }}</button>
            </form>
        {% endif %}
        {% if show_compare_action %}
            <button class="cn-compare-toggle" type="button" data-compare-toggle data-product-code="{{ product.code }}" data-product-name="{{ product.name }}" data-product-group="{{ comparison_group }}" data-compare-url="{{ path('cardnext_shop_product_compare', {}) }}" aria-pressed="false" aria-label="{{ 'cardnext.storefront.product_card.compare_aria'|trans({'%product%': product.name}) }}">+ {{ 'cardnext.storefront.product_card.compare'|trans }}</button>
        {% endif %}
    </div>
</article>
