<article class="cn-product-card" {{ sylius_test_html_attribute('product', product.code) }}>
    <a class="cn-product-card__media" href="{{ cardnext_product_url(product) }}" tabindex="-1" aria-hidden="true">
        {% if product.images|length > 0 %}
            {{ component('sylius_shop:main_image', {
                product: product,
                class: 'cn-product-card__image',
                filter: 'cardnext_product_card'
            }) }}
        {% else %}
            <span class="cn-product-card__placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/>
                    <circle cx="9" cy="10" r="1.5"/>
                    <path d="m5.5 17 4.5-4 3 2.5 2.5-2 3 3.5"/>
                </svg>
                <span>Produktbild folgt</span>
            </span>
        {% endif %}
    </a>

    <div class="cn-product-card__body">
        <div class="cn-product-card__code">{{ product.code }}</div>

        <h2 class="cn-product-card__title">
            <a href="{{ cardnext_product_url(product) }}" {{ sylius_test_html_attribute('product-name', product.name) }}>
                {{ product.name }}
            </a>
        </h2>

        {% if variant %}
            <div class="cn-status {{ variant.tracked and variant.onHand <= 0 ? 'cn-status--warning' : '' }}">
                {% if variant.tracked and variant.onHand <= 0 %}Auf Anfrage{% else %}Lieferbar{% endif %}
            </div>
            <div class="cn-product-card__sku">Art.-Nr. {{ variant.code }}</div>
        {% endif %}

        <div class="cn-product-card__meta">
            <div class="cn-product-card__price">
                {% if channel_pricing and channel_pricing.price is not null %}
                    {{ component('sylius_shop:product:card:price', {
                        variant: variant,
                        template: '@SyliusShop/product/common/price.html.twig'
                    }) }}
                {% endif %}
            </div>

            <a class="cn-link cn-link--arrow cn-link--small" href="{{ cardnext_product_url(product) }}">
                {{ 'Details' }}
            </a>
        </div>
        {% if variant and channel_pricing and channel_pricing.price is not null %}
            <form class="cn-quote-add" method="post" action="{{ path('cardnext_shop_quote_cart_add', {_locale: app.request.locale}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('quote_add') }}">
                <input type="hidden" name="variantCode" value="{{ variant.code }}">
                <input type="hidden" name="quantity" value="1">
                <button class="cn-link cn-link--small" type="submit" aria-label="{{ 'cardnext.quote.add_product'|trans({'%product%': product.name}) }}">{{ 'cardnext.quote.add'|trans }}</button>
            </form>
        {% endif %}
        <button class="cn-compare-toggle" type="button" data-compare-toggle data-product-code="{{ product.code }}" data-product-name="{{ product.name }}" data-product-group="{{ comparison_group }}" data-compare-url="{{ path('cardnext_shop_product_compare', {_locale: app.request.locale}) }}" aria-pressed="false" aria-label="{{ product.name }} zum Vergleich hinzufügen">+ Vergleichen</button>
    </div>
</article>
