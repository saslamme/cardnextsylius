<article class="cn-category-card" {{ sylius_test_html_attribute('product', product.code) }}>
    <a class="cn-category-card__media" href="{{ path('sylius_shop_product_show', {'slug': product.slug}) }}" tabindex="-1" aria-hidden="true">
        {{ component('sylius_shop:main_image', {
            product: product,
            class: 'cn-category-card__image'
        }) }}
    </a>

    <div class="cn-category-card__body">
        <div class="cn-category-card__code">{{ product.code }}</div>
        <h2>
            <a href="{{ path('sylius_shop_product_show', {'slug': product.slug}) }}" {{ sylius_test_html_attribute('product-name', product.name) }}>
                {{ product.name }}
            </a>
        </h2>


        {% if variant %}
            <div class="cn-category-card__stock {{ variant.tracked and variant.onHand <= 0 ? 'is-request' : '' }}">
                {% if variant.tracked and variant.onHand <= 0 %}
                    Auf Anfrage
                {% else %}
                    Lieferbar
                {% endif %}
            </div>

            <div class="cn-category-card__sku">Art.-Nr. {{ variant.code }}</div>
        {% endif %}

        <div class="cn-category-card__meta">
            <div class="cn-category-card__price">
                {% if variant %}
                    {{ component('sylius_shop:product:card:price', {
                        variant: variant,
                        template: '@SyliusShop/product/common/price.html.twig'
                    }) }}
                {% endif %}
            </div>

            <a class="cn-category-card__details" href="{{ path('sylius_shop_product_show', {'slug': product.slug}) }}">
                Details <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</article>
