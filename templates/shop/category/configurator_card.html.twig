{% set translation = configurator.getTranslation(app.request.locale) %}
{% if translation %}<article class="cn-product-card cn-configurator-card"><a href="{{ path('cardnext_shop_configurator_page', {_locale: translation.locale, configuratorPath: translation.path}) }}">{% if configurator.images|length %}<img src="{{ asset((configurator.images|first).path) }}" alt="{{ (configurator.images|first).altText ?: translation.name }}">{% endif %}<h3>{{ translation.name }}</h3><span>Konfigurieren</span></a></article>{% endif %}
