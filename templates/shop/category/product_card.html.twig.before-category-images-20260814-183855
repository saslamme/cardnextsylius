<article class="cn-product-card" {{ sylius_test_html_attribute('product', product.code) }}>
    <a class="cn-product-card__media" href="{{ path('sylius_shop_product_show', {'slug': product.slug}) }}" tabindex="-1" aria-hidden="true">
        {{ component('sylius_shop:main_image', {product: product, class: 'cn-product-card__image'}) }}
    </a>
    <div class="cn-product-card__body">
        <div class="cn-product-card__code">{{ product.code }}</div>
        <h2 class="cn-product-card__title"><a href="{{ path('sylius_shop_product_show', {'slug': product.slug}) }}" {{ sylius_test_html_attribute('product-name', product.name) }}>{{ product.name }}</a></h2>
        {% if variant %}
            <div class="cn-status {{ variant.tracked and variant.onHand <= 0 ? 'cn-status--warning' : '' }}">{% if variant.tracked and variant.onHand <= 0 %}Auf Anfrage{% else %}Lieferbar{% endif %}</div>
            <div class="cn-product-card__sku">Art.-Nr. {{ variant.code }}</div>
        {% endif %}
        <div class="cn-product-card__meta">
            <div class="cn-product-card__price">{% if variant %}{{ component('sylius_shop:product:card:price', {variant: variant, template: '@SyliusShop/product/common/price.html.twig'}) }}{% endif %}</div>
            <a class="cn-link cn-link--arrow cn-link--small" href="{{ path('sylius_shop_product_show', {'slug': product.slug}) }}">Details</a>
        </div>
    </div>
</article>
