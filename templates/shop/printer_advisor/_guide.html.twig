{% set guide = 'cardnext.storefront.printer_advisor.guide.' %}
<section class="cn-advisor-guide" aria-labelledby="kartendrucker-guide-title">
    <div class="cn-container">
        <header class="cn-advisor-guide__intro">
            <p class="cn-advisor-guide__eyebrow">{{ (guide ~ 'eyebrow')|trans }}</p>
            <h2 id="kartendrucker-guide-title">{{ (guide ~ 'title')|trans }}</h2>
            <p class="cn-advisor-guide__lead">{{ (guide ~ 'lead')|trans }}</p>
            <p>{{ (guide ~ 'intro')|trans }}</p>
            <a class="cn-btn cn-btn--secondary" href="#kartendrucker-berater">{{ (guide ~ 'advisor_cta')|trans }}</a>
        </header>
        <div class="cn-advisor-guide__chapters">
            {% set chapters = {
                volume: {number: '01', icon: '▥', paragraphs: 2, list: ['small', 'medium', 'high']},
                sides: {number: '02', icon: '⇄', paragraphs: 2},
                encoding: {number: '03', icon: '⌁', paragraphs: 2, list: ['magnetic', 'contact_chip', 'rfid_nfc']},
                quality: {number: '04', icon: '◇', paragraphs: 2},
                budget: {number: '05', icon: '€', paragraphs: 2},
                advice: {number: '06', icon: '✓', paragraphs: 2}
            } %}
            {% for chapter, config in chapters %}
                <article class="cn-advisor-guide__chapter">
                    <div class="cn-advisor-guide__media" aria-hidden="true"><span class="cn-advisor-guide__number">{{ config.number }}</span><span class="cn-advisor-guide__icon">{{ config.icon }}</span><span class="cn-advisor-guide__media-label">{{ (guide ~ 'chapters.' ~ chapter ~ '.media')|trans }}</span></div>
                    <div class="cn-advisor-guide__copy">
                        <h3>{{ (guide ~ 'chapters.' ~ chapter ~ '.title')|trans }}</h3>
                        {% for paragraph in 1..config.paragraphs %}<p>{{ (guide ~ 'chapters.' ~ chapter ~ '.p' ~ paragraph)|trans }}</p>{% endfor %}
                        {% if config.list is defined %}<ul>{% for item in config.list %}<li>{{ (guide ~ 'chapters.' ~ chapter ~ '.list.' ~ item)|trans }}</li>{% endfor %}</ul>{% endif %}
                        {% if chapter != 'advice' %}<p class="cn-advisor-guide__advisor-note">{{ (guide ~ 'chapters.' ~ chapter ~ '.note')|trans }}</p>{% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
        <aside class="cn-advisor-guide__cta" aria-labelledby="advisor-guide-cta-title">
            <div><p class="cn-advisor-guide__eyebrow">{{ (guide ~ 'closing.eyebrow')|trans }}</p><h2 id="advisor-guide-cta-title">{{ (guide ~ 'closing.title')|trans }}</h2><p>{{ (guide ~ 'closing.text')|trans }}</p></div>
            {% set contactEmail = sylius.channel.contactEmail|default('info@cardnext.de', true) %}
            <div class="cn-advisor-guide__cta-actions"><a class="cn-btn cn-btn--primary" href="#kartendrucker-berater">{{ (guide ~ 'closing.start')|trans }}</a><a class="cn-btn cn-btn--secondary" href="mailto:{{ contactEmail }}?subject={{ 'cardnext.storefront.printer_advisor.contact.subject'|trans|url_encode }}">{{ 'cardnext.storefront.printer_advisor.contact.cta'|trans }}</a></div>
        </aside>
    </div>
</section>
