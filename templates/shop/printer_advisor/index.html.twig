{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% set contactEmail = sylius.channel.contactEmail|default('info@cardnext.de', true) %}
{% set advisor = 'cardnext.storefront.printer_advisor.' %}

{% block content %}
<main class="cn-page cn-advisor" id="main-content" data-printer-advisor
      data-step-count="{{ (advisor ~ 'progress')|trans({'%current%': '%current%', '%total%': '%total%'}) }}"
      data-summary-empty="{{ (advisor ~ 'summary.empty')|trans }}"
      data-summary-hint="{{ (advisor ~ 'summary.hint')|trans }}"
      data-loading="{{ (advisor ~ 'loading')|trans }}"
      data-request-failed="{{ (advisor ~ 'errors.request_failed')|trans }}">
    <section class="cn-advisor__hero cn-container" id="kartendrucker-berater">
        <p class="cn-advisor__eyebrow">{{ (advisor ~ 'hero.eyebrow')|trans }}</p>
        <h1>{{ (advisor ~ 'hero.title')|trans }}</h1>
        <p>{{ (advisor ~ 'hero.intro')|trans }}</p>
        <button class="cn-btn cn-btn--primary" type="button" data-advisor-start>{{ (advisor ~ 'hero.start')|trans }}</button>
        <small>{{ (advisor ~ 'hero.duration')|trans }}</small>
    </section>

    <section class="cn-container cn-advisor__workspace" data-advisor-workspace hidden>
        <div class="cn-advisor__wizard">
            <div class="cn-advisor__progress"><div data-advisor-progress></div></div>
            <p class="cn-advisor__step-count" data-advisor-count>{{ (advisor ~ 'progress')|trans({'%current%': 1, '%total%': 5}) }}</p>
            {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
            <form method="post" action="{{ path('cardnext_shop_printer_advisor', {}) }}" data-advisor-form>
                <input type="hidden" name="_token" value="{{ csrf_token('printer_advisor') }}">
                {% set steps = {
                    volume: ['under_500', '500_2000', '2000_10000', 'over_10000'],
                    sides: ['single', 'duplex', 'unsure'],
                    encoding: ['none', 'magnetic', 'contact_chip', 'rfid_nfc'],
                    requirement: ['standard', 'durability', 'lamination', 'retransfer', 'speed'],
                    budget: ['under_1000', '1000_2000', '2000_4000', 'secondary']
                } %}
                {% for name, options in steps %}
                    <fieldset class="cn-advisor__step" data-advisor-step="{{ loop.index0 }}">
                        <legend>{{ (advisor ~ 'questions.' ~ name ~ '.title')|trans }}</legend>
                        <div class="cn-advisor__choices">
                        {% for value in options %}
                            <label><input type="radio" name="advisor[{{ name }}]" value="{{ value }}" required{% if answers and attribute(answers, name) == value %} checked{% endif %}><span>{{ (advisor ~ 'questions.' ~ name ~ '.options.' ~ value)|trans }}</span></label>
                        {% endfor %}
                        </div>
                    </fieldset>
                {% endfor %}
                <div class="cn-advisor__actions">
                    <button class="cn-btn cn-btn--secondary" type="button" data-advisor-back>{{ (advisor ~ 'navigation.back')|trans }}</button>
                    <button class="cn-btn cn-btn--primary" type="button" data-advisor-next>{{ (advisor ~ 'navigation.next')|trans }}</button>
                    <button class="cn-btn cn-btn--primary" type="submit" data-advisor-submit>{{ (advisor ~ 'navigation.submit')|trans }}</button>
                </div>
            </form>
        </div>
        <aside class="cn-panel cn-advisor__summary" aria-live="polite"><h2>{{ (advisor ~ 'summary.title')|trans }}</h2><dl data-advisor-summary><div><dt>{{ (advisor ~ 'summary.empty')|trans }}</dt><dd>{{ (advisor ~ 'summary.hint')|trans }}</dd></div></dl></aside>
    </section>

    <section class="cn-container cn-advisor__results" data-advisor-results aria-live="polite">
    {% if recommendations is not null %}
        <h2>{{ (advisor ~ 'results.title')|trans }}</h2>
        {% if recommendations|length %}
            <div class="cn-advisor__result-grid">
            {% for recommendation in recommendations %}
                <article class="cn-panel cn-advisor__result">
                    <strong class="cn-advisor__badge">{{ (advisor ~ 'labels.' ~ recommendation.label)|trans }}</strong>
                    <div class="cn-advisor__media">
                        {% if recommendation.product.images|length %}
                            {% set thumbnailImages = recommendation.product.imagesByType('thumbnail') %}
                            {% set recommendationImage = thumbnailImages is not empty ? thumbnailImages.first : recommendation.product.images.first %}
                            <img
                                class="cn-advisor__product-image"
                                src="{{ recommendationImage.path|imagine_filter('cardnext_product_card') }}"
                                alt="{{ recommendation.product.name }}"
                            >
                        {% else %}
                            <span class="cn-advisor__image-placeholder">{{ 'cardnext.storefront.product_card.image_pending'|trans }}</span>
                        {% endif %}
                    </div>
                    {% if recommendation.product.manufacturer %}<p class="cn-advisor__manufacturer">{{ recommendation.product.manufacturer.name }}</p>{% endif %}
                    <h3>{{ recommendation.product.name }}</h3>
                    {% if recommendation.product.model %}<p>{{ recommendation.product.model }}</p>{% endif %}
                    <p class="cn-advisor__price">{{ (recommendation.price / 100)|format_currency(channel.baseCurrency.code) }}</p>
                    {% set translatedReasons = [] %}{% for reason in recommendation.reasons %}{% set translatedReasons = translatedReasons|merge([(advisor ~ 'reasons.' ~ reason)|trans]) %}{% endfor %}
                    <p>{{ (advisor ~ 'results.explanation')|trans({'%reasons%': translatedReasons|join(', ')}) }}</p>
                    <ul>{% for reason in recommendation.reasons %}<li>{{ (advisor ~ 'reasons.' ~ reason)|trans|capitalize }}</li>{% endfor %}</ul>
                    <a class="cn-btn cn-btn--primary" href="{{ recommendation.url }}" data-advisor-event="advisor_product_clicked">{{ (advisor ~ 'results.product_cta')|trans }}</a>
                </article>
            {% endfor %}
            </div>
        {% else %}
            <div class="cn-panel cn-advisor__empty"><h3>{{ (advisor ~ 'results.empty_title')|trans }}</h3><p>{{ (advisor ~ 'results.empty_text')|trans }}</p><a class="cn-btn cn-btn--primary" href="mailto:{{ contactEmail }}?subject={{ (advisor ~ 'contact.subject')|trans|url_encode }}" data-advisor-event="advisor_contact_clicked">{{ (advisor ~ 'contact.cta')|trans }}</a></div>
        {% endif %}
    {% endif %}
    </section>

    {% include 'shop/printer_advisor/_guide.html.twig' %}
</main>
{% endblock %}
