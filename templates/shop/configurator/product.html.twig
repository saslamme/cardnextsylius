{% if configurator %}
    <section class="cn-configurator" data-configurator data-dependencies="{{ computed.dependencies|json_encode|e('html_attr') }}" data-endpoint="{{ path('cardnext_shop_configurator_calculate', {configuratorCode: configurator.code}) }}" data-cart-endpoint="{{ path('cardnext_shop_configurator_cart_add', {configuratorCode: configurator.code}) }}" data-cart-token="{{ csrf_token('configured_cart_add_' ~ configurator.code) }}" aria-labelledby="configurator-title-{{ configurator.code }}">
        <div class="cn-configurator__intro">
            <h2 id="configurator-title-{{ configurator.code }}">{{ 'cardnext.configurator.form.title'|trans }}</h2>
            <p>{{ 'cardnext.configurator.form.intro'|trans }}</p>
        </div>
        <div class="cn-configurator__layout">
            <form class="cn-configurator__form" data-configurator-form novalidate>
                <section class="cn-configurator__section">
                    <div class="cn-configurator__section-head"><h3>{{ 'cardnext.configurator.section.basic'|trans }}</h3></div>
                    <div class="cn-configurator__fields">
                        <div class="cn-configurator__field cn-configurator__field--quantity">
                            <label class="cn-configurator__label" for="configurator-quantity-{{ configurator.code }}">{{ 'cardnext.configurator.quantity'|trans }} <span aria-hidden="true">*</span></label>
                            <div class="cn-configurator__control-wrap">
                                <input class="cn-configurator__control" id="configurator-quantity-{{ configurator.code }}" name="quantity" type="number" inputmode="numeric" min="1" step="1" value="1" required data-configurator-quantity aria-describedby="configurator-quantity-error-{{ configurator.code }}">
                                <div class="cn-configurator__error" id="configurator-quantity-error-{{ configurator.code }}" data-field-error="quantity"></div>
                            </div>
                        </div>
                    </div>
                </section>

                {% for section in configurator.sections %}
                    {% if section.enabled %}
                        <fieldset class="cn-configurator__section">
                            <div class="cn-configurator__section-head">
                                <legend>{{ configurator_text(section, 'name') }}</legend>
                                {% if configurator_text(section, 'description') %}<p>{{ configurator_text(section, 'description') }}</p>{% endif %}
                            </div>
                            <div class="cn-configurator__fields">
                            {% for field in section.fields %}
                                {% if field.enabled %}
                                    {% set activeValues = field.values|filter(value => value.enabled) %}
                                    {% set visualValues = activeValues|filter(value => value.imagePath or value.colorHex or value.icon) %}
                                    {% set segmented = field.type.value == 'single_choice' and activeValues|length == 2 and visualValues|length == 0 %}
                                    {% set selectChoice = field.type.value == 'single_choice' and not segmented and visualValues|length == 0 %}
                                    <div class="cn-configurator__field" data-configurator-field="{{ field.code }}" data-field-type="{{ field.type.value }}">
                                        {% if field.type.value in ['single_choice', 'multiple_choice'] and not selectChoice %}
                                            <div class="cn-configurator__label" id="configurator-label-{{ configurator.code }}-{{ field.code }}">{{ configurator_text(field, 'name') }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}{% if configurator_text(field, 'description') %}<span class="cn-configurator__hint">{{ configurator_text(field, 'description') }}</span>{% endif %}</div>
                                        {% else %}
                                            <label class="cn-configurator__label" for="configurator-{{ configurator.code }}-{{ field.code }}">{{ configurator_text(field, 'name') }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}{% if configurator_text(field, 'description') %}<span class="cn-configurator__hint">{{ configurator_text(field, 'description') }}</span>{% endif %}</label>
                                        {% endif %}
                                        <div class="cn-configurator__control-wrap">
                                            {% if selectChoice %}
                                                <select class="cn-configurator__control" id="configurator-{{ configurator.code }}-{{ field.code }}" name="selection[{{ field.code }}]"{% if field.required %} required{% endif %}>
                                                    <option value="">{{ 'cardnext.configurator.choose'|trans }}</option>
                                                    {% for value in activeValues %}<option value="{{ value.code }}" data-configurator-value="{{ value.code }}"{% if value.preselected %} selected{% endif %}>{{ configurator_text(value, 'name') }}</option>{% endfor %}
                                                </select>
                                            {% elseif field.type.value in ['single_choice', 'multiple_choice'] %}
                                                <div class="{{ segmented ? 'cn-configurator__segmented' : 'cn-configurator__choices' }}"{% if field.type.value == 'single_choice' %} role="radiogroup" aria-labelledby="configurator-label-{{ configurator.code }}-{{ field.code }}"{% endif %}>
                                                    {% for value in activeValues %}
                                                        <label class="cn-configurator__choice" data-configurator-value="{{ value.code }}" for="configurator-{{ configurator.code }}-{{ field.code }}-{{ value.code }}">
                                                            <input id="configurator-{{ configurator.code }}-{{ field.code }}-{{ value.code }}" name="selection[{{ field.code }}]{{ field.type.value == 'multiple_choice' ? '[]' : '' }}" value="{{ value.code }}" type="{{ field.type.value == 'single_choice' ? 'radio' : 'checkbox' }}"{% if value.preselected %} checked{% endif %}{% if field.required and field.type.value == 'single_choice' %} required{% endif %}>
                                                            {% if value.imagePath %}<img src="{{ asset(value.imagePath) }}" alt="" loading="lazy">{% endif %}
                                                            <span class="cn-configurator__choice-copy"><strong>{% if value.colorHex %}<i class="cn-configurator__swatch" style="--choice-color: {{ value.colorHex }}"></i>{% endif %}{% if value.icon %}<span class="cn-configurator__icon" aria-hidden="true">{{ value.icon }}</span>{% endif %}{{ configurator_text(value, 'name') }}</strong>{% if configurator_text(value, 'description') %}<small>{{ configurator_text(value, 'description') }}</small>{% endif %}</span>
                                                        </label>
                                                    {% endfor %}
                                                </div>
                                            {% elseif field.type.value == 'boolean' %}
                                                <label class="cn-configurator__switch"><input id="configurator-{{ configurator.code }}-{{ field.code }}" name="selection[{{ field.code }}]" type="checkbox" role="switch"><span>{{ 'cardnext.configurator.yes'|trans }}</span></label>
                                            {% elseif field.type.value in ['integer', 'quantity', 'decimal'] %}
                                                {% set fixedNumericValue = field.minimumValue is not null and field.maximumValue is not null and field.minimumValue == field.maximumValue %}
                                                <input class="cn-configurator__control" id="configurator-{{ configurator.code }}-{{ field.code }}" name="selection[{{ field.code }}]" type="number"{% if field.minimumValue is not null %} min="{{ field.minimumValue }}"{% endif %}{% if field.maximumValue is not null %} max="{{ field.maximumValue }}"{% endif %} step="{{ field.step ?? (field.type.value == 'decimal' ? 'any' : '1') }}"{% if fixedNumericValue %} value="{{ field.minimumValue }}" readonly{% endif %}{% if field.required %} required{% endif %}>
                                            {% elseif field.type.value == 'text' %}
                                                <input class="cn-configurator__control" id="configurator-{{ configurator.code }}-{{ field.code }}" name="selection[{{ field.code }}]" type="text"{% if field.required %} required{% endif %}>
                                            {% elseif field.type.value == 'upload' %}
                                                <div class="cn-configurator__upload">{{ 'cardnext.configurator.upload_later'|trans }}</div>
                                            {% endif %}
                                            {% if configurator_text(field, 'helpText') %}<div class="cn-configurator__help">{{ configurator_text(field, 'helpText') }}</div>{% endif %}
                                            <div class="cn-configurator__error" data-field-error="{{ field.code }}"></div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                            </div>
                        </fieldset>
                    {% endif %}
                {% endfor %}

                {% set activeLeadTimes = configurator.leadTimes|filter(leadTime => leadTime.enabled) %}
                {% if activeLeadTimes|length %}
                    <fieldset class="cn-configurator__section" data-configurator-lead-times>
                        <div class="cn-configurator__section-head"><legend>{{ 'cardnext.configurator.production_time'|trans }}</legend></div>
                        <div class="cn-configurator__lead-times">
                            {% for leadTime in activeLeadTimes %}
                                <div class="cn-configurator__lead-time"><input id="configurator-{{ configurator.code }}-lead-time-{{ leadTime.code }}" name="leadTimeCode" value="{{ leadTime.code }}" type="radio"{% if leadTime.preselected %} checked{% endif %} required><label for="configurator-{{ configurator.code }}-lead-time-{{ leadTime.code }}"><i aria-hidden="true"></i><span><strong>{{ configurator_text(leadTime, 'name') }}</strong>{% if configurator_text(leadTime, 'description') %}<small>{{ configurator_text(leadTime, 'description') }}</small>{% endif %}</span><b>{{ leadTime.workingDays }} {{ 'cardnext.configurator.working_days'|trans }}</b></label></div>
                            {% endfor %}
                        </div>
                        <div class="cn-configurator__error" data-field-error="leadTime"></div>
                    </fieldset>
                {% endif %}
                <div class="cn-configurator__general-error d-none" role="alert" data-configurator-errors></div>
            </form>

            <aside class="cn-configurator__price" aria-live="polite" aria-busy="false">
                <div class="cn-configurator__summary-top"><div class="cn-configurator__summary-title"><h3 data-configurator-price-title>{{ 'cardnext.configurator.summary'|trans }}</h3><span data-configurator-state>{{ 'cardnext.configurator.incomplete'|trans }}</span></div><div class="cn-configurator__selection" data-configurator-selection></div></div>
                <div class="cn-configurator__summary-body">
                    <span class="cn-configurator__price-label">{{ 'cardnext.configurator.total'|trans }}</span>
                    <p class="cn-configurator__placeholder" data-configurator-placeholder>{{ 'cardnext.configurator.placeholder'|trans }}</p>
                    <div class="d-none" data-configurator-result>
                        <div class="cn-configurator__total"><strong data-configurator-total></strong><small><span data-configurator-unit></span><br>{{ 'cardnext.configurator.per_piece'|trans }}</small></div>
                        <p class="cn-configurator__shipping">{{ 'cardnext.configurator.shipping_note'|trans }}</p>
                        <div class="cn-configurator__delivery d-none" data-configurator-lead-time-result><span>✓</span><p><strong></strong><small></small></p></div>
                        <button class="cn-configurator__add" type="button" data-configurator-add disabled>{{ 'cardnext.configurator.add_to_cart'|trans }}</button>
                        <details class="cn-configurator__details"><summary>{{ 'cardnext.configurator.price_details'|trans }}</summary><div data-configurator-breakdown></div></details>
                        <div class="cn-configurator__assurance"><span>✓ {{ 'cardnext.configurator.assurance.calculation'|trans }}</span><span>✓ {{ 'cardnext.configurator.assurance.checkout'|trans }}</span></div>
                    </div>
                </div>
            </aside>
        </div>
        <div class="cn-configurator__buybar"><div><strong data-configurator-mobile-total>–</strong><small data-configurator-mobile-unit>{{ 'cardnext.configurator.awaiting_price'|trans }}</small></div><button type="button" data-configurator-mobile-add disabled>{{ 'cardnext.configurator.add_to_cart'|trans }}</button></div>
    </section>
{% endif %}
