{% extends '@SyliusShop/shared/layout/base.html.twig' %}{% block title %}{{ 'cardnext.leasing.inquiry_title'|trans }}{% endblock %}
{% block content %}<div class="container py-5"><div class="row justify-content-center"><div class="col-12 col-lg-9"><h1>{{ 'cardnext.leasing.inquiry_title'|trans }}</h1><div class="card mb-4"><div class="card-body"><h2 class="h4">{{ product.name }}</h2><p>{{ offer.variant.code }} · {{ offer.netPrice|sylius_format_money(offer.currencyCode) }} {{ 'cardnext.leasing.net'|trans }}</p></div></div>
<form method="post" class="card"><input type="hidden" name="_token" value="{{ csrf_token('leasing-'~product.code) }}"><div class="card-body"><div class="row g-3">
{% for field,required in {company:true,firstName:true,lastName:true,email:true,phone:false,street:false,houseNumber:false,postalCode:true,city:true,countryCode:false} %}<div class="col-12 col-md-6"><label class="form-label" for="leasing_{{ field }}">{{ ('cardnext.leasing.field.'~field)|trans }}{% if required %} *{% endif %}</label><input class="form-control" id="leasing_{{ field }}" name="{{ field }}" {% if required %}required{% endif %} {% if field=='email' %}type="email"{% endif %}></div>{% endfor %}
<div class="col-12"><label class="form-label" for="duration">{{ 'cardnext.leasing.duration'|trans }}</label><select class="form-select" name="duration" id="duration">{% for item in offer.rates %}<option value="{{ item.factor.durationMonths }}">{{ 'cardnext.leasing.duration_rate'|trans({'%months%':item.factor.durationMonths,'%rate%':item.rate|sylius_format_money(offer.currencyCode)}) }}</option>{% endfor %}</select></div>
<div class="col-12"><label class="form-label" for="message">{{ 'cardnext.leasing.field.message'|trans }}</label><textarea class="form-control" name="message" id="message"></textarea></div><div class="col-12"><label><input type="checkbox" name="consent" required> {{ 'cardnext.leasing.consent'|trans }}</label></div></div></div><div class="card-footer"><button class="btn btn-primary">{{ offer.configuration.ctaText }}</button></div></form></div></div></div>{% endblock %}
