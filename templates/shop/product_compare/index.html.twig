{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% set branding = cardnext_channel_branding() %}

{% block title %}Produktvergleich | {{ branding.brandName }}{% endblock %}
{% block metatags %}{{ parent() }}<meta name="robots" content="noindex,follow">{% endblock %}

{% block content %}
<main class="cn-compare-page" data-compare-page data-valid-codes="{{ codes|join(',') }}">
    <nav class="cn-breadcrumbs" aria-label="Breadcrumb"><div class="cn-container cn-breadcrumbs__inner"><a href="{{ path('sylius_shop_homepage', {}) }}">{{ 'cardnext.storefront.common.home'|trans }}</a><span class="cn-breadcrumbs__sep" aria-hidden="true">/</span><span aria-current="page">Produktvergleich</span></div></nav>
    <div class="cn-container">
        <header class="cn-compare-header"><span class="cn-kicker">Produktvergleich</span><h1 class="cn-title cn-title--section">Produkte direkt vergleichen</h1><p>Technische Merkmale, Ausstattung und Preise übersichtlich gegenübergestellt.</p></header>
        {% if requestedCount > 3 %}<div class="cn-compare-notice" role="status">Sie können maximal 3 Produkte vergleichen.</div>{% endif %}
        {% if not comparison.compatible %}<div class="cn-compare-notice cn-compare-notice--error" role="alert">Diese Produkte gehören zu unterschiedlichen Produktbereichen und können nicht sinnvoll miteinander verglichen werden.</div>
        {% elseif comparison.products|length < 2 %}
            {% set cardPrintersTaxon = cardnext_taxon_by_code('card_printers') %}<section class="cn-compare-empty"><h2>Produkte vergleichen</h2><p>{% if comparison.products|length == 1 %}Wählen Sie noch ein zweites Produkt aus.{% else %}Wählen Sie mindestens zwei Produkte aus einer Kategorie aus, um technische Merkmale direkt gegenüberzustellen.{% endif %}</p><a class="cn-btn cn-btn--primary cn-btn--small" href="{{ path('sylius_shop_product_index', {slug: cardPrintersTaxon.slug}) }}">Zu den Kartendruckern</a></section>
        {% else %}
            <label class="cn-compare-differences"><input type="checkbox" data-compare-differences> Nur Unterschiede anzeigen</label>
            <div class="cn-compare-scroll" tabindex="0">
            <table class="cn-compare-table">
                <thead><tr><th scope="col">Eigenschaft</th>{% for column in comparison.products %}{% set comparison_image = column.product.images|first %}<th scope="col"><div class="cn-compare-product">{% if comparison_image %}<img src="{{ comparison_image.path|imagine_filter('cardnext_product_card') }}" alt="{{ column.product.name }}">{% else %}<span class="cn-compare-product__placeholder">{{ 'cardnext.storefront.product_card.image_pending'|trans }}</span>{% endif %}<span class="cn-compare-product__maker">{{ column.manufacturer ?: 'Hersteller nicht angegeben' }}</span><strong>{{ column.product.name }}</strong><span class="cn-compare-product__price">{% if column.pricing %}{{ column.pricing.price|sylius_format_money(channel.baseCurrency.code, app.request.locale) }}{% else %}Preis auf Anfrage{% endif %}</span><span class="cn-status {{ column.variant.tracked and column.variant.onHand <= 0 ? 'cn-status--warning' : '' }}">{{ (column.variant.tracked and column.variant.onHand <= 0 ? 'cardnext.storefront.product_card.on_request' : 'cardnext.storefront.product_card.available')|trans }}</span><a class="cn-link cn-link--arrow cn-link--small" href="{{ cardnext_product_url(column.product) }}">{{ 'cardnext.storefront.product_card.details'|trans }}</a><button type="button" class="cn-compare-remove" data-compare-remove="{{ column.product.code }}">Produkt entfernen</button></div></th>{% endfor %}</tr></thead>
                <tbody>{% for section in comparison.sections %}<tr class="cn-compare-section"><th scope="rowgroup" colspan="{{ comparison.products|length + 1 }}">{{ section.title }}</th></tr>{% for row in section.rows %}<tr data-compare-row data-different="{{ row.different ? 'true' : 'false' }}"><th scope="row">{{ row.label }}</th>{% for cell in row.cells %}<td class="{{ row.different ? 'is-different' : '' }}">{{ cell.display }}</td>{% endfor %}</tr>{% endfor %}{% endfor %}</tbody>
            </table></div>
        {% endif %}
    </div>
</main>
{% endblock %}
