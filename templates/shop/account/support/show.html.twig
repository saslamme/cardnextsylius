{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% block content %}
{% embed 'shop/account/_layout.html.twig' with { breadcrumbs: [{ label: 'cardnext.support.title'|trans, url: path('cardnext_shop_account_support_index') }, { label: '#' ~ ticket.id }] } %}
{% block account_content %}
<section class="cn-account-panel cn-support cn-support-detail">
    <header class="cn-support__header">
        <div class="cn-support__header-copy"><span class="cn-support__kicker">{{ 'cardnext.support.kicker'|trans }}</span><h1>{{ 'cardnext.support.case_title'|trans({'%id%': ticket.id}) }}</h1><p class="cn-support-detail__subject">{{ ticket.subject }}</p></div>
        <span class="cn-account-status cn-support-detail__status">{{ status_key|trans }}</span>
    </header>
    <section class="cn-support-detail__section" aria-labelledby="support-details-title">
        <h2 id="support-details-title" class="cn-support__section-title">{{ 'cardnext.support.details'|trans }}</h2>
        <dl class="cn-support-detail__grid">
            <div><dt>{{ 'cardnext.support.list.type'|trans }}</dt><dd>{{ ('cardnext.support.type.' ~ case.serviceType.value)|trans }}</dd></div>
            <div><dt>{{ 'cardnext.support.list.order'|trans }}</dt><dd>{% if case.order %}<a href="{{ path('sylius_shop_account_order_show', {number: case.order.number}) }}">{{ case.order.number }}</a>{% else %}–{% endif %}</dd></div>
            <div><dt>{{ 'cardnext.support.form.product'|trans }}</dt><dd>{{ case.product ? (case.product.name ?? case.product.code) : '–' }}</dd></div>
            <div><dt>{{ 'cardnext.support.form.maintenance_contract'|trans }}</dt><dd>{{ case.maintenanceContract ? ((case.maintenanceContract.printerModel ?? 'Gerät') ~ ' – ' ~ (case.maintenanceContract.contractReference ?? case.maintenanceContract.erpContractId)) : '–' }}</dd></div>
            <div><dt>{{ 'cardnext.support.list.serial'|trans }}</dt><dd>{{ case.serialNumber ?? '–' }}</dd></div>
            <div><dt>{{ 'cardnext.support.list.created'|trans }}</dt><dd>{{ case.createdAt|format_datetime }}</dd></div>
        </dl>
    </section>
    <section class="cn-support-detail__section" aria-labelledby="support-history-title">
        <h2 id="support-history-title" class="cn-support__section-title">{{ 'cardnext.support.history'|trans }}</h2>
        <div class="cn-support-timeline">
            <article class="cn-support-message cn-support-message--customer"><header><strong>{{ 'cardnext.support.you'|trans }}</strong><time>{{ ticket.createdAt|format_datetime }}</time></header><div class="cn-support-message__body">{{ ticket.descriptionText }}</div></article>
            {% for conversation in conversations %}<article class="cn-support-message {{ conversation.incoming ? 'cn-support-message--customer' : 'cn-support-message--support' }}"><header><strong>{{ (conversation.incoming ? 'cardnext.support.you' : 'cardnext.support.team')|trans }}</strong><time>{{ conversation.createdAt|format_datetime }}</time></header><div class="cn-support-message__body">{{ conversation.bodyText }}</div></article>{% endfor %}
        </div>
    </section>
</section>
{% endblock %}
{% endembed %}
{% endblock %}
