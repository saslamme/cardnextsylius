{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
{% embed 'shop/account/_layout.html.twig' with { breadcrumbs: [{ label: 'cardnext.support.title'|trans, url: path('cardnext_shop_account_support_index') }, { label: 'cardnext.support.new'|trans }] } %}
{% block account_content %}
<section class="cn-account-panel cn-support">
    <header class="cn-support__header">
        <div class="cn-support__header-copy">
            <span class="cn-support__kicker">{{ 'cardnext.support.kicker'|trans }}</span>
            <h1>{{ 'cardnext.support.new'|trans }}</h1>
            <p>{{ 'cardnext.support.new_intro'|trans }}</p>
        </div>
    </header>

    {% if form.vars.submitted and not form.vars.valid %}
        <div class="cn-account-flash cn-account-flash--danger" role="alert">
            <span class="cn-account-flash__icon" aria-hidden="true">!</span>
            <span>{{ 'cardnext.support.validation.summary'|trans }}</span>
        </div>
    {% endif %}
    {% if service_unavailable %}
        <div class="cn-account-flash cn-account-flash--danger" role="alert">
            <span class="cn-account-flash__icon" aria-hidden="true">!</span>
            <span>{{ 'cardnext.support.error.unavailable'|trans }}</span>
        </div>
    {% endif %}

    {{ form_start(form, {attr: {class: 'cn-support__form'}}) }}
        {{ form_errors(form) }}
        <fieldset class="cn-support__section">
            <legend class="cn-support__section-title">{{ 'cardnext.support.section.request'|trans }}</legend>
            <div class="cn-support__grid">
                {% include 'shop/account/support/_field.html.twig' with {
                    field: form.type
                } only %}
                {% include 'shop/account/support/_field.html.twig' with {
                    field: form.order
                } only %}
            </div>
        </fieldset>
        <fieldset class="cn-support__section">
            <legend class="cn-support__section-title">{{ 'cardnext.support.section.device'|trans }}</legend>
            <div class="cn-support__grid">
                {% include 'shop/account/support/_field.html.twig' with {
                    field: form.maintenanceContract
                } only %}
                {% include 'shop/account/support/_field.html.twig' with {
                    field: form.serialNumber
                } only %}
                <div class="cn-support__grid-full">
                    {% include 'shop/account/support/_field.html.twig' with {
                        field: form.product
                    } only %}
                </div>
            </div>
        </fieldset>
        <fieldset class="cn-support__section">
            <legend class="cn-support__section-title">{{ 'cardnext.support.section.message'|trans }}</legend>
            {% include 'shop/account/support/_field.html.twig' with {
                field: form.subject
            } only %}
            {% include 'shop/account/support/_field.html.twig' with {
                field: form.description
            } only %}
        </fieldset>
        <div class="cn-support__actions">
            <button class="btn btn-primary" type="submit">{{ 'cardnext.support.form.submit'|trans }}</button>
            <a class="btn btn-outline-primary" href="{{ path('cardnext_shop_account_support_index') }}">{{ 'cardnext.support.form.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
{% endembed %}
{% endblock %}
