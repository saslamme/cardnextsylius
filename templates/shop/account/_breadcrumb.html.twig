{# Account pages extend the shared storefront breadcrumb with their dashboard root. #}
{% set account_items = items|default([]) is empty
    ? [{label: 'sylius.ui.my_account'|trans}]
    : [{label: 'sylius.ui.my_account'|trans, url: path('sylius_shop_account_dashboard')}]|merge(items)
%}
{% include 'shop/_breadcrumb.html.twig' with {items: account_items} only %}
