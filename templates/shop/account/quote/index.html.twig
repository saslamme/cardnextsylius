{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
    {% embed 'shop/account/_layout.html.twig' with { title: 'Angebote', breadcrumbs: [{ label: 'Angebote' }] } %}
        {% block page_intro %}<p class="cn-lead">Ihre persönlichen Angebote übersichtlich an einem Ort.</p>{% endblock %}
        {% block account_content %}
                    <section class="cn-account-panel">
                        <div class="cn-account-table-wrap">
                            <table class="cn-account-table">
                                <thead><tr><th>Angebotsnummer</th><th>Datum</th><th>Status</th><th>Gültig bis</th><th class="cn-account-table__money">Gesamtsumme</th><th><span class="visually-hidden">Aktion</span></th></tr></thead>
                                <tbody>
                                {% for quote in quotes %}
                                    <tr>
                                        <td><strong>{{ quote.number }}</strong><small>Version {{ quote.version }}</small></td>
                                        <td>{{ quote.quoteDate ? quote.quoteDate|format_date(locale=quote.localeCode) : '–' }}</td>
                                        <td><span class="cn-account-status cn-account-status--{{ quote.status.value }}">{{ ('cardnext.quote.status.' ~ quote.status.value)|trans }}</span></td>
                                        <td>{{ quote.validUntil ? quote.validUntil|format_date(locale=quote.localeCode) : '–' }}</td>
                                        <td class="cn-account-table__money"><strong>{{ (quote.grandTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</strong></td>
                                        <td class="cn-account-table__action"><a class="btn btn-primary btn-sm" href="{{ path('cardnext_shop_account_quote_show', {number: quote.number, version: quote.version}) }}">Ansehen</a></td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6"><div class="cn-account-empty"><h2>Keine Angebote</h2><p>Aktuell sind keine Angebote verfügbar.</p></div></td></tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
