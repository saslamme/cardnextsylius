{% extends '@SyliusShop/shared/layout/base.html.twig' %}{% block content %}<section class="cn-account"><div class="cn-container cn-container--narrow"><div class="cn-account__layout"><aside class="cn-account__sidebar"><div class="cn-account-nav">{{ knp_menu_render('sylius_shop.account', {'template':'@SyliusShop/account/menu/content.html.twig'}) }}</div></aside><main class="cn-account__main"><header class="cn-account__header"><span class="cn-kicker">Cardnext Angebot</span><h1>{{ quote.number }} <small>Version {{ quote.version }}</small></h1><p>{{ ('cardnext.quote.status.'~quote.status.value)|trans }}</p></header><section class="cn-account-panel"><div class="cn-account-panel__body"><p><strong>Angebotsdatum:</strong> {{ quote.quoteDate ? quote.quoteDate|format_date(locale=quote.localeCode) : '–' }} · <strong>Gültig bis:</strong> {{ quote.validUntil ? quote.validUntil|format_date(locale=quote.localeCode) : '–' }}</p><h2>Kundendaten</h2><p><strong>{{ quote.customerCompany }}</strong><br>{{ quote.customerContactName }}<br>{{ quote.customerStreet }} {{ quote.customerHouseNumber }}<br>{{ quote.customerPostalCode }} {{ quote.customerCity }}</p></div><div class="table-responsive"><table class="table"><thead><tr><th>Pos.</th><th>Artikel</th><th>Menge</th><th>Einzelpreis</th><th>Rabatt</th><th>Netto</th></tr></thead><tbody>{% for item in quote.items %}<tr><td>{{ item.position }}</td><td><strong>{{ item.name }}</strong><br><small>{{ item.description }}</small></td><td>{{ item.quantity }}</td><td>{{ (item.unitPrice/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</td><td>{{ item.discountPercent is null ? '–' : (item.discountPercent/100)|format_number(locale=quote.localeCode)~' %' }}</td><td>{{ (item.lineTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</td></tr>{% endfor %}</tbody></table></div><div class="cn-account-panel__body"><dl><dt>Versand</dt><dd>{{ (quote.shippingTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd><dt>Service</dt><dd>{{ (quote.serviceTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd><dt>MwSt.</dt><dd>{{ (quote.taxTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</dd><dt>Bruttosumme</dt><dd><strong>{{ (quote.grandTotal/100)|format_currency(quote.currencyCode,locale=quote.localeCode) }}</strong></dd></dl>{% if quote.deliveryTerms %}<h3>Lieferbedingungen</h3><p>{{ quote.deliveryTerms|nl2br }}</p>{% endif %}{% if quote.paymentTerms %}<h3>Zahlungsbedingungen</h3><p>{{ quote.paymentTerms|nl2br }}</p>{% endif %}{% if quote.customerNote %}<h3>Kundenhinweis</h3><p>{{ quote.customerNote|nl2br }}</p>{% endif %}<a class="btn btn-outline-primary" href="{{ path('cardnext_shop_account_quote_pdf',{number:quote.number,version:quote.version}) }}">PDF herunterladen</a>{% if quote.status.value == 'sent' and not expired %}<div class="row mt-4"><form class="col" method="post" action="{{ path('cardnext_shop_account_quote_accept',{number:quote.number,version:quote.version}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_'~quote.id) }}"><label><input type="checkbox" name="binding" value="1" required> Ich nehme dieses Angebot verbindlich an.</label><br><button class="btn btn-primary mt-2">Annehmen</button></form><form class="col" method="post" action="{{ path('cardnext_shop_account_quote_reject',{number:quote.number,version:quote.version}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_'~quote.id) }}"><label>Ablehnungsgrund (optional)<textarea class="form-control" name="reason" maxlength="2000"></textarea></label><button class="btn btn-outline-primary mt-2">Ablehnen</button></form></div>{% endif %}</div></section></main></div></div></section>{% endblock %}
