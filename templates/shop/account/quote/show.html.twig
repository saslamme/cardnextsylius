{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
    {% embed 'shop/account/_layout.html.twig' with {
        title: 'Angebot ' ~ quote.number,
        breadcrumbs: [{ label: 'Angebote', path: path('cardnext_shop_account_quote_index') }, { label: quote.number }]
    } %}
        {% block page_intro %}
                        <div class="cn-quote-meta"><span>Version {{ quote.version }}</span><span class="cn-account-status cn-account-status--{{ quote.status.value }}">{{ ('cardnext.quote.status.' ~ quote.status.value)|trans }}</span><span>Gültig bis {{ quote.validUntil ? quote.validUntil|format_date(locale=quote.localeCode) : '–' }}</span></div>
        {% endblock %}
        {% block account_content %}
                    <section class="cn-account-panel cn-quote-detail">
                        <div class="cn-account-panel__body cn-quote-detail__intro">
                            <div><span class="cn-quote-detail__label">Kundendaten</span><address><strong>{{ quote.customerCompany }}</strong><br>{{ quote.customerContactName }}<br>{{ quote.customerStreet }} {{ quote.customerHouseNumber }}<br>{{ quote.customerPostalCode }} {{ quote.customerCity }}</address></div>
                            <div><span class="cn-quote-detail__label">Angebotsdatum</span><p>{{ quote.quoteDate ? quote.quoteDate|format_date(locale=quote.localeCode) : '–' }}</p>{% if quote.projectReference %}<span class="cn-quote-detail__label">Projekt</span><p>{{ quote.projectReference }}</p>{% endif %}</div>
                        </div>
                        <div class="cn-account-table-wrap cn-account-table-wrap--flush">
                            <table class="cn-account-table cn-account-table--items"><thead><tr><th>Pos.</th><th>Artikel</th><th>Menge</th><th class="cn-account-table__money">Einzelpreis</th><th>Rabatt</th><th class="cn-account-table__money">Netto</th></tr></thead><tbody>
                            {% for item in quote.items %}<tr><td>{{ item.position }}</td><td><strong>{{ item.name }}</strong>{% if item.description %}<small>{{ item.description }}</small>{% endif %}</td><td>{{ item.quantity }}</td><td class="cn-account-table__money">{{ (item.unitPrice / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</td><td>{{ item.discountPercent is null ? '–' : (item.discountPercent / 100)|format_number(locale=quote.localeCode) ~ ' %' }}</td><td class="cn-account-table__money"><strong>{{ (item.lineTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</strong></td></tr>{% endfor %}
                            </tbody></table>
                        </div>
                        <div class="cn-account-panel__body cn-quote-detail__footer">
                            <dl class="cn-quote-totals">
                                <dt>Netto</dt><dd>{{ (quote.subtotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</dd>
                                <dt>Versand</dt><dd>{{ (quote.shippingTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</dd>
                                <dt>Service</dt><dd>{{ (quote.serviceTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</dd>
                                <dt>MwSt.</dt><dd>{{ (quote.taxTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</dd>
                                <dt class="cn-quote-totals__grand">Gesamtsumme</dt><dd class="cn-quote-totals__grand">{{ (quote.grandTotal / 100)|format_currency(quote.currencyCode, locale=quote.localeCode) }}</dd>
                            </dl>
                            <div class="cn-quote-terms">{% if quote.deliveryTerms %}<div><h2>Lieferbedingungen</h2><p>{{ quote.deliveryTerms|nl2br }}</p></div>{% endif %}{% if quote.paymentTerms %}<div><h2>Zahlungsbedingungen</h2><p>{{ quote.paymentTerms|nl2br }}</p></div>{% endif %}{% if quote.customerNote %}<div><h2>Hinweis</h2><p>{{ quote.customerNote|nl2br }}</p></div>{% endif %}</div>
                            <div class="cn-account-actions"><a class="btn btn-outline-primary" href="{{ path('cardnext_shop_account_quote_pdf', {number: quote.number, version: quote.version}) }}">PDF herunterladen</a></div>
                            {% if quote.status.value == 'sent' and not expired %}
                                <div class="cn-quote-decisions">
                                    <form method="post" action="{{ path('cardnext_shop_account_quote_accept', {number: quote.number, version: quote.version}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_' ~ quote.id) }}"><label class="form-check"><input class="form-check-input" type="checkbox" name="binding" value="1" required><span>Ich nehme dieses Angebot verbindlich an.</span></label><button class="btn btn-primary">Angebot annehmen</button></form>
                                    <form method="post" action="{{ path('cardnext_shop_account_quote_reject', {number: quote.number, version: quote.version}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_decide_' ~ quote.id) }}"><label for="quote-reason">Ablehnungsgrund <span>(optional)</span></label><textarea id="quote-reason" class="form-control" name="reason" maxlength="2000"></textarea><button class="btn btn-outline-primary">Angebot ablehnen</button></form>
                                </div>
                            {% endif %}
                        </div>
                    </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
