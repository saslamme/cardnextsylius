{% if products|length > 0 %}
<div class="cn-product-grid cn-product-grid--4 cn-product-grid--lined">
{% for product in products %}{{ component('cardnext:product:card', {product: product}) }}{% endfor %}
</div>
{% else %}<div class="cn-panel">{{ 'cardnext.storefront.homepage.products.empty'|trans }}</div>{% endif %}
