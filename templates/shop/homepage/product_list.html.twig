{% if products|length > 0 %}
    <div class="cn-products">
        {% for product in products %}
            <div>
                {{ component('sylius_shop:product:card', {
                    product: product,
                    template: '@SyliusShop/product/common/card.html.twig',
                    hookableMetadata: hookable_metadata|default(null)
                }) }}
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="cn-empty-products">Noch keine Produkte für diesen Verkaufskanal veröffentlicht.</div>
{% endif %}
