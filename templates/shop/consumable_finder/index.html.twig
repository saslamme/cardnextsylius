{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Verbrauchsmaterial-Finder für Kartendrucker | Cardnext{% endblock %}
{% block metatags %}
    {{ parent() }}
    <meta name="description" content="Finden Sie passende Farbbänder, Reinigungsprodukte und Zubehör für Ihren Kartendrucker. Hersteller und Modell auswählen und kompatible Produkte anzeigen.">
    <link rel="canonical" href="{{ url('cardnext_shop_consumable_finder', {_locale: app.request.locale}) }}">
{% endblock %}

{% block content %}
{% set manufacturers = {} %}
{% for item in devices %}{% set key = item.manufacturer.code %}{% set manufacturers = manufacturers|merge({(key): {name: item.manufacturer.name, devices: (manufacturers[key].devices|default([]))|merge([item])}}) %}{% endfor %}
<main class="cn-page cn-finder" data-consumable-finder>
    <nav class="cn-breadcrumbs" aria-label="Breadcrumb"><div class="cn-container cn-breadcrumbs__inner"><a href="{{ path('sylius_shop_homepage', {'_locale': app.request.locale}) }}">{{ 'cardnext.storefront.common.home'|trans }}</a><span class="cn-breadcrumbs__sep">/</span><span>Verbrauchsmaterial-Finder</span></div></nav>
    <section class="cn-section"><div class="cn-container">
        <header class="cn-finder__header"><span class="cn-kicker">Verbrauchsmaterial &amp; Zubehör</span><h1 class="cn-title cn-title--section">Das passende Material für Ihr Gerät</h1><p>Wählen Sie Hersteller und Modell aus. Wir zeigen Ihnen kompatible Farbbänder, Reinigungsprodukte und Zubehör.</p></header>
        <form class="cn-finder__form" method="get" action="{{ path('cardnext_shop_consumable_finder', {_locale: app.request.locale}) }}">
            <div class="cn-finder__field"><label for="finder-maker">Hersteller</label><select id="finder-maker" data-finder-maker><option value="">Bitte wählen</option>{% for code, maker in manufacturers %}<option value="{{ code }}" {{ device and device.manufacturer.code == code ? 'selected' }}>{{ maker.name }}</option>{% endfor %}</select></div>
            <div class="cn-finder__field"><label for="finder-device">Modell</label><select id="finder-device" name="device" data-finder-device><option value="">Bitte wählen</option>{% for code, maker in manufacturers %}{% for item in maker.devices %}<option value="{{ item.slug }}" data-maker="{{ code }}" {{ device and device.slug == item.slug ? 'selected' }}>{{ item.name }}{% if item.status != 'active' %} · Älteres Modell{% endif %}</option>{% endfor %}{% endfor %}</select></div>
            <div class="cn-finder__field"><label for="finder-type">Was benötigen Sie?</label><select id="finder-type" name="type"><option value="all" {{ typeKey == 'all' ? 'selected' }}>Alle</option><option value="consumable" {{ typeKey == 'consumable' ? 'selected' }}>Verbrauchsmaterial</option><option value="cleaning" {{ typeKey == 'cleaning' ? 'selected' }}>Reinigung</option><option value="accessory" {{ typeKey == 'accessory' ? 'selected' }}>Zubehör</option></select></div>
            <button class="cn-btn cn-btn--primary" type="submit">Passende Produkte anzeigen</button>
            <div class="cn-finder__search"><label for="finder-search">Gerätemodell suchen</label><input id="finder-search" type="search" placeholder="z. B. ZC350, Primacy 2, Sigma DS3" autocomplete="off" list="finder-models" data-finder-search><datalist id="finder-models">{% for item in devices %}<option value="{{ item.manufacturer.name }} {{ item.name }}" data-slug="{{ item.slug }}"></option>{% for alias in item.aliases %}<option value="{{ alias.alias }}" data-slug="{{ item.slug }}"></option>{% endfor %}{% endfor %}</datalist></div>
        </form>

        {% if device %}
            <section class="cn-finder__results"><h2 class="cn-title cn-title--sm">Passend für {{ device.manufacturer.name }} {{ device.name }}</h2>
            {% set labels = {'consumable_for': 'Farbbänder & Verbrauchsmaterial', 'cleaning_for': 'Reinigung', 'accessory_for': 'Zubehör'} %}
            {% set has_results = false %}{% for compatibilityType, relations in groups %}{% if relations|length %}{% set has_results = true %}<div class="cn-finder__group"><h3>{{ labels[compatibilityType] }}</h3><div class="cn-product-grid cn-product-grid--lined">{% for relation in relations %}<div class="cn-finder__result">{{ component('cardnext:product:card', {product: relation.product}) }}{% if relation.verified or relation.note %}<div class="cn-finder__compatibility">{% if relation.verified %}<span>✓ Kompatibilität geprüft</span>{% endif %}{% if relation.note %}<p>{{ relation.note }}</p>{% endif %}</div>{% endif %}</div>{% endfor %}</div></div>{% endif %}{% endfor %}
            {% if not has_results %}<div class="cn-finder__empty"><h3>Für dieses Gerät sind aktuell noch keine passenden Produkte hinterlegt.</h3><p>Unser Team hilft Ihnen gerne bei der Auswahl.</p><a class="cn-btn cn-btn--secondary" href="{{ path('sylius_shop_contact_request') }}">Produkt anfragen</a></div>{% endif %}
            </section>
        {% elseif deviceSlug %}<div class="cn-finder__empty"><h2>Dieses Gerätemodell wurde nicht gefunden.</h2><p>Bitte wählen Sie ein Modell aus der Liste oder senden Sie uns eine Anfrage.</p></div>{% endif %}
        <aside class="cn-finder__help"><div><h2>Ihr Modell ist nicht dabei?</h2><p>Senden Sie uns Hersteller und Modellbezeichnung. Wir suchen das passende Verbrauchsmaterial für Sie.</p></div><a class="cn-btn cn-btn--secondary" href="{{ path('sylius_shop_contact_request') }}">Anfrage senden</a></aside>
    </div></section>
</main>
{% endblock %}
