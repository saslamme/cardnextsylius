{% set product = hookable_metadata.context.product %}
{% set offer = cardnext_leasing_offer(product) %}

{% if offer and offer.rates is not empty %}
    {% set preferred = offer.rates[offer.preferredIndex] %}
    {% set inquiry_url = path('cardnext_shop_leasing_inquiry', {code: product.code}) %}
    <section class="cardnext-leasing" data-cn-leasing data-rate-label="{{ 'cardnext.leasing.from_rate'|trans({'%rate%': '__RATE__'}) }}" data-duration-label="{{ 'cardnext.leasing.at_duration'|trans({'%months%': '__MONTHS__'}) }}" aria-labelledby="cardnext-leasing-title">
        <header class="cardnext-leasing__header">
            <h2 class="cardnext-leasing__title" id="cardnext-leasing-title">{{ 'cardnext.leasing.for_business_customers'|trans }}</h2>
        </header>

        <div class="cardnext-leasing__price" aria-live="polite" aria-atomic="true">
            <strong data-cn-leasing-rate>{{ 'cardnext.leasing.from_rate'|trans({'%rate%': preferred.rate|sylius_format_money(offer.currencyCode)}) }}</strong>
            <span data-cn-leasing-duration>{{ 'cardnext.leasing.at_duration'|trans({'%months%': preferred.factor.durationMonths}) }}</span>
        </div>

        {% if offer.rates|length > 1 %}
            <fieldset class="cardnext-leasing__terms">
                <legend>{{ 'cardnext.leasing.choose_duration'|trans }}</legend>
                <div class="cardnext-leasing__term-list">
                    {% for item in offer.rates %}
                        {% set is_preferred = loop.index0 == offer.preferredIndex %}
                        <label class="cardnext-leasing__term">
                            <input type="radio" name="cardnext-leasing-duration-{{ product.code }}" value="{{ item.factor.durationMonths }}" data-rate="{{ item.rate|sylius_format_money(offer.currencyCode) }}"{% if is_preferred %} checked{% endif %}>
                            <span>{{ 'cardnext.leasing.months'|trans({'%months%': item.factor.durationMonths}) }}</span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
        {% endif %}

        <a class="cn-btn cn-btn--secondary cardnext-leasing__cta" data-cn-leasing-cta data-base-url="{{ inquiry_url }}" href="{{ inquiry_url }}?duration={{ preferred.factor.durationMonths }}">{{ offer.configuration.ctaText }}</a>
        <p class="cardnext-leasing__notice">{{ offer.configuration.frontendNotice }}</p>
    </section>
{% endif %}
