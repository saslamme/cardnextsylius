<section class="cn-maintenance" aria-labelledby="cn-maintenance-heading">
    <h2 id="cn-maintenance-heading" class="cn-maintenance__heading">{{ 'cardnext.maintenance.heading'|trans }}</h2>

    <div class="cn-maintenance__offers">
        {% if offers|length > 1 %}
            <label class="cn-maintenance__none">
                <input class="cn-maintenance__control" type="radio" name="{{ field.vars.full_name }}" value="" checked>
                <span>{{ 'cardnext.maintenance.none'|trans }}</span>
            </label>
        {% endif %}

        {% for offer in offers %}
            <label class="cn-maintenance__card">
                <svg class="cn-maintenance__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 5 6v5c0 4.8 2.8 8.1 7 10 4.2-1.9 7-5.2 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
                <span class="cn-maintenance__content">
                    <strong class="cn-maintenance__title">{{ offer.product.name }}</strong>
                    {% if offer.product.shortDescription %}
                        <span class="cn-maintenance__subtitle">{{ offer.product.shortDescription|striptags }}</span>
                    {% endif %}
                    {% if offer.product.description %}
                        <details class="cn-maintenance__details">
                            <summary>{{ 'cardnext.maintenance.details'|trans }}</summary>
                            <div>{{ offer.product.description|striptags|nl2br }}</div>
                        </details>
                    {% endif %}
                </span>
                <span class="cn-maintenance__price">{{ offer.price|sylius_format_money(offer.currencyCode, app.request.locale) }}</span>
                <input
                    class="cn-maintenance__control"
                    type="{{ offers|length == 1 ? 'checkbox' : 'radio' }}"
                    name="{{ field.vars.full_name }}"
                    value="{{ offer.variant.id }}"
                >
            </label>
        {% endfor %}
    </div>
</section>
