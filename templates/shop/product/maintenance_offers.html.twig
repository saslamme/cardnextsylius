{% set groups = [
    {offers: serviceOffers, field: serviceField, category: 'service'},
    {offers: warrantyOffers, field: warrantyField, category: 'warranty'}
] %}

{% for group in groups %}
    {% if group.offers is not empty and group.field %}
        {% set selected = group.field.vars.value|default('') %}
        <section class="cn-maintenance" aria-labelledby="cn-maintenance-{{ group.category }}-heading">
            <h2 id="cn-maintenance-{{ group.category }}-heading" class="cn-maintenance__heading">{{ ('cardnext.maintenance.' ~ group.category ~ '_heading')|trans }}</h2>
            <details class="cn-maintenance__accordion"{% if selected %} open{% endif %}>
                <summary class="cn-maintenance__summary">
                    <span><strong>{{ ('cardnext.maintenance.' ~ group.category ~ '_title')|trans }}</strong><small>{{ ('cardnext.maintenance.' ~ group.category ~ '_subtitle')|trans }}</small></span>
                    <span class="cn-maintenance__chevron" aria-hidden="true"></span>
                </summary>
                <div class="cn-maintenance__offers">
                    <label class="cn-maintenance__none">
                        <input class="cn-maintenance__control" type="radio" name="{{ group.field.vars.full_name }}" value=""{% if not selected %} checked{% endif %}>
                        <span>{{ ('cardnext.maintenance.none_' ~ group.category)|trans }}</span>
                    </label>
                    {% for offer in group.offers %}
                        {% set controlId = group.field.vars.id ~ '_' ~ loop.index %}
                        <div class="cn-maintenance__card">
                            <label class="cn-maintenance__choice" for="{{ controlId }}">
                                <svg class="cn-maintenance__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 5 6v5c0 4.8 2.8 8.1 7 10 4.2-1.9 7-5.2 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
                                <span class="cn-maintenance__content">
                                    <strong class="cn-maintenance__title">{{ offer.product.name }}</strong>
                                    {% if offer.product.shortDescription %}<span class="cn-maintenance__subtitle">{{ offer.product.shortDescription|striptags }}</span>{% endif %}
                                </span>
                                <span class="cn-maintenance__price">{{ offer.price|sylius_format_money(offer.currencyCode, app.request.locale) }}</span>
                                <input id="{{ controlId }}" class="cn-maintenance__control" type="radio" name="{{ group.field.vars.full_name }}" value="{{ offer.variant.id }}"{% if selected == offer.variant.id %} checked{% endif %}>
                            </label>
                            {% if offer.product.description %}
                                <details class="cn-maintenance__details">
                                    <summary>{{ 'cardnext.maintenance.details'|trans }}</summary>
                                    <div>{{ offer.product.description|striptags|nl2br }}</div>
                                </details>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </details>
        </section>
    {% endif %}
{% endfor %}
