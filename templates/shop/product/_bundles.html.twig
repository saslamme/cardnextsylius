{% set product = hookable_metadata.context.product|default(null) %}
{% set bundles = cardnext_product_bundles(product) %}
{% if bundles is not empty %}
<section class="cn-product-bundles" aria-labelledby="frequently-bought-heading">
    <div class="cn-container">
        <h2 id="frequently-bought-heading" class="cn-product-bundles__title">Häufig zusammen gekauft</h2>
        <div class="cn-product-bundles__list">
            {% for view in bundles %}
                {% set hasDiscount = view.configuration.discountType != 'NONE' %}
                <form class="cn-bundle" method="post" action="{{ path('cardnext_shop_bundle_add', {code: view.bundle.code}) }}" data-controller="bundle-calculator" data-bundle-calculator-discount-type-value="{{ view.configuration.discountType }}" data-bundle-calculator-discount-value-value="{{ view.configuration.discountType == 'FIXED' ? view.configuration.fixedDiscount : view.configuration.percentageDiscount }}">
                    <h3 class="cn-bundle__title">{{ view.bundle.name }}</h3>
                    <div class="cn-bundle__content">
                        <div class="cn-bundle__products">
                            <article class="cn-bundle-product cn-bundle-product--main">
                                <a class="cn-bundle-product__media" href="{{ cardnext_product_url(product) }}" tabindex="-1" aria-hidden="true">
                                    {{ component('sylius_shop:main_image', {product: product, class: 'cn-bundle-product__image'}) }}
                                </a>
                                <div class="cn-bundle-product__body">
                                    <div class="cn-bundle-product__code">{{ view.main.variant.code }}</div>
                                    <h4 class="cn-bundle-product__name"><a href="{{ cardnext_product_url(product) }}">{{ product.name }}</a></h4>
                                    <div class="cn-bundle-product__price">{{ view.main.unitPrice|sylius_format_money(sylius.currencyCode, sylius.localeCode) }}</div>
                                    <div class="cn-bundle-product__required">Dieses Produkt</div>
                                </div>
                                <input type="hidden" name="mainVariant" value="{{ view.main.variant.id }}">
                                <input type="hidden" data-bundle-calculator-target="item" data-price="{{ view.main.unitPrice }}" data-quantity="1" checked>
                            </article>
                            {% for componentItem in view.components %}
                                {% set componentProduct = componentItem.variant.product %}
                                <span class="cn-bundle__plus" aria-hidden="true">+</span>
                                <article class="cn-bundle-product">
                                    <a class="cn-bundle-product__media" href="{{ cardnext_product_url(componentProduct) }}" tabindex="-1" aria-hidden="true">
                                        {{ component('sylius_shop:main_image', {product: componentProduct, class: 'cn-bundle-product__image'}) }}
                                    </a>
                                    <div class="cn-bundle-product__body">
                                        <div class="cn-bundle-product__code">{{ componentItem.variant.code }}</div>
                                        <h4 class="cn-bundle-product__name"><a href="{{ cardnext_product_url(componentProduct) }}">{{ componentProduct.name }}</a></h4>
                                        <div class="cn-bundle-product__price">
                                            {% if componentItem.quantity > 1 %}
                                                <span>{{ componentItem.quantity }} × {{ componentItem.unitPrice|sylius_format_money(sylius.currencyCode, sylius.localeCode) }}</span>
                                                <strong>{{ (componentItem.unitPrice * componentItem.quantity)|sylius_format_money(sylius.currencyCode, sylius.localeCode) }} gesamt</strong>
                                            {% else %}
                                                <strong>{{ componentItem.unitPrice|sylius_format_money(sylius.currencyCode, sylius.localeCode) }}</strong>
                                            {% endif %}
                                        </div>
                                        <label class="cn-bundle-product__option">
                                            <input class="cn-bundle-product__checkbox" type="checkbox" name="components[]" value="{{ componentItem.variant.id }}" checked data-bundle-calculator-target="item" data-price="{{ componentItem.unitPrice }}" data-quantity="{{ componentItem.quantity }}" data-action="bundle-calculator#recalculate">
                                            <span>Einschließen</span>
                                        </label>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>

                        <aside class="cn-bundle-summary" aria-label="Zusammenfassung">
                            <h4 class="cn-bundle-summary__title">Zusammenfassung</h4>
                            <dl class="cn-bundle-summary__prices">
                                {% if hasDiscount %}
                                    <div class="cn-bundle-summary__row"><dt>Einzelpreis zusammen</dt><dd data-bundle-calculator-target="subtotal"></dd></div>
                                    <div class="cn-bundle-summary__row cn-bundle-summary__total"><dt>Bundle-Preis</dt><dd data-bundle-calculator-target="total"></dd></div>
                                    <div class="cn-bundle-summary__row cn-bundle-summary__saving"><dt>Sie sparen</dt><dd data-bundle-calculator-target="saving"></dd></div>
                                {% else %}
                                    <div class="cn-bundle-summary__row cn-bundle-summary__total"><dt>Gesamtpreis</dt><dd data-bundle-calculator-target="total"></dd></div>
                                {% endif %}
                            </dl>
                            {% if hasDiscount %}<p class="cn-bundle-summary__notice d-none" data-bundle-calculator-target="notice">Bundle-Vorteil gilt beim Kauf aller Artikel.</p>{% endif %}
                            <label class="cn-bundle-summary__quantity">
                                <span>Bundle-Menge</span>
                                <input class="form-control" type="number" name="quantity" min="1" max="100" value="1" inputmode="numeric" data-bundle-calculator-target="bundleQuantity" data-action="bundle-calculator#recalculate">
                            </label>
                            <button class="cn-btn cn-btn--primary cn-btn--block cn-bundle-summary__cta" type="submit"><span class="cn-bundle-summary__cta-long">Alle ausgewählten Artikel in den Warenkorb</span><span class="cn-bundle-summary__cta-short">Auswahl in den Warenkorb</span></button>
                        </aside>
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('bundle_add_' ~ view.bundle.code) }}">
                </form>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
