{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% block title %}{{ manufacturer.seoTitle ?: manufacturer.name ~ ' Produkte & Lösungen | Cardnext' }}{% endblock %}
{% block metatags %}{{ parent() }}<meta name="description" content="{{ manufacturer.seoDescription ?: 'Entdecken Sie ' ~ manufacturer.name ~ ' Produkte für professionelle Identifikation und Auto-ID bei Cardnext.' }}"><link rel="canonical" href="{{ absolute_url(path('cardnext_shop_brand_show', {_locale: app.request.locale, slug: manufacturer.slug})) }}">{% endblock %}
{% block content %}
<main class="cn-brands cn-brand-detail">
 <div class="cn-breadcrumbs"><nav class="cn-container cn-breadcrumbs__inner" aria-label="Breadcrumb"><a href="{{ path('sylius_shop_homepage') }}">Startseite</a><span class="cn-breadcrumbs__sep" aria-hidden="true">/</span><a href="{{ path('cardnext_shop_brands', {_locale: app.request.locale}) }}">Marken</a><span class="cn-breadcrumbs__sep" aria-hidden="true">/</span><span aria-current="page">{{ manufacturer.name }}</span></nav></div>
 <div class="cn-brand-detail__content">
 <div class="cn-container">
 <header class="cn-brand-detail__header"><a class="cn-link" href="{{ path('cardnext_shop_brands', {_locale: app.request.locale}) }}">← Alle Marken</a><div class="cn-brand-detail__intro"><div class="cn-brand-detail__logo">{% if manufacturer.logoPath %}<img src="{{ asset(manufacturer.logoPath) }}" alt="{{ manufacturer.name }} Logo">{% else %}<strong>{{ manufacturer.name }}</strong>{% endif %}</div><div class="cn-brand-detail__copy"><span class="cn-kicker">Marke</span><h1 class="cn-title cn-title--section">{{ manufacturer.name }}</h1><div class="cn-brand-detail__description">{% if manufacturer.description %}{{ manufacturer.description|striptags|nl2br }}{% else %}Entdecken Sie Produkte von {{ manufacturer.name }} für professionelle Identifikations- und Auto-ID-Anwendungen.{% endif %}</div></div></div></header>
 {% if areas %}<section class="cn-brand-section"><h2 class="cn-title cn-title--sm">Produktbereiche</h2><div class="cn-brand-areas">{% for area in areas %}<a href="{{ path('sylius_shop_product_index', {_locale: app.request.locale, slug: area.slug}) }}?manufacturer={{ manufacturer.slug }}">{{ area.name }} <span>→</span></a>{% endfor %}</div></section>{% endif %}
 <section class="cn-brand-section" id="produkte"><h2 class="cn-title cn-title--sm">Produkte von {{ manufacturer.name }}</h2><div class="cn-product-grid cn-product-grid--lined">{% for product in products %}{{ component('cardnext:product:card', {product: product}) }}{% endfor %}</div>{% if pageCount > 1 %}<nav class="cn-brand-pagination" aria-label="Seitennavigation">{% if page > 1 %}<a class="cn-btn cn-btn--secondary" rel="prev" href="{{ path('cardnext_shop_brand_show', {_locale: app.request.locale, slug: manufacturer.slug, page: page - 1}) }}">← Zurück</a>{% endif %}<span>Seite {{ page }} von {{ pageCount }}</span>{% if page < pageCount %}<a class="cn-btn cn-btn--secondary" rel="next" href="{{ path('cardnext_shop_brand_show', {_locale: app.request.locale, slug: manufacturer.slug, page: page + 1}) }}">Weiter →</a>{% endif %}</nav>{% endif %}</section>
 <aside class="cn-brand-cta"><div><h2>Unterstützung bei Produkten von {{ manufacturer.name }}?</h2><p>Wir helfen Ihnen bei der Auswahl kompatibler Hardware und Verbrauchsmaterialien.</p></div><a class="cn-btn cn-btn--primary" href="{{ path('sylius_shop_contact_request') }}">Beratung anfragen</a></aside>
</div></div></main>
{% endblock %}
