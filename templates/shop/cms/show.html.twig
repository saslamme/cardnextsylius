{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% block title %}{{ translation.metaTitle ?: translation.title }}{% endblock %}
{% block metatags %}{{ parent() }}
    {% if translation.metaDescription %}<meta name="description" content="{{ translation.metaDescription }}">{% endif %}
    <meta name="robots" content="{{ translation.robotsIndex ? 'index' : 'noindex' }},{{ translation.robotsFollow ? 'follow' : 'nofollow' }}">
    <meta property="og:title" content="{{ translation.ogTitle ?: translation.metaTitle ?: translation.title }}">
    {% if translation.ogDescription ?: translation.metaDescription %}<meta property="og:description" content="{{ translation.ogDescription ?: translation.metaDescription }}">{% endif %}
    <link rel="canonical" href="{{ translation.canonicalUrl ?: absolute_url('/' ~ translation.slug) }}">
{% endblock %}
{% block content %}<main class="cn-container py-5 cardnext-cms cardnext-cms--{{ page.layout.renderer }}"><header class="mb-5"><h1>{{ translation.title }}</h1>{% if translation.lead %}<p class="lead">{{ translation.lead }}</p>{% endif %}</header>{% for block in page.blocks|filter(b => b.enabled and b.locale == locale) %}{% include cardnext_cms_block_template(block.type) with {config: block.configuration} only %}{% endfor %}</main>{% endblock %}
