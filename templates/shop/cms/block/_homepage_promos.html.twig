<section class="cn-section cn-home-promos"><div class="cn-container"><div class="cn-home-promos__grid">{% for block in promoBlocks %}{% set promo=block.configuration %}<article class="cn-home-promo{{ promo.image|default ? '' : ' cn-home-promo--text-only' }}"><div class="cn-home-promo__copy">{% if promo.preheadline|default %}<span class="cn-kicker">{{ promo.preheadline }}</span>{% endif %}<h3>{{ promo.headline }}</h3>{% if promo.text|default %}<p>{{ promo.text }}</p>{% endif %}<div class="cn-home-promo__actions">{% if promo.buttonLabel|default and promo.buttonUrl|default %}<a class="cn-btn cn-btn--primary" href="{{ promo.buttonUrl }}">{{ promo.buttonLabel }} <span aria-hidden="true">&#8594;</span></a>{% endif %}{% if promo.badge|default %}<span class="cn-home-promo__benefit"><span aria-hidden="true">&#10003;</span> {{ promo.badge }}</span>{% endif %}</div></div>{% if promo.image|default %}<div class="cn-home-promo__media"><img class="cn-home-promo__image" src="{{ asset(promo.image) }}" alt="" loading="lazy"></div>{% endif %}</article>{% endfor %}</div></div></section>
