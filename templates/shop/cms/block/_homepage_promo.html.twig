<section class="cn-section"><div class="cn-container"><article class="cn-card cn-card--promo">{% if config.image|default %}<div class="cn-card__media"><img class="cn-card__photo" src="{{ asset(config.image) }}" alt="" loading="lazy"></div>{% endif %}<div class="cn-card__body">{% if config.badge|default %}<span class="cn-badge">{{ config.badge }}</span>{% endif %}{% if config.preheadline|default %}<span class="cn-kicker">{{ config.preheadline }}</span>{% endif %}<h2>{{ config.headline }}</h2>{% if config.text|default %}<p>{{ config.text }}</p>{% endif %}<a class="cn-btn cn-btn--primary" href="{{ config.buttonUrl }}">{{ config.buttonLabel }}</a></div></article></div></section>
