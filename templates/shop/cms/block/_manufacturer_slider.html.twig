{% set manufacturers = cardnext_cms_manufacturers(config.manufacturerCodes|default([]), config.limit|default(12)) %}
{% if manufacturers is not empty %}
<section class="cn-cms-manufacturer-slider cn-manufacturer-slider mb-5" data-cn-manufacturer-slider>
 <div class="cn-section-head"><div>{% if config.headline|default %}<h2>{{ config.headline }}</h2>{% endif %}{% if config.text|default %}<p class="cn-lead">{{ config.text }}</p>{% endif %}</div>
 {% if config.showNavigation|default(true) %}<div class="cn-manufacturer-slider__controls"><button class="cn-slider-button" type="button" data-cn-manufacturer-slider-previous aria-label="Vorherige Hersteller" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="cn-slider-button" type="button" data-cn-manufacturer-slider-next aria-label="Nächste Hersteller"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></div>{% endif %}</div>
 <div class="cn-manufacturer-slider__viewport" data-cn-manufacturer-slider-viewport tabindex="0"><div class="cn-manufacturer-slider__track">{% for manufacturer in manufacturers %}<div class="cn-manufacturer-slider__slide">{% set content %}<span class="cn-manufacturer-card__media">{% if manufacturer.logoPath %}<img class="cn-manufacturer-card__logo" src="{{ asset(manufacturer.logoPath) }}" alt="{{ manufacturer.name }} Logo">{% else %}<strong class="cn-manufacturer-card__name">{{ manufacturer.name }}</strong>{% endif %}</span>{% endset %}{% if config.linkToManufacturer|default(true) %}<a class="cn-manufacturer-card" href="{{ path('cardnext_shop_brand_show', {slug: manufacturer.slug}) }}">{{ content|raw }}</a>{% else %}<div class="cn-manufacturer-card">{{ content|raw }}</div>{% endif %}</div>{% endfor %}</div></div>
</section>
{% endif %}
