{% set center = cardnext_cms_download_center(config) %}
{% set typeLabels = {
    manual: 'Handbücher', datasheet: 'Datenblätter', driver: 'Treiber', software: 'Software',
    firmware: 'Firmware', certificate: 'Zertifikate', other: 'Sonstiges'
} %}
{% set typeMetadataLabels = {
    manual: 'Handbuch', datasheet: 'Datenblatt', driver: 'Treiber', software: 'Software',
    firmware: 'Firmware', certificate: 'Zertifikat', other: 'Sonstiges'
} %}
{% set osLabels = {
    windows_11: 'Windows 11', windows_10: 'Windows 10', windows_server: 'Windows Server',
    macos: 'macOS', linux: 'Linux', other: 'Sonstiges'
} %}

<section class="cn-downloads my-5" aria-labelledby="downloads-heading">
    <div class="mb-4">
        <h2 id="downloads-heading" class="mb-2">{{ config.headline|default('Downloads & technische Unterlagen') }}</h2>
        <p class="text-secondary mb-0">Handbücher, Treiber und technische Dokumente für Ihre Cardnext Produkte.</p>
    </div>

    {% if config.showFilters|default(true) %}
        <form method="get" class="card border-0 shadow-sm mb-4" aria-label="Downloads filtern">
            <div class="card-body p-3 p-lg-4">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-4">
                        <label class="form-label fw-semibold" for="download-search">Suche</label>
                        <input id="download-search" class="form-control" type="search" name="q" value="{{ center.filters.q }}" placeholder="Titel, Hersteller oder Artikelnummer">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-2">
                        <label class="form-label fw-semibold" for="download-type">Dokumenttyp</label>
                        <select id="download-type" class="form-select" name="type">
                            <option value="">Alle</option>
                            {% for code, label in typeLabels %}
                                <option value="{{ code }}" {{ center.filters.type == code ? 'selected' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-2">
                        <label class="form-label fw-semibold" for="download-manufacturer">Hersteller</label>
                        <select id="download-manufacturer" class="form-select" name="manufacturer">
                            <option value="">Alle</option>
                            {% for manufacturer in center.manufacturers %}
                                <option value="{{ manufacturer }}" {{ center.filters.manufacturer == manufacturer ? 'selected' }}>{{ manufacturer }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-2">
                        <label class="form-label fw-semibold" for="download-os">Betriebssystem</label>
                        <select id="download-os" class="form-select" name="os">
                            <option value="">Alle</option>
                            {% for code, label in osLabels %}
                                <option value="{{ code }}" {{ center.filters.os == code ? 'selected' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-2 d-grid">
                        <button class="btn btn-primary" type="submit">Filtern</button>
                    </div>
                </div>
                {% if center.active %}
                    <div class="mt-3"><a class="link-secondary small" href="{{ app.request.pathInfo }}">Filter zurücksetzen</a></div>
                {% endif %}
            </div>
        </form>
    {% endif %}

    <p class="small text-secondary mb-3">
        <strong class="text-body">{{ center.downloads|length }}</strong>
        {{ center.downloads|length == 1 ? 'Download gefunden' : 'Downloads gefunden' }}
    </p>

    {% for manufacturer, downloads in center.groups %}
        <div class="mb-5">
            <h3 class="h5 border-bottom pb-2 mb-3">{{ manufacturer }}</h3>
            <div class="d-grid gap-3">
                {% for download in downloads %}
                    {% set translation = download.getTranslation(app.request.locale) %}
                    <article class="card border-0 shadow-sm">
                        <div class="card-body p-3 p-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <h4 class="h6 mb-2">{{ translation.title }}</h4>
                                {% set metadata = [typeMetadataLabels[download.type]] %}
                                {% if download.originalFilename %}{% set metadata = metadata|merge([download.originalFilename|split('.')|last|upper]) %}{% endif %}
                                {% if download.version %}{% set metadata = metadata|merge(['Version ' ~ download.version]) %}{% endif %}
                                {% if download.fileSize %}{% set metadata = metadata|merge([(download.fileSize / 1048576)|number_format(1, ',', '.') ~ ' MB']) %}{% endif %}
                                <div class="small text-secondary">{{ metadata|join(' · ') }}</div>
                                {% if download.productFamily %}<div class="small mt-2"><span class="text-secondary">Produktreihe:</span> {{ download.productFamily }}</div>{% endif %}
                                {% if download.operatingSystems %}
                                    <div class="small mt-1 text-secondary">{{ download.operatingSystems|map(code => osLabels[code]|default(code))|join(' · ') }}</div>
                                {% endif %}
                            </div>
                            <a class="btn btn-outline-primary flex-shrink-0" href="{{ path('cardnext_cms_download_file', {id: download.id}) }}">Herunterladen</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5 px-3">
                <h3 class="h5 mb-3">Keine passenden Downloads gefunden.</h3>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a class="btn btn-outline-secondary" href="{{ app.request.pathInfo }}">Filter zurücksetzen</a>
                    <a class="btn btn-primary" href="/support">Support kontaktieren</a>
                </div>
            </div>
        </div>
    {% endfor %}
</section>
