{% set downloads = cardnext_cms_downloads(config) %}
<section class="cn-downloads my-5">
    <h2>{{ config.headline|default('Downloads & technische Unterlagen') }}</h2>
    {% if config.showFilters|default(true) %}
        <form method="get" class="card card-body mb-4">
            <div class="row g-2">
                <div class="col-md"><input class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="Downloads durchsuchen"></div>
                <div class="col-md"><select class="form-select" name="type"><option value="">Alle Typen</option>{% for code,label in {'manual':'Handbücher','datasheet':'Datenblätter','driver':'Treiber','software':'Software','firmware':'Firmware','certificate':'Zertifikate','other':'Sonstiges'} %}<option value="{{ code }}" {{ app.request.query.get('type') == code ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div>
                <div class="col-auto"><button class="btn btn-primary">Filtern</button></div>
            </div>
        </form>
    {% endif %}
    {% set previousManufacturer = null %}
    {% for download in downloads %}
        {% if download.manufacturer != previousManufacturer %}
            {% if previousManufacturer is not null %}</div>{% endif %}
            <div class="mb-4"><h3 class="border-bottom pb-2">{{ download.manufacturer }}</h3>
            {% set previousManufacturer = download.manufacturer %}
        {% endif %}
        {% set translation = download.getTranslation(app.request.locale) %}
        <article class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center gap-3"><div><strong>{{ translation.title }}</strong><div class="text-secondary">{{ {'manual':'Handbuch','datasheet':'Datenblatt','driver':'Treiber','software':'Software','firmware':'Firmware','certificate':'Zertifikat','other':'Sonstiges'}[download.type] }}{% if download.mimeType %} · {{ download.originalFilename|split('.')|last|upper }}{% endif %}{% if download.version %} · Version {{ download.version }}{% endif %}{% if download.fileSize %} · {{ (download.fileSize / 1048576)|number_format(1, ',', '.') }} MB{% endif %}</div></div><a class="btn btn-primary" href="{{ path('cardnext_cms_download_file',{id:download.id}) }}">Herunterladen</a></div></article>
    {% else %}
        <div class="card"><div class="card-body text-center py-5">Derzeit sind noch keine Downloads für diese Auswahl verfügbar.<br><a href="/support">Support kontaktieren</a></div></div>
    {% endfor %}
    {% if previousManufacturer is not null %}</div>{% endif %}
</section>
