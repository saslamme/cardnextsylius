<section class="cn-home-service"><div class="cn-container cn-home-service__grid"><div class="cn-home-service__feature"><div class="cn-home-service__copy">{% if config.kicker|default %}<span class="cn-kicker">{{ config.kicker }}</span>{% endif %}<h2 class="cn-title cn-title--section">{{ config.headline }}</h2><p class="cn-lead">{{ config.text }}</p>{% if config.buttonLabel|default and config.buttonUrl|default %}<a class="cn-btn cn-btn--secondary" href="{{ config.buttonUrl }}">{{ config.buttonLabel }} &#8594;</a>{% endif %}</div>{% if config.image|default %}<div class="cn-home-service__photo"><img src="{{ asset(config.image) }}" alt="" loading="lazy"></div>{% endif %}</div><div class="cn-home-service__list">{% for item in config.items|default([]) %}<a class="cn-home-service__item" href="{{ item.linkUrl|default('#') }}"><span class="cn-home-service__icon" aria-hidden="true">{% include 'shop/cms/block/_semantic_icon.html.twig' with {icon:item.icon|default('advice')} only %}</span><span class="cn-home-service__item-copy"><strong>{{ item.title }}</strong><span>{{ item.text }}</span></span><span class="cn-home-service__arrow" aria-hidden="true">&#8594;</span></a>{% endfor %}</div></div></section>
