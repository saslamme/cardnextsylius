<section class="cn-home-service"><div class="cn-container cn-home-service__grid"><div class="cn-home-service__feature"><div class="cn-home-service__copy">{% if config.kicker|default %}<span class="cn-kicker">{{ config.kicker }}</span>{% endif %}<h2 class="cn-title cn-title--section">{{ config.headline }}</h2><p class="cn-lead">{{ config.text }}</p>{% if config.buttonLabel|default and config.buttonUrl|default %}<a class="cn-btn cn-btn--secondary" href="{{ config.buttonUrl }}">{{ config.buttonLabel }} &#8594;</a>{% endif %}</div>{% if config.image|default %}<div class="cn-home-service__photo"><img src="{{ asset(config.image) }}" alt="" loading="lazy"></div>{% endif %}</div></div></section>
