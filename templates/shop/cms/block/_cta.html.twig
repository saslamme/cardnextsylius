<section class="cn-cta cn-cta--support">{% if config.image|default %}<img class="cn-cta__background" src="{{ asset(config.image) }}" alt="" loading="lazy" aria-hidden="true">{% endif %}<div class="cn-container cn-cta__inner"><div class="cn-cta__copy">{% if config.kicker|default %}<span class="cn-kicker">{{ config.kicker }}</span>{% endif %}<h2>{{ config.headline }}</h2>{% if config.text|default %}<p>{{ config.text }}</p>{% endif %}</div><a class="cn-btn cn-btn--primary cn-cta__button" href="{{ config.buttonUrl }}">{{ config.buttonLabel }} &#8594;</a></div></section>
