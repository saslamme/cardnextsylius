<section class="row align-items-center mb-5"><div class="col-lg-7">{% if config.kicker|default %}<div class="text-uppercase text-primary">{{ config.kicker }}</div>{% endif %}<h2>{{ config.headline }}</h2>{% if config.text|default %}<p>{{ config.text }}</p>{% endif %}{% if config.buttonLabel|default and config.buttonUrl|default %}<a class="btn btn-primary" href="{{ config.buttonUrl }}">{{ config.buttonLabel }}</a>{% endif %}</div>{% if config.image|default %}<div class="col-lg-5"><img class="img-fluid" src="{{ asset(config.image) }}" alt=""></div>{% endif %}</section>
