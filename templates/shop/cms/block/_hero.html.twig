<section class="cn-hero"><div class="cn-container cn-hero__grid"><div class="cn-stack cn-hero__copy">{% if config.kicker|default %}<span class="cn-kicker">{{ config.kicker }}</span>{% endif %}<h1 class="cn-title cn-title--hero">{{ config.headline }}</h1>{% if config.text|default %}<p class="cn-lead">{{ config.text }}</p>{% endif %}<div class="cn-cluster">{% if config.buttonLabel|default and config.buttonUrl|default %}<a class="cn-btn cn-btn--primary" href="{{ config.buttonUrl }}">{{ config.buttonLabel }}</a>{% endif %}{% if config.button2Label|default and config.button2Url|default %}<a class="cn-btn cn-btn--secondary" href="{{ config.button2Url }}">{{ config.button2Label }}</a>{% endif %}</div></div>{% if config.image|default %}<div class="cn-hero__visual cn-hero__visual--photo"><img class="cn-hero__photo" src="{{ asset(config.image) }}" alt="" loading="eager" fetchpriority="high"></div>{% endif %}</div></section>
