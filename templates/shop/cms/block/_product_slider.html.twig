{% set products = cardnext_cms_product_slider_products(config.productCodes|default([]), config.limit|default(8)) %}
{% if products is not empty %}
<section class="{{ homepage|default(false) ? 'cn-section cn-product-slider' : 'cn-cms-product-slider cn-product-slider mb-5' }}" data-cn-product-slider>{% if homepage|default(false) %}<div class="cn-container">{% endif %}
    <div class="cn-section-head"><div>{% if homepage|default(false) %}<span class="cn-kicker">{{ config.kicker|default('cardnext.storefront.homepage.products.kicker'|trans) }}</span>{% endif %}{% if config.headline|default or homepage|default(false) %}<h2 class="{{ homepage|default(false) ? 'cn-title cn-title--section' : '' }}">{{ config.headline|default('cardnext.storefront.homepage.products.title'|trans) }}</h2>{% endif %}{% if config.text|default %}<p class="cn-lead">{{ config.text }}</p>{% endif %}</div>
    {% if config.showNavigation|default(true) %}<div class="cn-product-slider__controls"><button class="cn-slider-button" type="button" data-cn-product-slider-previous aria-label="{{ 'cardnext.storefront.homepage.categories.previous'|trans }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="cn-slider-button" type="button" data-cn-product-slider-next aria-label="{{ 'cardnext.storefront.homepage.categories.next'|trans }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></div>{% endif %}</div>
    <div class="cn-product-slider__viewport" data-cn-product-slider-viewport tabindex="0"><div class="cn-product-slider__track">{% for product in products %}<div class="cn-product-slider__slide">{{ component('cardnext:product:card', {product: product}) }}</div>{% endfor %}</div></div>
{% if homepage|default(false) %}</div>{% endif %}</section>
{% endif %}
