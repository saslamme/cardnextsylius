<section class="cn-home-categories cn-category-slider" data-cn-category-slider>
 <div class="cn-container"><div class="cn-home-categories__head"><h2>{{ config.headline }}</h2><div class="cn-category-slider__controls"><button class="cn-slider-button" type="button" data-cn-category-slider-previous aria-label="{{ 'cardnext.storefront.homepage.categories.previous'|trans }}">&#8592;</button><button class="cn-slider-button" type="button" data-cn-category-slider-next aria-label="{{ 'cardnext.storefront.homepage.categories.next'|trans }}">&#8594;</button></div></div>
 <div class="cn-category-slider__viewport" data-cn-category-slider-viewport tabindex="0"><div class="cn-category-slider__track">
 {% for item in config.items|default([]) %}{% set taxon=cardnext_taxon_by_code(item.taxonCode|default('')) %}{% if taxon %}<div class="cn-category-slider__slide"><a class="cn-home-category" href="{{ path('sylius_shop_product_index',{slug:taxon.slug}) }}">{% if item.image|default %}<span class="cn-home-category__media"><img src="{{ asset(item.image) }}" alt="" loading="lazy"></span>{% endif %}<span class="cn-home-category__label"><strong>{{ taxon.name }}</strong><span aria-hidden="true">&#8594;</span></span></a></div>{% endif %}{% endfor %}
 </div></div></div>
</section>
