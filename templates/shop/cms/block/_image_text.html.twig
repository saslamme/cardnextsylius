<section class="row align-items-center mb-5{% if config.imagePosition|default('left') == 'right' %} flex-row-reverse{% endif %}">{% if config.image|default %}<div class="col-lg-6"><img class="img-fluid" src="{{ asset(config.image) }}" alt=""></div>{% endif %}<div class="col-lg-6">{% if config.headline|default %}<h2>{{ config.headline }}</h2>{% endif %}<p>{{ config.text }}</p>{% if config.buttonLabel|default and config.buttonUrl|default %}<a class="btn btn-primary" href="{{ config.buttonUrl }}">{{ config.buttonLabel }}</a>{% endif %}</div></section>
