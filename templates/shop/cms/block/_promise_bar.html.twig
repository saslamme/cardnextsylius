<div class="cn-promise-bar"><div class="cn-container cn-promise-grid">{% for item in config.items|default([]) %}<div class="cn-promise">{% if item.icon|default %}<span class="cn-promise__icon" aria-hidden="true">{{ item.icon }}</span>{% endif %}<span class="cn-promise__copy"><strong>{{ item.title }}</strong><span>{{ item.text }}</span></span></div>{% endfor %}</div></div>
