<div class="cn-promise-bar"><div class="cn-container cn-promise-grid">{% set fallback=['shipping','advice','payment','projects'] %}{% for item in config.items|default([]) %}{% set icon=item.icon|default %}{% if icon == '✓' or icon not in fallback %}{% set icon=fallback[loop.index0]|default('advice') %}{% endif %}<div class="cn-promise"><span class="cn-promise__icon" aria-hidden="true">{% include 'shop/cms/block/_semantic_icon.html.twig' with {icon:icon} only %}</span><span class="cn-promise__copy"><strong>{{ item.title }}</strong><span>{{ item.text }}</span></span></div>{% endfor %}</div></div>
