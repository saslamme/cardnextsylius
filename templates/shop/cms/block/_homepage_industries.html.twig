<section class="cn-section cn-section--soft cn-home-industries"><div class="cn-container cn-stack">{% if config.kicker|default %}<span class="cn-kicker">{{ config.kicker }}</span>{% endif %}<h2 class="cn-title cn-title--section">{{ config.headline }}</h2>{% if config.text|default %}<p class="cn-lead">{{ config.text }}</p>{% endif %}<div class="cn-grid cn-grid--3">{% for item in config.items|default([]) %}<article class="cn-card">{% if item.image|default %}<div class="cn-card__media cn-card__media--photo"><img class="cn-card__photo" src="{{ asset(item.image) }}" alt="{{ item.alt|default('') }}" loading="lazy"></div>{% endif %}<div class="cn-card__body"><h3>{{ item.title }}</h3><p>{{ item.text }}</p>{% if item.linkLabel|default and item.linkUrl|default %}<a class="cn-link cn-link--arrow" href="{{ item.linkUrl }}">{{ item.linkLabel }} <span aria-hidden="true">&#8594;</span></a>{% endif %}</div></article>{% endfor %}</div></div></section>
