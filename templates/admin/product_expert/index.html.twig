{% extends 'admin/cardnext/layout.html.twig' %}
{% block title %}Produktexperten{% endblock %}
{% block cardnext_content %}<div class="container-xl"><div class="page-header"><h1>Produktexperten</h1><a class="btn btn-primary" href="{{ path('cardnext_admin_product_expert_create') }}">Anlegen</a></div><table class="table"><thead><tr><th>Name</th><th>Admin User</th><th>Channel</th><th>Slug</th><th>Produkte</th><th>Aktiv</th><th></th></tr></thead><tbody>{% for expert in experts %}<tr><td>{{ expert.displayName }}</td><td>{{ expert.adminUser.email }}</td><td>{{ expert.channel.name }}</td><td>{{ expert.slug }}</td><td>{{ expert.products|length }}</td><td>{{ expert.enabled ? 'Ja' : 'Nein' }}</td><td><a href="{{ path('cardnext_admin_product_expert_edit', {id: expert.id}) }}">Bearbeiten</a> · <a href="{{ path('cardnext_admin_product_expert_assortment', {id: expert.id}) }}">Sortiment</a> · <a target="_blank" href="{{ path('cardnext_shop_product_expert_show', {slug: expert.slug}) }}">Öffnen</a></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
