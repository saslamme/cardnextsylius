{% extends 'admin/cardnext/layout.html.twig' %}{% block title %}Produktexperte{% endblock %}{% block cardnext_content %}<div class="container-xl"><h1>Produktexperte</h1>{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-primary">Speichern</button>{{ form_end(form) }}</div><script>(()=>{const name=document.querySelector('#product_expert_displayName'),slug=document.querySelector('#product_expert_slug');if(!name||!slug)return;name.addEventListener('input',()=>{if(slug.dataset.edited)return;slug.value=name.value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')});slug.addEventListener('input',()=>slug.dataset.edited='1')})()</script>{% endblock %}
