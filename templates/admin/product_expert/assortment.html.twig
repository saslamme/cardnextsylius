{% extends 'admin/cardnext/layout.html.twig' %}
{% block title %}Mein Sortiment{% endblock %}
{% block cardnext_content %}
<div class="container-xl" data-assortment data-expert="{{ expert.id }}" data-token="{{ csrf_token('product_expert_assortment') }}">
 <h1>Mein Sortiment</h1><p>Öffentliche Seite: <code>{{ absolute_url(path('cardnext_shop_product_expert_show', {slug: expert.slug})) }}</code> <a class="btn btn-outline-primary" target="_blank" href="{{ path('cardnext_shop_product_expert_show', {slug: expert.slug}) }}">Seite ansehen</a></p>
 <section class="card mb-4"><div class="card-body"><h2>Produkte hinzufügen</h2><label for="expert-search">Produktname, Artikelnummer, Variantencode oder Hersteller</label><input class="form-control" id="expert-search" autocomplete="off"><div id="expert-results" class="list-group mt-2"></div></div></section>
 <section><h2>Mein Sortiment <small id="expert-count">{{ expert.products|length }} Produkte</small></h2><div id="expert-products">
 {% for item in expert.products %}<div class="card mb-2" draggable="true" data-item="{{ item.id }}"><div class="card-body d-flex gap-3 align-items-center"><span title="Ziehen">☰</span><strong>{{ item.product.name }}</strong><span>{{ item.product.manufacturer ? item.product.manufacturer.name : '' }}</span><code>{{ item.product.code }}</code><button class="btn btn-sm btn-outline-danger ms-auto" data-remove>Entfernen</button></div></div>{% endfor %}
 </div></section>
</div>
<script>
(()=>{const root=document.querySelector('[data-assortment]');if(!root)return;const id=root.dataset.expert,token=root.dataset.token,list=document.querySelector('#expert-products'),results=document.querySelector('#expert-results'),input=document.querySelector('#expert-search');let timer,drag;
const request=(url,options={})=>fetch(url,{...options,headers:{'X-CSRF-TOKEN':token,'Content-Type':'application/json',...(options.headers||{})}});
input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(async()=>{if(input.value.trim().length<2){results.innerHTML='';return}const data=await fetch(`{{ path('cardnext_admin_product_expert_product_search') }}?q=${encodeURIComponent(input.value)}&expert=${id}`).then(r=>r.json());results.innerHTML=data.map(p=>`<button class="list-group-item list-group-item-action" data-add="${p.id}"><strong>${p.name}</strong> · ${p.manufacturer||''} · ${p.code}</button>`).join('')},300)});
results.addEventListener('click',async e=>{const b=e.target.closest('[data-add]');if(!b)return;const body=new URLSearchParams({product:b.dataset.add,_token:token});const r=await fetch(`{{ path('cardnext_admin_product_expert_assortment_add', {id: expert.id}) }}`,{method:'POST',body});if(r.ok)location.reload()});
list.addEventListener('click',async e=>{const b=e.target.closest('[data-remove]');if(!b)return;const row=b.closest('[data-item]'),url=`{{ path('cardnext_admin_product_expert_assortment_remove', {id: expert.id, item: 999999}) }}`.replace('999999',row.dataset.item);const body=new URLSearchParams({_token:token});if((await fetch(url,{method:'POST',body})).ok){row.remove();document.querySelector('#expert-count').textContent=`${list.children.length} Produkte`}});
list.addEventListener('dragstart',e=>{drag=e.target.closest('[data-item]')});list.addEventListener('dragover',e=>{e.preventDefault();const over=e.target.closest('[data-item]');if(over&&over!==drag)list.insertBefore(drag,over)});list.addEventListener('drop',async e=>{e.preventDefault();await request(`{{ path('cardnext_admin_product_expert_assortment_sort', {id: expert.id}) }}`,{method:'POST',body:JSON.stringify({items:[...list.children].map(x=>x.dataset.item)})})});
})();
</script>
{% endblock %}
