{% extends 'admin/cardnext/layout.html.twig' %}

{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{% block cardnext_content %}
    <div class="page-header mb-4">
        <div class="row align-items-center">
            <div class="col">
                <div class="page-pretitle">Inhalte → Rechtstexte → {{ page.localeCode }}</div>
                <h2 class="page-title">{{ page.title }} bearbeiten</h2>
            </div>
            <div class="col-auto ms-auto">
                <a class="btn btn-outline-secondary" href="{{ path('cardnext_admin_legal_page_index') }}">Zurück</a>
            </div>
        </div>
    </div>

    <div class="alert alert-warning mb-4">
        Rechtstexte sollten nach Änderungen an Shopfunktionen, Zahlungsarten, Tracking,
        Versand oder Unternehmensdaten erneut geprüft werden.
    </div>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Inhalt</h3></div>
                    <div class="card-body">
                        {{ form_row(form.code) }}
                        {{ form_row(form.localeCode) }}
                        {{ form_row(form.title) }}
                        {{ form_row(form.content) }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">SEO</h3></div>
                    <div class="card-body">
                        {{ form_row(form.metaTitle) }}
                        {{ form_row(form.metaDescription) }}
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-header"><h3 class="card-title">Verkaufskanäle</h3></div>
                    <div class="card-body">{{ form_row(form.channels) }}</div>
                </div>

                <div class="card mt-4">
                    <div class="card-body">
                        Jeder Typ kann je Verkaufskanal nur einmal verwendet werden.
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-body d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('cardnext_admin_legal_page_index') }}">Abbrechen</a>
                <button class="btn btn-primary" type="submit">Speichern</button>
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}
