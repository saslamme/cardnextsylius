{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<h2 class="page-title mb-4">{{ page_title }}</h2>{{ form_start(form) }}<div class="card"><div class="card-body"><div class="row g-3"><div class="col-md-6">{{ form_row(form.manufacturer) }}</div><div class="col-md-6">{{ form_row(form.name) }}</div><div class="col-md-6">{{ form_row(form.code) }}</div><div class="col-md-6">{{ form_row(form.slug) }}</div><div class="col-md-6">{{ form_row(form.deviceType) }}</div><div class="col-md-6">{{ form_row(form.status) }}</div><div class="col-12">{{ form_row(form.linkedProduct) }}</div><div class="col-12">{{ form_row(form.aliases) }}<div class="form-hint">Mit „Eintrag hinzufügen“ lassen sich historische Schreibweisen pflegen.</div></div></div></div><div class="card-footer d-flex justify-content-end gap-2"><a class="btn" href="{{ path('cardnext_admin_device_model_index') }}">Abbrechen</a><button class="btn btn-primary">Speichern</button></div></div>{{ form_end(form) }}{% endblock %}
