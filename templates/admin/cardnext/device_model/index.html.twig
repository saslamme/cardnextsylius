{% extends 'admin/cardnext/layout.html.twig' %}
{% set page_title = 'Gerätemodelle' %}
{% block cardnext_content %}
<div class="d-flex align-items-center mb-4"><div><h2 class="page-title">Gerätemodelle</h2><div class="text-secondary">Aktuelle und historische Geräte für explizite Produktkompatibilität.</div></div><a class="btn btn-primary ms-auto" href="{{ path('cardnext_admin_device_model_create') }}">Gerätemodell anlegen</a></div>
<form class="card card-body mb-4" method="get"><div class="row g-3"><div class="col-md-4"><input class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="Code, Name oder Alias"></div><div class="col-md-3"><select class="form-select" name="manufacturer"><option value="">Alle Hersteller</option>{% for manufacturer in manufacturers %}<option value="{{ manufacturer.id }}" {{ app.request.query.get('manufacturer') == manufacturer.id ? 'selected' }}>{{ manufacturer.name }}</option>{% endfor %}</select></div><div class="col-md-2"><select class="form-select" name="device_type"><option value="">Alle Typen</option>{% for code,label in type_labels %}<option value="{{ code }}" {{ app.request.query.get('device_type') == code ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div><div class="col-md-2"><select class="form-select" name="status"><option value="">Alle Status</option>{% for code,label in status_labels %}<option value="{{ code }}" {{ app.request.query.get('status') == code ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div><div class="col-md-1"><button class="btn btn-primary">Filtern</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Hersteller / Modell</th><th>Code</th><th>Typ</th><th>Status</th><th>Aliase</th><th class="w-1"></th></tr></thead><tbody>{% for device in devices %}<tr><td><strong>{{ device.manufacturer.name }} {{ device.name }}</strong>{% if device.linkedProduct %}<div class="small text-secondary">Produkt: {{ device.linkedProduct.code }}</div>{% endif %}</td><td>{{ device.code }}</td><td>{{ type_labels[device.deviceType] }}</td><td><span class="badge {{ device.status == 'active' ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ status_labels[device.status] }}</span></td><td>{{ device.aliases|map(a => a.alias)|join(', ') }}</td><td class="d-flex gap-2"><a class="btn btn-sm" href="{{ path('cardnext_admin_device_model_update', {id: device.id}) }}">Bearbeiten</a><form method="post" action="{{ path('cardnext_admin_device_model_delete', {id: device.id}) }}" onsubmit="return confirm('Gerätemodell wirklich löschen?');"><input type="hidden" name="_token" value="{{ csrf_token('delete-device-model-' ~ device.id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="6" class="text-center text-secondary py-4">Keine Gerätemodelle gefunden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
