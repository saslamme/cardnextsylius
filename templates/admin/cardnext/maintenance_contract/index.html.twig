{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title = 'cardnext.maintenance_contract.admin.menu'|trans %}
{% block cardnext_content %}<div class="d-flex align-items-center mb-4"><div><h2 class="page-title">{{ page_title }}</h2><div class="text-secondary">{{ 'cardnext.maintenance_contract.admin.source_notice'|trans }}</div></div><form method="post" action="{{ path('cardnext_admin_maintenance_contract_sync') }}" class="ms-auto"><input type="hidden" name="_token" value="{{ csrf_token('maintenance-contract-sync') }}"><button class="btn btn-primary">{{ 'cardnext.maintenance_contract.admin.sync'|trans }}</button></form></div>
<form class="card card-body mb-4" method="get"><div class="input-group"><input class="form-control" name="q" value="{{ query }}" placeholder="Seriennummer, ERP-Kunde, Vertrag, Kunde"><button class="btn btn-primary">Suchen</button></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Kunde</th><th>ERP-Kunde</th><th>Drucker / Seriennummer</th><th>Vertrag</th><th>Zeitraum / Status</th><th>Zuletzt synchronisiert</th><th>Interne Notiz</th></tr></thead><tbody>{% for contract in contracts %}{% set status = contract.statusAt(today).value %}<tr><td>{{ contract.customer.b2bProfile.companyName ?? contract.customer.fullName }}<small class="d-block text-secondary">{{ contract.customer.email }}</small></td><td>{{ contract.erpCustomerNumber }}</td><td>{{ contract.printerModel ?? '–' }}<small class="d-block">{{ contract.serialNumber }}</small></td><td>{{ contract.contractReference ?? '–' }}<small class="d-block text-secondary">{{ contract.erpContractId }}</small></td><td>{{ contract.startsAt|date('d.m.Y') }} – {{ contract.endsAt|date('d.m.Y') }}<small class="d-block badge bg-secondary-lt">{{ ('cardnext.maintenance_contract.status.' ~ status)|trans }}</small></td><td>{{ contract.lastSyncedAt|date('d.m.Y H:i') }}</td><td><form method="post" action="{{ path('cardnext_admin_maintenance_contract_note', {id: contract.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('maintenance-contract-note-' ~ contract.id) }}"><textarea class="form-control form-control-sm" name="internal_note" rows="2">{{ contract.internalNote }}</textarea><button class="btn btn-sm mt-1">Speichern</button></form></td></tr>{% else %}<tr><td colspan="7" class="text-center text-secondary py-4">Keine Wartungsverträge gefunden.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
