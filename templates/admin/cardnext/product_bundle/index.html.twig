{% extends 'admin/cardnext/layout.html.twig' %}
{% set page_title = 'Bundles' %}

{% block cardnext_content %}
    <nav aria-label="Breadcrumb"><ol class="breadcrumb mb-3"><li class="breadcrumb-item">Katalog</li><li class="breadcrumb-item"><a href="{{ path('sylius_admin_product_index') }}">Produkte</a></li><li class="breadcrumb-item"><a href="{{ path('sylius_admin_product_update', {id: product.id}) }}">{{ product.name }}</a></li><li class="breadcrumb-item active">Bundles</li></ol></nav>
    <div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">{{ product.name }} · Code: {{ product.code }}</div><h2 class="page-title">Bundles</h2></div><div class="col-auto ms-auto d-flex gap-2"><a class="btn" href="{{ path('sylius_admin_product_update', {id: product.id}) }}">{{ ux_icon('tabler:arrow-left') }} Zurück zum Produkt</a><a class="btn btn-primary" href="{{ path('cardnext_admin_product_bundle_create', {id: product.id}) }}">{{ ux_icon('tabler:plus') }} Bundle anlegen</a></div></div></div>

    {% if bundles|length %}
        <div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Name</th><th>Code</th><th>Bestandteile</th><th>Verkaufskanäle</th><th>Rabatt</th><th>Position</th><th>Status</th><th class="w-1">Aktionen</th></tr></thead><tbody>
        {% for bundle in bundles %}<tr><td><strong>{{ bundle.name }}</strong></td><td><code>{{ bundle.code }}</code></td><td>{{ bundle.items|length }} Bestandteile</td><td>{{ bundle.channelConfigurations|length }} Verkaufskanäle</td><td>{% if bundle.channelConfigurations|length == 1 %}{% set configuration = bundle.channelConfigurations|first %}{% if configuration.discountType == 'PERCENT' %}{{ configuration.percentageDiscount / 100 }} %{% elseif configuration.discountType == 'FIXED' %}Fixrabatt{% else %}Kein Rabatt{% endif %}{% else %}{{ bundle.channelConfigurations|length }} Channel-Konfigurationen{% endif %}</td><td>{{ bundle.position }}</td><td><span class="badge {{ bundle.enabled ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ bundle.enabled ? 'Aktiv' : 'Inaktiv' }}</span></td><td><div class="btn-list flex-nowrap"><a class="btn btn-sm" href="{{ path('cardnext_admin_product_bundle_update', {id: bundle.id}) }}">Bearbeiten</a><form method="post" action="{{ path('cardnext_admin_product_bundle_delete', {id: bundle.id}) }}" onsubmit="return confirm('Bundle wirklich löschen?');"><input type="hidden" name="_token" value="{{ csrf_token('delete-product-bundle-' ~ bundle.id) }}"><button class="btn btn-sm btn-outline-danger" type="submit">Löschen</button></form></div></td></tr>{% endfor %}
        </tbody></table></div></div>
    {% else %}
        <div class="card"><div class="card-body text-center py-5"><div class="text-secondary mb-3">{{ ux_icon('tabler:packages', {class: 'icon icon-lg'}) }}</div><h3>Für dieses Produkt sind noch keine Bundles eingerichtet.</h3><p class="text-secondary">Bundles können im Shop als „Häufig zusammen gekauft“ angeboten werden.</p><a class="btn btn-primary" href="{{ path('cardnext_admin_product_bundle_create', {id: product.id}) }}">Bundle anlegen</a></div></div>
    {% endif %}
{% endblock %}
