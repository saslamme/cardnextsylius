{% extends 'admin/cardnext/layout.html.twig' %}{% block cardnext_content %}<h1>{{ inquiry.inquiryNumber }}</h1><div class="row g-3"><div class="col-lg-7"><div class="card"><div class="card-body"><dl><dt>{{ 'cardnext.leasing.product'|trans }}</dt><dd>{{ inquiry.productNameSnapshot }} ({{ inquiry.productCodeSnapshot }})</dd><dt>{{ 'cardnext.leasing.customer'|trans }}</dt><dd>{{ inquiry.company }}, {{ inquiry.firstName }} {{ inquiry.lastName }}<br>{{ inquiry.email }}<br>{{ inquiry.street }} {{ inquiry.houseNumber }}, {{ inquiry.postalCode }} {{ inquiry.city }}</dd><dt>{{ 'cardnext.leasing.rate'|trans }}</dt><dd>{{ inquiry.netPrice|sylius_format_money(inquiry.currencyCode) }} × {{ inquiry.leasingFactorSnapshot }} = {{ inquiry.calculatedMonthlyRate|sylius_format_money(inquiry.currencyCode) }} / {{ 'cardnext.leasing.month'|trans }}</dd><dt>{{ 'cardnext.leasing.field.message'|trans }}</dt><dd>{{ inquiry.message|default('—') }}</dd></dl></div></div></div><div class="col-lg-5"><form method="post" class="card"><input type="hidden" name="_token" value="{{ csrf_token('leasing-inquiry-'~inquiry.id) }}"><div class="card-body"><label class="form-label">{{ 'cardnext.leasing.status_label'|trans }}</label><select class="form-select" name="status">{% for status in statuses %}<option value="{{ status.value }}" {% if inquiry.status==status %}selected{% endif %}>{{ ('cardnext.leasing.status.'~status.value)|trans }}</option>{% endfor %}</select><label class="form-label mt-3">{{ 'cardnext.leasing.internal_note'|trans }}</label><textarea class="form-control" name="internalNote">{{ inquiry.internalNote }}</textarea></div><div class="card-footer"><button class="btn btn-primary">{{ 'cardnext.ui.save'|trans }}</button></div></form></div></div>{% endblock %}
