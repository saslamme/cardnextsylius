{% extends 'admin/cardnext/layout.html.twig' %}{% block cardnext_content %}<div class="d-flex justify-content-between"><h1>{{ 'cardnext.leasing.factors'|trans }}</h1><a class="btn btn-primary" href="{{ path('cardnext_admin_leasing_factor_create') }}">{{ 'cardnext.ui.create'|trans }}</a></div><div class="card"><table class="table"><thead><tr><th>{{ 'cardnext.leasing.duration'|trans }}</th><th>{{ 'cardnext.leasing.factor'|trans }}</th><th>{{ 'cardnext.leasing.active'|trans }}</th><th></th></tr></thead><tbody>{% for factor in factors %}<tr><td>{{ factor.durationMonths }}</td><td>{{ factor.factor }}</td><td>{{ factor.active ? '✓':'—' }}</td><td><a href="{{ path('cardnext_admin_leasing_factor_edit',{id:factor.id}) }}">{{ 'cardnext.ui.edit'|trans }}</a><form method="post" action="{{ path('cardnext_admin_leasing_factor_delete',{id:factor.id}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('leasing-factor-'~factor.id) }}"><button class="btn btn-link">{{ 'cardnext.ui.delete'|trans }}</button></form></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
