{% extends 'admin/cardnext/layout.html.twig' %}{% block cardnext_content %}<h1>{{ 'cardnext.leasing.inquiries'|trans }}</h1><form class="row g-2 mb-3"><div class="col"><input class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="{{ 'cardnext.leasing.search'|trans }}"></div><div class="col"><select class="form-select" name="status"><option value="">{{ 'cardnext.leasing.all_statuses'|trans }}</option>{% for status in statuses %}<option value="{{ status.value }}">{{ ('cardnext.leasing.status.'~status.value)|trans }}</option>{% endfor %}</select></div><div class="col-auto"><button class="btn btn-primary">{{ 'cardnext.leasing.filter'|trans }}</button></div></form><div class="card table-responsive"><table class="table"><thead><tr><th>#</th><th>{{ 'cardnext.leasing.date'|trans }}</th><th>{{ 'cardnext.leasing.customer'|trans }}</th><th>{{ 'cardnext.leasing.product'|trans }}</th><th>{{ 'cardnext.leasing.minimum'|trans }}</th><th>{{ 'cardnext.leasing.duration'|trans }}</th><th>{{ 'cardnext.leasing.rate'|trans }}</th><th>{{ 'cardnext.leasing.status_label'|trans }}</th><th>{{ 'cardnext.leasing.channel'|trans }}</th></tr></thead><tbody>{% for i in inquiries %}<tr><td><a href="{{ path('cardnext_admin_leasing_inquiry_show',{id:i.id}) }}">{{ i.inquiryNumber }}</a></td><td>{{ i.createdAt|date('d.m.Y') }}</td><td>{{ i.company }}<br>{{ i.firstName }} {{ i.lastName }}</td><td>{{ i.productNameSnapshot }}</td><td>{{ i.netPrice|sylius_format_money(i.currencyCode) }}</td><td>{{ i.durationMonths }}</td><td>{{ i.calculatedMonthlyRate|sylius_format_money(i.currencyCode) }}</td><td>{{ ('cardnext.leasing.status.'~i.status.value)|trans }}</td><td>{{ i.channel ? i.channel.code:'—' }}</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
