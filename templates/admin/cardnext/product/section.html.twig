{% set resource = hookable_metadata.context.resource %}
{% set product_form = hookable_metadata.context.form %}
{% set profile_code = resource.id ? cardnext_product_profile_code(resource) : null %}
{% set profile_label = resource.id ? cardnext_product_profile_label(resource) : null %}
{% set profile_definitions = resource.id ? cardnext_product_profile_definitions(resource) : [] %}

<div class="tab-pane" id="product-cardnext-data" role="tabpanel" tabindex="0">
    <div class="card mb-3"><div class="card-header"><h2 class="card-title">Cardnext Stammdaten</h2></div><div class="card-body">
        <div class="row g-3"><div class="col-12 col-md-6">{{ form_row(product_form.manufacturer) }}</div><div class="col-12 col-md-6">{{ form_row(product_form.model) }}</div><div class="col-12 col-md-6">{{ form_row(product_form.dataQualityStatus) }}</div></div>
        <div class="form-hint mt-3">Hersteller-Art.-Nr., GTIN und Bestellmengen werden an Varianten gepflegt.</div>
    </div></div>

    <div class="card mb-3"><div class="card-header"><h2 class="card-title">Shopdarstellung</h2></div><div class="card-body"><div class="row g-3"><div class="col-12 col-md-4">{{ form_row(product_form.homepageFeatured) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.homepagePosition) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.addonOnly) }}</div></div></div></div>

    <div class="card mb-3"><div class="card-header"><div><h2 class="card-title mb-1">Produktfunktionen</h2><div class="text-secondary small">Weiterführende Produktdaten in eigenen Bereichen verwalten.</div></div></div><div class="card-body"><div class="row g-3">
        {% set management_cards = [
            {title: 'Dokumente', icon: 'tabler:file-description', count: resource.id ? resource.documents|length : null, description: 'Datenblätter, Handbücher und Zertifikate verwalten.', route: 'cardnext_admin_product_document_index', button: 'Dokumente verwalten'},
            {title: 'Kompatibilität', icon: 'tabler:arrows-exchange', count: resource.id ? resource.compatibilities|length + resource.reverseCompatibilities|length : null, description: 'Zubehör, Verbrauchsmaterial, Alternativen und kompatible Produkte verwalten.', route: 'cardnext_admin_product_compatibility_index', button: 'Kompatibilität verwalten'},
            {title: 'B2B- & Staffelpreise', icon: 'tabler:currency-euro', count: null, description: 'Mengenstaffeln und kundengruppenspezifische Preise verwalten.', route: 'cardnext_admin_product_price_rule_index', button: 'Preise verwalten'},
            {title: 'Bundles', icon: 'tabler:packages', count: resource.id ? resource.bundles|length : null, description: 'Zusatzartikel und Rabatte für „Häufig zusammen gekauft“ verwalten.', route: 'cardnext_admin_product_bundle_index', button: 'Bundles verwalten'}
        ] %}
        {% for card in management_cards %}<div class="col-12 col-md-6 col-xl-3"><div class="border rounded p-3 h-100 d-flex flex-column"><div class="d-flex align-items-start justify-content-between gap-2 mb-2"><span class="avatar bg-primary-lt text-primary">{{ ux_icon(card.icon) }}</span>{% if card.count is not null %}<span class="badge bg-secondary-lt">{{ card.count }}</span>{% endif %}</div><h3 class="h4">{{ card.title }}</h3><p class="text-secondary small flex-grow-1">{{ card.description }}</p>{% if resource.id %}<a class="btn btn-outline-primary align-self-start" href="{{ path(card.route, {id: resource.id}) }}">{{ card.button }}</a>{% else %}<div class="text-secondary small">Nach dem ersten Speichern verfügbar.</div>{% endif %}</div></div>{% endfor %}
    </div></div></div>

    <div class="card mb-3"><div class="card-header"><h2 class="card-title">Technische Daten</h2></div><div class="card-body">
        {% if not resource.id %}<div class="alert alert-info mb-0">Nach dem ersten Speichern verfügbar.</div>
        {% elseif profile_code %}<div class="row g-3 align-items-center"><div class="col"><div class="text-secondary small">Profil</div><h3 class="h4">{{ profile_label }}</h3><p class="mb-0">{{ profile_definitions|length }} Standardfelder definiert.</p></div><div class="col-12 col-lg-auto"><div data-controller="cardnext-product-attribute-profile" data-cardnext-product-attribute-profile-url-value="{{ path('cardnext_admin_product_attribute_profile_apply', {id: resource.id}) }}" data-cardnext-product-attribute-profile-token-value="{{ csrf_token('apply-product-attribute-profile-' ~ resource.id) }}"><button class="btn btn-primary" type="button" data-action="click->cardnext-product-attribute-profile#submit" data-cardnext-product-attribute-profile-target="button">Technische Felder ergänzen / aktualisieren</button></div></div></div>
        {% else %}<div class="alert alert-light border mb-0">Für dieses Produkt ist derzeit kein technisches Datenprofil hinterlegt.</div>{% endif %}
    </div></div>

    {% if profile_code == 'card_printers' %}
        <div class="card mb-3"><div class="card-header"><div><h2 class="card-title mb-1">Kartendrucker-Berater</h2><div class="text-secondary small">Beratungskriterien für technisch geprüfte Kartendrucker.</div></div></div><div class="card-body">
            {{ form_errors(product_form.printerAdvisorProfile) }}
            <h3 class="h4">Teilnahme</h3>{{ form_row(product_form.printerAdvisorProfile.enabled) }}
            <h3 class="h4 mt-4">Druckvolumen</h3><div class="row g-3"><div class="col-12 col-md-6">{{ form_row(product_form.printerAdvisorProfile.minAnnualVolume) }}</div><div class="col-12 col-md-6">{{ form_row(product_form.printerAdvisorProfile.maxAnnualVolume) }}</div></div>
            <h3 class="h4 mt-4">Drucktechnik</h3><div class="row g-3"><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.singleSided) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.duplex) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.directPrinting) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.retransfer) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.lamination) }}</div></div>
            <h3 class="h4 mt-4">Kodierung</h3><div class="row g-3"><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.magneticStripe) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.contactChip) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.rfidNfc) }}</div></div>
            <h3 class="h4 mt-4">Bewertung</h3><div class="row g-3"><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.performanceClass) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.priority) }}</div><div class="col-12 col-md-4">{{ form_row(product_form.printerAdvisorProfile.highDurability) }}</div></div>
        </div></div>
    {% else %}
        {% do product_form.printerAdvisorProfile.setRendered %}
    {% endif %}
</div>
