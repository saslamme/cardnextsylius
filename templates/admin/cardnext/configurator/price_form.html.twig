{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='prices' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token('price-create-'~configurator.id) }}"><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.source'|trans }}</label><select class="form-select" name="value_id"><option value="">{{ 'cardnext.configurator.price.base'|trans }}</option>{% for value in values %}<option value="{{ value.id }}" {{ app.request.query.getInt('value')==value.id ? 'selected' }}>{{ value.field.section.name }} → {{ value.field.name }} → {{ value.name }} [{{ value.code }}]</option>{% endfor %}</select></div><div class="row"><div class="col"><label class="form-label">Channel</label><select class="form-select" name="channel_id"><option value="">{{ 'cardnext.configurator.global'|trans }}</option>{% for channel in channels %}<option value="{{ channel.id }}">{{ channel.name|default(channel.code) }} [{{ channel.code }}]</option>{% endfor %}</select><small class="text-secondary">{{ 'cardnext.configurator.channel_help'|trans }}</small></div><div class="col"><label class="form-label">{{ 'cardnext.configurator.currency'|trans }}</label><select class="form-select" name="currency_code">{% for currency in currencies %}<option>{{ currency }}</option>{% endfor %}</select></div></div><div class="row mt-3"><div class="col"><label class="form-label">{{ 'cardnext.configurator.charge'|trans }}</label><input required class="form-control" name="charge_code"></div><div class="col"><label class="form-label">Label</label><input class="form-control" name="label"></div></div><div class="row mt-3"><div class="col"><label class="form-label">{{ 'cardnext.configurator.minimum_quantity'|trans }}</label><input required min="1" type="number" class="form-control" name="minimum_quantity" value="1"></div><div class="col"><label class="form-label">{{ 'cardnext.configurator.maximum_quantity'|trans }}</label><input min="1" type="number" class="form-control" name="maximum_quantity"></div></div><div class="row mt-3"><div class="col"><label class="form-label">{{ 'cardnext.configurator.type'|trans }}</label><select class="form-select" id="price-type" name="price_type">{% for type in price_types %}<option value="{{ type.value }}">{{ ('cardnext.configurator.price_type.'~type.value)|trans }}</option>{% endfor %}</select></div><div class="col"><label class="form-label">{{ 'cardnext.configurator.amount'|trans }}</label><input required inputmode="decimal" class="form-control" name="amount"></div></div><div class="row mt-3"><div class="col"><label class="form-label">Multiplikator</label><select class="form-select" id="multiplier" name="multiplier_type">{% for multiplier in multipliers %}<option value="{{ multiplier.value }}">{{ ('cardnext.configurator.multiplier.'~multiplier.value)|trans }}</option>{% endfor %}</select></div><div class="col multiplier-field"><label class="form-label">{{ 'cardnext.configurator.multiplier_field'|trans }}</label><select class="form-select" name="multiplier_field_id"><option value="">—</option>{% for field in fields %}<option value="{{ field.id }}">{{ field.section.name }} → {{ field.name }} [{{ field.code }}]</option>{% endfor %}</select></div><div class="col percentage-base"><label class="form-label">{{ 'cardnext.configurator.percentage_base'|trans }}</label><select class="form-select" name="percentage_base">{% for base in percentage_bases %}<option value="{{ base.value }}">{{ ('cardnext.configurator.percentage_base_'~base.value)|trans }}</option>{% endfor %}</select></div></div><div class="mt-3"><label class="form-label">Priorität</label><input type="number" class="form-control" name="priority" value="0"></div><label class="form-check my-3"><input class="form-check-input" type="checkbox" name="enabled" value="1" checked>{{ 'cardnext.configurator.enabled'|trans }}</label><button class="btn btn-primary">{{ 'cardnext.configurator.save'|trans }}</button></form><script>const pt=document.querySelector('#price-type'),m=document.querySelector('#multiplier'),mf=document.querySelector('.multiplier-field'),pb=document.querySelector('.percentage-base'),multiplierFieldSelect=mf.querySelector('select[name="multiplier_field_id"]'),percentageBaseSelect=pb.querySelector('select[name="percentage_base"]');function t(){[...m.options].forEach(o=>o.hidden=o.value==='quantity'&&pt.value!=='fixed');if(m.selectedOptions[0].hidden)m.value='none';const usesMultiplierField=m.value==='field_value';mf.hidden=!usesMultiplierField;multiplierFieldSelect.disabled=!usesMultiplierField;const isPercent=pt.value==='percent';pb.hidden=!isPercent;percentageBaseSelect.disabled=!isPercent}pt.addEventListener('change',t);m.addEventListener('change',t);t()</script>{% endblock %}
