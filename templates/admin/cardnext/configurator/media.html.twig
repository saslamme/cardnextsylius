{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='media' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" enctype="multipart/form-data" class="card card-body mb-3"><input type="hidden" name="_token" value="{{ csrf_token('image-new-'~configurator.id) }}"><input required type="file" accept="image/png,image/jpeg,image/webp" name="file" class="form-control"><input name="type" placeholder="Typ (optional)" class="form-control"><input name="alt_text" placeholder="Alt-Text" class="form-control"><input type="number" min="0" name="position" value="0" class="form-control"><label><input type="checkbox" name="enabled" value="1" checked> Aktiv</label><button class="btn btn-primary">Bild hinzufügen</button></form>{% for image in configurator.images %}<form method="post" action="{{ path('cardnext_admin_configurator_image_update',{id:configurator.id,image:image.id}) }}" class="card card-body mb-2"><input type="hidden" name="_token" value="{{ csrf_token('image-'~image.id) }}"><code>{{ image.path }}</code><input name="type" value="{{ image.type }}" class="form-control"><input name="alt_text" value="{{ image.altText }}" class="form-control"><input type="number" min="0" name="position" value="{{ image.position }}" class="form-control"><label><input type="checkbox" name="enabled" value="1" {{ image.enabled ? 'checked' }}> Aktiv</label><button class="btn">Speichern</button></form><form method="post" action="{{ path('cardnext_admin_configurator_image_delete',{id:configurator.id,image:image.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('image-delete-'~image.id) }}"><button class="btn btn-outline-danger">Löschen</button></form>{% endfor %}{% endblock %}
