{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='dependencies' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" class="card card-body mb-3"><input type="hidden" name="_token" value="{{ csrf_token('dependency-new-'~configurator.id) }}"><select name="source_field_id">{% for field in fields %}<option value="{{ field.id }}">{{ field.name }}</option>{% endfor %}</select><select name="operator">{% for operator in operators %}<option value="{{ operator.value }}">{{ operator.value }}</option>{% endfor %}</select><input name="expected_values" placeholder="Werte, kommasepariert"><select name="target_field_id"><option value="">—</option>{% for field in fields %}<option value="{{ field.id }}">{{ field.name }}</option>{% endfor %}</select><select name="effect">{% for effect in effects %}<option value="{{ effect.value }}">{{ effect.value }}</option>{% endfor %}</select><input type="number" min="0" name="priority" value="0"><label><input type="checkbox" name="enabled" value="1" checked> Aktiv</label><button class="btn btn-primary">Hinzufügen</button></form>{% for dependency in configurator.dependencies %}<div class="card card-body">{{ dependency.sourceField.name }} {{ dependency.operator.value }} {{ dependency.expectedValues|join(', ') }} → {{ dependency.effect.value }}<form method="post" action="{{ path('cardnext_admin_configurator_dependency_delete',{id:configurator.id,dependency:dependency.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('dependency-delete-'~dependency.id) }}"><button class="btn btn-outline-danger">Löschen</button></form></div>{% endfor %}{% endblock %}
