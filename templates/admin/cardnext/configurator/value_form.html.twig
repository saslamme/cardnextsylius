{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='structure' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token(value ? 'value-'~value.id : 'value-create-'~field.id) }}">{% include 'admin/cardnext/configurator/_text_fields.html.twig' with {entity:value} %}<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="preselected" value="1" {{ value and value.preselected ? 'checked' }}><span class="form-check-label">{{ 'cardnext.configurator.preselected'|trans }}</span><small class="form-hint">{{ 'cardnext.configurator.preselected_help'|trans }}</small></label><div class="row mb-3"><div class="col"><label class="form-label">{{ 'cardnext.configurator.color'|trans }}</label><input class="form-control form-control-color" type="color" name="color_hex" value="{{ value and value.colorHex ? value.colorHex:'#000000' }}"></div><div class="col"><label class="form-label">imagePath</label><input class="form-control" name="image_path" value="{{ value ? value.imagePath:'' }}"></div><div class="col"><label class="form-label">Icon</label><input class="form-control" name="icon" value="{{ value ? value.icon:'' }}"></div></div>{% include 'admin/cardnext/configurator/_structural_translations.html.twig' with {entity:value} %}<button class="btn btn-primary">{{ 'cardnext.configurator.save'|trans }}</button></form>{% endblock %}
