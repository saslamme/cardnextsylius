<div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.name'|trans }}</label><input class="form-control" required name="name" value="{{ entity ? entity.name : '' }}"></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.code'|trans }}</label><input class="form-control" required pattern="[a-z0-9_]+" name="code" value="{{ entity ? entity.code : '' }}" {{ entity ? 'readonly' }}></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.description'|trans }}</label><textarea class="form-control" name="description">{{ entity ? entity.description : '' }}</textarea></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.position'|trans }}</label><input class="form-control" type="number" name="position" value="{{ entity ? entity.position : 0 }}"></div><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="enabled" value="1" {{ not entity or entity.enabled ? 'checked' }}><span class="form-check-label">{{ 'cardnext.configurator.enabled'|trans }}</span></label>
