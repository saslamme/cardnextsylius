{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='prices' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<div class="text-end mb-3"><a class="btn btn-primary" href="{{ path('cardnext_admin_configurator_price_create',{id:configurator.id}) }}">{{ 'cardnext.configurator.price.create'|trans }}</a></div>{% set lastSource='' %}{% for rule in rules %}{% set source=rule.value ? rule.value.field.section.name~' › '~rule.value.field.name~' › '~rule.value.name : 'cardnext.configurator.price.base'|trans %}{% if source != lastSource %}{% if lastSource %}</tbody></table></div>{% endif %}<h3 class="mt-4">{{ source }}</h3><div class="card table-responsive"><table class="table card-table"><thead><tr><th>{{ 'cardnext.configurator.charge'|trans }}</th><th>{{ 'cardnext.configurator.tier'|trans }}</th><th>{{ 'cardnext.configurator.amount'|trans }}</th><th>Channel</th><th>{{ 'cardnext.configurator.status'|trans }}</th><th></th></tr></thead><tbody>{% set lastSource=source %}{% endif %}<tr><td><strong>{{ rule.label|default(rule.chargeCode) }}</strong><small class="d-block text-secondary">{{ rule.chargeCode }} · {{ ('cardnext.configurator.price_type.'~rule.priceType.value)|trans }}</small></td><td>{{ rule.maximumQuantity ? rule.minimumQuantity~'–'~rule.maximumQuantity : ('cardnext.configurator.from'|trans)~' '~rule.minimumQuantity }}</td><td>{% if rule.priceType.value == 'percent' %}{{ amounts.basisPointsToPercentage(rule.amount) }} %{% else %}{{ amounts.fromMinorUnits(rule.amount,rule.currencyCode) }} {{ rule.currencyCode }}{% endif %}</td><td>{{ rule.channel ? rule.channel.code : 'cardnext.configurator.global'|trans }}</td><td>{{ (rule.enabled ? 'cardnext.configurator.enabled':'cardnext.configurator.disabled')|trans }}</td><td><form method="post" action="{{ path('cardnext_admin_configurator_price_delete',{id:configurator.id,rule:rule.id}) }}" onsubmit="return confirm('{{ 'cardnext.configurator.delete_confirm'|trans }}')"><input type="hidden" name="_token" value="{{ csrf_token('price-delete-'~rule.id) }}"><button class="btn btn-sm btn-outline-danger">{{ 'cardnext.configurator.delete'|trans }}</button></form></td></tr>{% else %}<div class="empty">{{ 'cardnext.configurator.price.empty'|trans }}</div>{% endfor %}{% if lastSource %}</tbody></table></div>{% endif %}{% endblock %}
