{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=(configurator ? configurator.name : 'cardnext.configurator.create'|trans) %}{% block cardnext_content %}{% if configurator %}{% set tab='master' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}{% else %}<h2 class="page-title mb-4">{{ page_title }}</h2>{% endif %}
<form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token(configurator ? 'configurator-'~configurator.id : 'configurator-create') }}"><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.name'|trans }}</label><input required maxlength="255" class="form-control" name="name" value="{{ configurator ? configurator.name : app.request.request.get('name') }}"></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.code'|trans }}</label><input required pattern="[a-z0-9_]+" class="form-control" name="code" value="{{ configurator ? configurator.code : app.request.request.get('code') }}" {{ configurator ? 'readonly' }}></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.product'|trans }}</label><input type="search" class="form-control" id="product-search" placeholder="{{ configurator and configurator.product ? configurator.product.name|default(configurator.product.code) : 'Mindestens 2 Zeichen' }}"><input type="hidden" name="product_id" id="product-id" value="{{ configurator and configurator.product ? configurator.product.id : '' }}"><div id="product-results" class="list-group"></div></div><label class="form-check"><input class="form-check-input" type="checkbox" name="enabled" value="1" {{ not configurator or configurator.enabled ? 'checked' }}><span class="form-check-label">{{ 'cardnext.configurator.enabled'|trans }}</span></label><div class="mt-4"><button class="btn btn-primary">{{ 'cardnext.configurator.save'|trans }}</button></div></form>
<script>const q=document.getElementById('product-search'),out=document.getElementById('product-results'),id=document.getElementById('product-id');let timer;q?.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(async()=>{if(q.value.length<2)return;const r=await fetch('{{ path('cardnext_admin_configurator_product_search') }}?q='+encodeURIComponent(q.value));const d=await r.json();out.innerHTML=d.results.map(x=>`<button type="button" class="list-group-item list-group-item-action" data-id="${x.id}">${x.text}</button>`).join('')},250)});out?.addEventListener('click',e=>{const b=e.target.closest('[data-id]');if(b){id.value=b.dataset.id;q.value=b.textContent;out.innerHTML=''}})</script>{% endblock %}
