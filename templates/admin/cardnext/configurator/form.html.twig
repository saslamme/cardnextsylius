{% extends 'admin/cardnext/layout.html.twig' %}
{% set page_title = configurator ? configurator.name : 'Neuer Konfigurator' %}
{% block cardnext_content %}
{% if configurator %}{% set tab='master' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}{% else %}<h2 class="page-title mb-4">{{ page_title }}</h2>{% endif %}
{% set translation = configurator and configurator.translations|length ? configurator.translations|first : null %}
<form method="post" class="card card-body">
<input type="hidden" name="_token" value="{{ csrf_token(configurator ? 'configurator-'~configurator.id : 'configurator-create') }}">
<h3>Allgemein</h3><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Interner Name</label><input required maxlength="255" class="form-control" name="name" value="{{ configurator ? configurator.name : '' }}"></div><div class="col-md-6 mb-3"><label class="form-label">Code</label><input required class="form-control" name="code" value="{{ configurator ? configurator.code : '' }}" {{ configurator ? 'readonly' }}></div></div>
<label class="form-check mb-4"><input class="form-check-input" type="checkbox" name="enabled" value="1" {{ not configurator or configurator.enabled ? 'checked' }}><span class="form-check-label">Aktiv</span></label>
<h3>Übersetzungen &amp; SEO</h3><div class="row"><div class="col-md-3 mb-3"><label class="form-label">Locale</label><input class="form-control" name="locale" value="{{ translation ? translation.locale : '' }}" placeholder="de_DE"></div><div class="col-md-4 mb-3"><label class="form-label">Name</label><input class="form-control" name="translation_name" value="{{ translation ? translation.name : '' }}"></div><div class="col-md-5 mb-3"><label class="form-label">URL/Pfad</label><input class="form-control" name="path" value="{{ translation ? translation.path : '' }}" placeholder="plastikkarten/plastikkarten-bedrucken"></div></div>
<div class="mb-3"><label class="form-label">Kurzbeschreibung</label><textarea class="form-control" name="short_description">{{ translation ? translation.shortDescription : '' }}</textarea></div><div class="mb-3"><label class="form-label">Beschreibung</label><textarea class="form-control" name="description" rows="5">{{ translation ? translation.description : '' }}</textarea></div><div class="row"><div class="col mb-3"><label class="form-label">Meta Title</label><input class="form-control" name="meta_title" value="{{ translation ? translation.metaTitle : '' }}"></div><div class="col mb-3"><label class="form-label">Meta Description</label><textarea class="form-control" name="meta_description">{{ translation ? translation.metaDescription : '' }}</textarea></div></div>
<h3>Verkaufskanäle</h3><div class="mb-3">{% for channel in channels %}<label class="form-check"><input class="form-check-input" type="checkbox" name="channels[]" value="{{ channel.id }}" {{ configurator and configurator.channels.contains(channel) ? 'checked' }}><span class="form-check-label">{{ channel.name }} ({{ channel.code }})</span></label>{% endfor %}</div>
<div class="mt-4"><button class="btn btn-primary">Speichern</button></div></form>{% endblock %}
