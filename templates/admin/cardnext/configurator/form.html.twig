{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=(configurator ? configurator.name : 'cardnext.configurator.create'|trans) %}{% block cardnext_content %}{% if configurator %}{% set tab='master' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}{% else %}<h2 class="page-title mb-4">{{ page_title }}</h2>{% endif %}
<form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token('configurator-'~configurator.id) }}"><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.name'|trans }}</label><input required maxlength="255" class="form-control" name="name" value="{{ configurator.name }}"></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.code'|trans }}</label><input class="form-control" value="{{ configurator.code }}" readonly></div><label class="form-check"><input class="form-check-input" type="checkbox" name="enabled" value="1" {{ configurator.enabled ? 'checked' }}><span class="form-check-label">{{ 'cardnext.configurator.enabled'|trans }}</span></label><div class="mt-4"><button class="btn btn-primary">{{ 'cardnext.configurator.save'|trans }}</button></div></form>{% endblock %}
