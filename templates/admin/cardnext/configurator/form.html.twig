{% extends 'admin/cardnext/layout.html.twig' %}
{% set page_title = configurator ? configurator.name : 'Neuer Konfigurator' %}
{% block cardnext_content %}
{% if configurator %}{% set tab='master' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}{% else %}<h2 class="page-title mb-4">{{ page_title }}</h2>{% endif %}
<form method="post" class="card card-body">
<input type="hidden" name="_token" value="{{ csrf_token(configurator ? 'configurator-'~configurator.id : 'configurator-create') }}">
<h3>Allgemein</h3><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Interner Name</label><input required maxlength="255" class="form-control" name="name" value="{{ configurator ? configurator.name : '' }}"></div><div class="col-md-6 mb-3"><label class="form-label">Code</label><input required class="form-control" name="code" value="{{ configurator ? configurator.code : '' }}" {{ configurator ? 'readonly' }}></div></div>
<label class="form-check mb-4"><input class="form-check-input" type="checkbox" name="enabled" value="1" {{ not configurator or configurator.enabled ? 'checked' }}><span class="form-check-label">Aktiv</span></label>
<div class="mt-4"><button class="btn btn-primary">Speichern</button></div></form>{% endblock %}
