{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='channels' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token('channels-'~configurator.id) }}">{% for channel in channels %}<label class="form-check"><input class="form-check-input" type="checkbox" name="channels[]" value="{{ channel.id }}" {{ configurator.channels.contains(channel) ? 'checked' }}>{{ channel.name|default(channel.code) }} ({{ channel.code }})</label>{% endfor %}<button class="btn btn-primary mt-3">Speichern</button></form>{% endblock %}
