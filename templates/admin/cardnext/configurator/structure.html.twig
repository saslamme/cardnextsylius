{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='structure' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<div class="text-end mb-3"><a class="btn btn-primary" href="{{ path('cardnext_admin_configurator_section_create',{id:configurator.id}) }}">{{ 'cardnext.configurator.section.create'|trans }}</a></div>{% for section in configurator.sections %}<div class="card mb-3"><div class="card-header"><div><strong>{{ section.name }}</strong><small class="text-secondary ms-2">{{ section.code }}</small></div><div class="card-actions"><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_section_update',{id:configurator.id,section:section.id}) }}">{{ 'cardnext.configurator.edit'|trans }}</a><a class="btn btn-sm btn-primary" href="{{ path('cardnext_admin_configurator_field_create',{id:configurator.id,section:section.id}) }}">{{ 'cardnext.configurator.field.create'|trans }}</a></div></div><div class="table-responsive"><table class="table card-table"><thead><tr><th>{{ 'cardnext.configurator.name'|trans }}</th><th>{{ 'cardnext.configurator.type'|trans }}</th><th>{{ 'cardnext.configurator.required'|trans }}</th><th>{{ 'cardnext.configurator.position'|trans }}</th><th></th></tr></thead><tbody>{% for field in section.fields %}<tr><td><strong>{{ field.name }}</strong><small class="d-block text-secondary">{{ field.code }}</small></td><td>{{ ('cardnext.configurator.field_type.'~field.type.value)|trans }}</td><td>{{ field.required ? '✓':'—' }}</td><td>{{ field.position }}</td><td class="text-end"><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_field_update',{id:configurator.id,field:field.id}) }}">{{ 'cardnext.configurator.edit'|trans }}</a>{% if field.type.value in ['single_choice','multiple_choice'] %}<a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_values',{id:configurator.id,field:field.id}) }}">{{ 'cardnext.configurator.values'|trans }} ({{ field.values|length }})</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5">{{ 'cardnext.configurator.field.empty'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% else %}<div class="empty">{{ 'cardnext.configurator.section.empty'|trans }}</div>{% endfor %}{% endblock %}
