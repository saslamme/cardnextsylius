{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='translations' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<div class="text-end mb-3"><a class="btn btn-primary" href="{{ path('cardnext_admin_configurator_translation_create',{id:configurator.id}) }}">Neue Übersetzung</a></div><div class="card"><table class="table card-table"><thead><tr><th>Locale</th><th>Öffentlicher Name</th><th>Pfad</th><th></th></tr></thead><tbody>{% for translation in configurator.translations %}<tr><td>{{ translation.locale }}</td><td>{{ translation.name }}</td><td>/{{ translation.path }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_translation_update',{id:configurator.id,translation:translation.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_configurator_translation_delete',{id:configurator.id,translation:translation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('translation-delete-'~translation.id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="4">Keine Übersetzungen</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
