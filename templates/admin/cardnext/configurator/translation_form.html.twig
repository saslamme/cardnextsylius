{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='translations' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token('translation-'~(translation ? translation.id : 'new-'~configurator.id)) }}"><div class="row"><div class="col"><label>Locale</label><input required class="form-control" name="locale" value="{{ translation ? translation.locale:'' }}" {{ translation ? 'readonly' }}></div><div class="col"><label>Öffentlicher Name</label><input required class="form-control" name="name" value="{{ translation ? translation.name:'' }}"></div><div class="col"><label>URL/Pfad</label><input required class="form-control" name="path" value="{{ translation ? translation.path:'' }}"></div></div><label>Kurzbeschreibung</label><textarea class="form-control" name="short_description">{{ translation ? translation.shortDescription:'' }}</textarea><label>Beschreibung</label><textarea class="form-control" name="description">{{ translation ? translation.description:'' }}</textarea><label>Meta Title</label><input class="form-control" name="meta_title" value="{{ translation ? translation.metaTitle:'' }}"><label>Meta Description</label><textarea class="form-control" name="meta_description">{{ translation ? translation.metaDescription:'' }}</textarea><button class="btn btn-primary mt-3">Speichern</button></form>{% endblock %}
