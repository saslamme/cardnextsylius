{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title='cardnext.configurator.title'|trans %}
{% block cardnext_content %}<div class="page-header mb-4"><div class="row"><div class="col"><h2 class="page-title">{{ page_title }}</h2></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('sylius_admin_product_create') }}">Neues Konfigurationsprodukt</a></div></div></div>
<form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col"><input class="form-control" name="q" value="{{ search }}" placeholder="{{ 'cardnext.configurator.search'|trans }}"></div><div class="col-auto"><select class="form-select" name="enabled"><option value="">{{ 'cardnext.configurator.all_statuses'|trans }}</option><option value="1">{{ 'cardnext.configurator.enabled'|trans }}</option><option value="0">{{ 'cardnext.configurator.disabled'|trans }}</option></select></div><div class="col-auto"><button class="btn">{{ 'cardnext.configurator.filter'|trans }}</button></div></div></form>
<div class="card table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Produkt</th><th>Produktcode</th><th>Konfigurator</th><th>{{ 'cardnext.configurator.status'|trans }}</th><th>{{ 'cardnext.configurator.sections'|trans }}</th><th>{{ 'cardnext.configurator.fields'|trans }}</th><th>{{ 'cardnext.configurator.values'|trans }}</th><th>Preisregeln</th><th></th></tr></thead><tbody>{% for row in rows %}{% set c=row[0] %}<tr><td><strong>{{ c.product ? (c.product.name|default(c.product.code)) : 'Legacy-Konfigurator' }}</strong></td><td><code>{{ c.product ? c.product.code : '—' }}</code></td><td>{{ c.name }}<small class="d-block text-secondary">{{ c.code }}</small></td><td><span class="badge {{ c.enabled ? 'bg-green-lt':'bg-secondary-lt' }}">{{ (c.enabled ? 'cardnext.configurator.enabled':'cardnext.configurator.disabled')|trans }}</span></td><td>{{ row.sectionCount }}</td><td>{{ row.fieldCount }}</td><td>{{ row.valueCount }}</td><td>{{ row.priceRuleCount }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_structure',{id:c.id}) }}">{{ 'cardnext.configurator.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="9" class="text-center py-5">{{ 'cardnext.configurator.empty'|trans }}</td></tr>{% endfor %}</tbody></table></div>
{% if total > 25 %}<div class="mt-3 btn-list"><a class="btn {{ page <= 1 ? 'disabled' }}" href="?page={{ page-1 }}&q={{ search|url_encode }}">‹</a><span class="btn disabled">{{ page }} / {{ (total/25)|round(0,'ceil') }}</span><a class="btn {{ page*25 >= total ? 'disabled' }}" href="?page={{ page+1 }}&q={{ search|url_encode }}">›</a></div>{% endif %}{% endblock %}
