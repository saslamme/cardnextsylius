{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title='cardnext.configurator.title'|trans %}
{% block cardnext_content %}<div class="page-header mb-4"><div class="row"><div class="col"><h2 class="page-title">{{ page_title }}</h2></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('cardnext_admin_configurator_create') }}">Neuer Konfigurator</a></div></div></div>
<form class="card card-body mb-3" method="get"><input class="form-control" name="q" value="{{ search }}" placeholder="Suche"></form><div class="card table-responsive"><table class="table card-table"><thead><tr><th>Name</th><th>Code</th><th>Pfade / Locales</th><th>Channels</th><th>Status</th><th>Bereiche</th><th>Felder</th><th>Werte</th><th>Preisregeln</th><th>Aktionen</th></tr></thead><tbody>{% for row in rows %}{% set c=row[0] %}<tr><td><strong>{{ c.name }}</strong></td><td><code>{{ c.code }}</code></td><td>{% for t in c.translations %}<small class="d-block">{{ t.locale }}: /{{ t.path }}</small>{% else %}—{% endfor %}</td><td>{% for channel in c.channels %}<span class="badge">{{ channel.code }}</span>{% else %}—{% endfor %}</td><td>{{ c.enabled ? 'Aktiv' : 'Inaktiv' }}</td><td>{{ row.sectionCount }}</td><td>{{ row.fieldCount }}</td><td>{{ row.valueCount }}</td><td>{{ row.priceRuleCount }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_update',{id:c.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_configurator_delete',{id:c.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('configurator-delete-'~c.id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="10">Keine Konfiguratoren</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
