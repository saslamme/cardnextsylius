{% extends 'admin/cardnext/layout.html.twig' %}
{% set page_title = configurator.name %}
{% block cardnext_content %}
    {% set tab = 'lead_times' %}
    {% include 'admin/cardnext/configurator/_header.html.twig' %}
    <form method="post" class="card card-body mb-3">
        <input type="hidden" name="_token" value="{{ csrf_token('lead-time-new-' ~ configurator.id) }}">
        <input required name="code" placeholder="Code">
        <input required name="name" placeholder="Name">
        <textarea name="description" placeholder="Beschreibung"></textarea>
        <input required type="number" min="0" name="working_days" value="0">
        <input type="number" min="0" name="position" value="0">
        <label><input type="checkbox" name="enabled" value="1" checked> {{ 'cardnext.configurator.enabled'|trans }}</label>
        <label><input type="checkbox" name="preselected" value="1"> {{ 'cardnext.configurator.lead_time.preselected'|trans }}</label>
        <small class="text-secondary">{{ 'cardnext.configurator.lead_time.preselected_help'|trans }}</small>
        {% include 'admin/cardnext/configurator/_structural_translations.html.twig' with {entity:null} %}
        <button class="btn btn-primary">Hinzufügen</button>
    </form>
    {% for leadTime in configurator.leadTimes %}
        <form method="post" action="{{ path('cardnext_admin_configurator_lead_time_update', {id: configurator.id, leadTime: leadTime.id}) }}" class="card card-body">
            <input type="hidden" name="_token" value="{{ csrf_token('lead-time-' ~ leadTime.id) }}">
            <code>{{ leadTime.code }}</code>
            <input name="name" value="{{ leadTime.name }}">
            <textarea name="description">{{ leadTime.description }}</textarea>
            <input type="number" min="0" name="working_days" value="{{ leadTime.workingDays }}">
            <input type="number" min="0" name="position" value="{{ leadTime.position }}">
            <label><input type="checkbox" name="enabled" value="1" {{ leadTime.enabled ? 'checked' }}> {{ 'cardnext.configurator.enabled'|trans }}</label>
            <label><input type="checkbox" name="preselected" value="1" {{ leadTime.preselected ? 'checked' }}> {{ 'cardnext.configurator.lead_time.preselected'|trans }}</label>
            <small class="text-secondary">{{ 'cardnext.configurator.lead_time.preselected_help'|trans }}</small>
            {% include 'admin/cardnext/configurator/_structural_translations.html.twig' with {entity:leadTime} %}
            <button class="btn">Speichern</button>
        </form>
        <form method="post" action="{{ path('cardnext_admin_configurator_lead_time_delete', {id: configurator.id, leadTime: leadTime.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('lead-time-delete-' ~ leadTime.id) }}">
            <button class="btn btn-outline-danger">Löschen</button>
        </form>
    {% endfor %}
{% endblock %}
