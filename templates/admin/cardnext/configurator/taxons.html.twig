{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='taxons' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<form method="post" class="card card-body mb-3"><input type="hidden" name="_token" value="{{ csrf_token('taxon-new-'~configurator.id) }}"><select name="taxon_id" class="form-select">{% for taxon in taxons %}<option value="{{ taxon.id }}">{{ taxon.name|default(taxon.code) }} ({{ taxon.code }})</option>{% endfor %}</select><input type="number" min="0" name="position" value="0"><label><input type="checkbox" name="primary" value="1"> Hauptkategorie</label><button class="btn btn-primary">Hinzufügen</button></form>{% for assignment in configurator.taxonAssignments %}<div class="card card-body">{{ assignment.taxon.name|default(assignment.taxon.code) }} · Position {{ assignment.position }} {{ assignment.primary ? '· Hauptkategorie' }}<form method="post" action="{{ path('cardnext_admin_configurator_taxon_delete',{id:configurator.id,assignment:assignment.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('taxon-delete-'~assignment.id) }}"><button class="btn btn-outline-danger">Löschen</button></form></div>{% endfor %}{% endblock %}
