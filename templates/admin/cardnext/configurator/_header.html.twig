 <a class="nav-link {{ tab == 'channels' ? 'active' }}" href="{{ path('cardnext_admin_configurator_channels', {id: configurator.id}) }}">Verkaufskanäle</a>
 <a class="nav-link {{ tab == 'media' ? 'active' }}" href="{{ path('cardnext_admin_configurator_media', {id: configurator.id}) }}">Medien</a>
 <a class="nav-link {{ tab == 'taxons' ? 'active' }}" href="{{ path('cardnext_admin_configurator_taxons', {id: configurator.id}) }}">Kategorien</a>
 <a class="nav-link {{ tab == 'structure' ? 'active' }}" href="{{ path('cardnext_admin_configurator_structure', {id: configurator.id}) }}">{{ 'cardnext.configurator.tabs.structure'|trans }}</a>
 <a class="nav-link {{ tab == 'prices' ? 'active' }}" href="{{ path('cardnext_admin_configurator_prices', {id: configurator.id}) }}">{{ 'cardnext.configurator.tabs.prices'|trans }}</a>
 <a class="nav-link {{ tab == 'dependencies' ? 'active' }}" href="{{ path('cardnext_admin_configurator_dependencies', {id: configurator.id}) }}">Abhängigkeiten</a>
 <a class="nav-link {{ tab == 'lead_times' ? 'active' }}" href="{{ path('cardnext_admin_configurator_lead_times', {id: configurator.id}) }}">Lieferzeiten</a>
</div>
