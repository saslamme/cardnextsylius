<div class="page-header mb-3"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Konfigurationsprodukt</div><h2 class="page-title">{{ configurator.product ? configurator.product.name|default(configurator.product.code) : configurator.name }}</h2><div class="text-secondary">Produktcode: <code>{{ configurator.product ? configurator.product.code : '—' }}</code> · Konfigurator: <code>{{ configurator.code }}</code> · <span class="badge {{ configurator.enabled ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ (configurator.enabled ? 'cardnext.configurator.enabled' : 'cardnext.configurator.disabled')|trans }}</span></div></div>{% if configurator.product %}<div class="col-auto"><a class="btn" href="{{ path('sylius_admin_product_update', {id: configurator.product.id}) }}">Produkt bearbeiten</a></div>{% endif %}</div></div>
<div class="nav nav-tabs mb-4">
 <a class="nav-link {{ tab == 'master' ? 'active' }}" href="{{ path('cardnext_admin_configurator_update', {id: configurator.id}) }}">{{ 'cardnext.configurator.tabs.master'|trans }}</a>
 <a class="nav-link {{ tab == 'structure' ? 'active' }}" href="{{ path('cardnext_admin_configurator_structure', {id: configurator.id}) }}">{{ 'cardnext.configurator.tabs.structure'|trans }}</a>
 <a class="nav-link {{ tab == 'prices' ? 'active' }}" href="{{ path('cardnext_admin_configurator_prices', {id: configurator.id}) }}">{{ 'cardnext.configurator.tabs.prices'|trans }}</a>
</div>
