{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='structure' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<div class="page-header mb-3"><div class="col"><h3>{{ field.section.name }} › {{ field.name }}</h3><small class="text-secondary">{{ field.code }}</small></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('cardnext_admin_configurator_value_create',{id:configurator.id,field:field.id}) }}">{{ 'cardnext.configurator.value.create'|trans }}</a></div></div><div class="card"><table class="table card-table"><thead><tr><th>{{ 'cardnext.configurator.name'|trans }}</th><th>{{ 'cardnext.configurator.color_icon'|trans }}</th><th>{{ 'cardnext.configurator.position'|trans }}</th><th>{{ 'cardnext.configurator.status'|trans }}</th><th></th></tr></thead><tbody>{% for value in field.values %}<tr><td><strong>{{ value.name }}</strong><small class="d-block text-secondary">{{ value.code }}</small></td><td>{% if value.colorHex %}<span style="display:inline-block;width:1rem;height:1rem;background:{{ value.colorHex }}"></span>{% endif %} {{ value.icon }}</td><td>{{ value.position }}</td><td>{{ (value.enabled ? 'cardnext.configurator.enabled':'cardnext.configurator.disabled')|trans }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_value_update',{id:configurator.id,field:field.id,value:value.id}) }}">{{ 'cardnext.configurator.edit'|trans }}</a><a class="btn btn-sm" href="{{ path('cardnext_admin_configurator_price_create',{id:configurator.id}) }}?value={{ value.id }}">{{ 'cardnext.configurator.tabs.prices'|trans }}</a></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
