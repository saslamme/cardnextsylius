{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title=configurator.name %}{% block cardnext_content %}{% set tab='structure' %}{% include 'admin/cardnext/configurator/_header.html.twig' %}<div class="mb-3 text-secondary">{{ section.name }} / {{ field ? field.name : 'cardnext.configurator.field.create'|trans }}</div><form method="post" class="card card-body"><input type="hidden" name="_token" value="{{ csrf_token(field ? 'field-'~field.id : 'field-create-'~section.id) }}"><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.name'|trans }}</label><input class="form-control" required name="name" value="{{ field ? field.name:'' }}"></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.code'|trans }}</label><input class="form-control" required name="code" value="{{ field ? field.code:'' }}" {{ field ? 'readonly' }}></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.type'|trans }}</label><select class="form-select" name="type" id="field-type">{% for type in field_types %}<option value="{{ type.value }}" {{ field and field.type==type ? 'selected' }}>{{ ('cardnext.configurator.field_type.'~type.value)|trans }}</option>{% endfor %}</select></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.description'|trans }}</label><textarea class="form-control" name="description">{{ field ? field.description:'' }}</textarea></div><div class="mb-3"><label class="form-label">{{ 'cardnext.configurator.help'|trans }}</label><textarea class="form-control" name="help_text">{{ field ? field.helpText:'' }}</textarea></div><div class="numeric row"><div class="col"><label class="form-label">Minimum</label><input class="form-control" name="minimum_value" value="{{ field ? field.minimumValue:'' }}"></div><div class="col"><label class="form-label">Maximum</label><input class="form-control" name="maximum_value" value="{{ field ? field.maximumValue:'' }}"></div><div class="col"><label class="form-label">{{ 'cardnext.configurator.step'|trans }}</label><input class="form-control" name="step" value="{{ field ? field.step:'' }}"></div></div><div class="mt-3"><label class="form-label">{{ 'cardnext.configurator.position'|trans }}</label><input class="form-control" type="number" name="position" value="{{ field ? field.position:0 }}"></div><label class="form-check mt-3"><input class="form-check-input" type="checkbox" name="required" value="1" {{ field and field.required ? 'checked' }}>{{ 'cardnext.configurator.required'|trans }}</label><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="enabled" value="1" {{ not field or field.enabled ? 'checked' }}>{{ 'cardnext.configurator.enabled'|trans }}</label><button class="btn btn-primary">{{ 'cardnext.configurator.save'|trans }}</button></form><script>const type=document.querySelector('#field-type'),numeric=document.querySelector('.numeric');function toggle(){numeric.hidden=!['integer','decimal','quantity'].includes(type.value)}type.addEventListener('change',toggle);toggle()</script>{% endblock %}
