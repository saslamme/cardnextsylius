{% extends 'admin/cardnext/layout.html.twig' %}{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}{% set page_title = page.id ? 'SEO-Landingpage bearbeiten' : 'SEO-Landingpage anlegen' %}
{% block cardnext_content %}<div class="page-header mb-4"><h2 class="page-title">{{ page_title }}</h2></div>{{ form_start(form, {attr: {'data-controller': 'seo-filter-builder seo-locale seo-quality', 'data-seo-filter-builder-url-value': path('cardnext_admin_seo_landing_page_filters'), 'data-seo-quality-url-value': path('cardnext_admin_seo_landing_page_check'), 'data-seo-quality-page-id-value': page.id|default('')}}) }}{{ form_errors(form) }}
<div class="row g-4"><div class="col-xl-6"><div class="card"><div class="card-header"><h3 class="card-title">Routing</h3></div><div class="card-body">{{ form_row(form.internalName) }}{{ form_row(form.enabled) }}{{ form_row(form.channel) }}{{ form_row(form.locale) }}{{ form_row(form.path) }}{{ form_row(form.baseTaxon) }}</div></div></div>
<div class="col-xl-6"><div class="card"><div class="card-header"><h3 class="card-title">SEO</h3></div><div class="card-body">{{ form_row(form.h1) }}{{ form_row(form.metaTitle) }}{{ form_row(form.metaDescription) }}{{ form_row(form.robotsIndex) }}{{ form_row(form.robotsFollow) }}{{ form_row(form.canonicalUrl) }}<hr><h4>SEO-Check</h4><div aria-live="polite">
{% for check in ['path', 'h1', 'h1Duplicate', 'title', 'titleDuplicate', 'description', 'index', 'follow', 'canonical', 'content'] %}<div class="text-secondary mb-2" data-seo-quality-target="item" data-check="{{ check }}">… Prüfung wird vorbereitet</div>{% endfor %}
</div><small class="text-secondary">Längenangaben sind redaktionelle Empfehlungen und keine festen Suchmaschinenregeln.</small></div></div></div></div>
<div class="card mt-4"><div class="card-header"><h3 class="card-title">Inhalt & Produktauswahl</h3></div><div class="card-body">{{ form_row(form.topContent) }}{{ form_widget(form.filterDefinition) }}<div data-seo-filter-builder-target="status" class="text-secondary mb-3">Bitte Basistaxon und Verkaufskanal auswählen.</div><div data-seo-filter-builder-target="filters" class="row g-3"></div>{{ form_row(form.bottomContent) }}</div></div>
<div class="mt-4 d-flex justify-content-end gap-2"><a class="btn" href="{{ path('cardnext_admin_seo_landing_page_index') }}">Abbrechen</a><button class="btn btn-primary">Speichern</button></div>{{ form_end(form) }}
{% if not page.id %}
<div class="alert alert-info mt-4">Inhaltselemente können nach dem ersten Speichern hinzugefügt werden.</div>
{% else %}
<div class="card mt-4"><div class="card-header"><h3 class="card-title">Inhaltselemente</h3></div><div class="card-body">
{% for placement, heading in {'before_catalog':'Oberhalb der Produktliste','after_catalog':'Unterhalb der Produktliste'} %}
<div class="d-flex align-items-center justify-content-between mb-3{% if not loop.first %} mt-5{% endif %}"><h4 class="mb-0">{{ heading }}</h4><a class="btn btn-primary" href="{{ path('cardnext_admin_seo_landing_page_block_new',{id:page.id,placement:placement}) }}">+ Element {{ placement == 'before_catalog' ? 'oberhalb' : 'unterhalb' }} hinzufügen</a></div>
<div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Blocktyp</th><th>Position</th><th>Status</th><th class="text-end">Aktionen</th></tr></thead><tbody>
{% for block in page.blocks|filter(block => block.placement == placement) %}<tr><td>{{ constant('App\\Cms\\CmsBlockRendererRegistry::TYPE_LABELS')[block.type]|default(block.type) }}</td><td>{{ block.position }}</td><td>{{ block.enabled ? 'Aktiv' : 'Deaktiviert' }}</td><td class="text-end"><a class="btn btn-sm" href="{{ path('cardnext_admin_seo_landing_page_block_edit',{id:page.id,block:block.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_seo_landing_page_block_delete',{id:page.id,block:block.id}) }}" onsubmit="return confirm('Inhaltselement wirklich löschen?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-block-' ~ block.id) }}"><button class="btn btn-sm btn-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="4" class="text-secondary">Noch keine Inhaltselemente vorhanden.</td></tr>{% endfor %}
</tbody></table></div>{% endfor %}</div></div>
{% endif %}{% endblock %}
