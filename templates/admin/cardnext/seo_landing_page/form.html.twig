{% extends 'admin/cardnext/layout.html.twig' %}{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}{% set page_title = page.id ? 'SEO-Landingpage bearbeiten' : 'SEO-Landingpage anlegen' %}
{% block cardnext_content %}<div class="page-header mb-4"><h2 class="page-title">{{ page_title }}</h2></div>{{ form_start(form) }}{{ form_errors(form) }}
<div class="row g-4"><div class="col-xl-6"><div class="card"><div class="card-header"><h3 class="card-title">Routing</h3></div><div class="card-body">{{ form_row(form.internalName) }}{{ form_row(form.enabled) }}{{ form_row(form.channel) }}{{ form_row(form.locale) }}{{ form_row(form.path) }}{{ form_row(form.baseTaxon) }}</div></div></div>
<div class="col-xl-6"><div class="card"><div class="card-header"><h3 class="card-title">SEO</h3></div><div class="card-body">{{ form_row(form.h1) }}{{ form_row(form.metaTitle) }}{{ form_row(form.metaDescription) }}{{ form_row(form.robotsIndex) }}{{ form_row(form.robotsFollow) }}{{ form_row(form.canonicalUrl) }}</div></div></div></div>
<div class="card mt-4"><div class="card-header"><h3 class="card-title">Inhalt & Filter</h3></div><div class="card-body">{{ form_row(form.topContent) }}{{ form_row(form.filterDefinition) }}{{ form_row(form.bottomContent) }}</div></div>
<div class="mt-4 d-flex justify-content-end gap-2"><a class="btn" href="{{ path('cardnext_admin_seo_landing_page_index') }}">Abbrechen</a><button class="btn btn-primary">Speichern</button></div>{{ form_end(form) }}{% endblock %}
