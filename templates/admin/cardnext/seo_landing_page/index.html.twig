{% extends 'admin/cardnext/layout.html.twig' %}{% set page_title = 'SEO-Landingpages' %}
{% block cardnext_content %}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Marketing</div><h2 class="page-title">SEO-Landingpages</h2></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('cardnext_admin_seo_landing_page_create') }}">Landingpage anlegen</a></div></div></div>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Name</th><th>Pfad</th><th>Kanal / Locale</th><th>Robots</th><th>Status</th><th></th></tr></thead><tbody>
{% for page in pages %}<tr><td><strong>{{ page.internalName }}</strong><br><small>{{ page.h1 }}</small></td><td><code>{{ page.path }}</code></td><td>{{ page.channel.name }} / {{ page.locale }}</td><td>{{ page.robots }}</td><td><span class="badge {{ page.enabled ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ page.enabled ? 'Aktiv' : 'Inaktiv' }}</span></td><td><div class="btn-list flex-nowrap"><a class="btn btn-sm" href="{{ path('cardnext_admin_seo_landing_page_update', {id: page.id}) }}">Bearbeiten</a><form method="post" action="{{ path('cardnext_admin_seo_landing_page_delete', {id: page.id}) }}" onsubmit="return confirm('Landingpage wirklich löschen?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-seo-' ~ page.id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></div></td></tr>
{% else %}<tr><td colspan="6" class="text-center text-secondary py-5">Noch keine SEO-Landingpages angelegt.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
