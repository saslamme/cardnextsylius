{% extends 'admin/cardnext/layout.html.twig' %}{% block cardnext_content %}<div class="page-header"><h1>{{ quote.number }}</h1><p>{{ quote.createdAt|date('d.m.Y H:i') }} · {{ quote.channelCode }} · {{ quote.localeCode }}</p></div>{% if quote.activeQuote %}<section class="card mb-4"><div class="card-header"><h2 class="card-title">Aktuelles Angebot</h2></div><div class="card-body">{% for offer in quote.quotes %}{% if loop.first %}<h3>{{ offer.number }} · Version {{ offer.version }}</h3><p>{{ offer.status.value == 'ready' ? 'Fertig' : 'Entwurf' }} · {{ offer.grandTotal|sylius_format_money(offer.currencyCode) }}</p><a class="btn btn-primary" href="{{ path('cardnext_admin_quote_edit',{id:offer.id}) }}">Öffnen</a>{% if offer.status.value == 'ready' %} <a class="btn btn-outline-primary" href="{{ path('cardnext_admin_quote_pdf',{id:offer.id}) }}">PDF herunterladen</a>{% endif %}{% endif %}{% endfor %}</div></section>{% if quote.quotes|length > 1 %}<section class="card mb-4"><div class="card-header"><h2 class="card-title">Frühere Versionen</h2></div><div class="card-body">{% for offer in quote.quotes %}{% if not loop.first %}<p><strong>Version {{ offer.version }}</strong> · {{ offer.status.value == 'ready' ? 'Fertig' : 'Entwurf' }} · {{ offer.quoteDate ? offer.quoteDate|date('d.m.Y') : offer.createdAt|date('d.m.Y') }} · {{ offer.grandTotal|sylius_format_money(offer.currencyCode) }} {% if offer.status.value == 'ready' %}<a href="{{ path('cardnext_admin_quote_pdf',{id:offer.id}) }}">PDF herunterladen</a>{% endif %}</p>{% endif %}{% endfor %}</div></section>{% endif %}{% else %}<form method="post" action="{{ path('cardnext_admin_quote_create',{id:quote.id}) }}" class="d-inline-block mb-4"><input type="hidden" name="_token" value="{{ csrf_token('quote_create_'~quote.id) }}"><button class="btn btn-primary">Angebot erstellen</button></form>{% endif %} <form method="post" action="{{ path('cardnext_admin_quote_status',{id:quote.id}) }}" class="d-inline-block mb-4"><input type="hidden" name="_token" value="{{ csrf_token('quote_status_'~quote.id) }}"><select name="status" class="form-select d-inline-block w-auto">{% for status in statuses %}<option value="{{ status.value }}" {{ quote.status==status?'selected' }}>{{ ('cardnext.quote.status.'~status.value)|trans }}</option>{% endfor %}</select> <button class="btn btn-primary">Status ändern</button></form><div class="row g-4"><section class="col-md-6"><div class="card"><div class="card-header"><h2 class="card-title">Kunde</h2></div><div class="card-body"><strong>{{ quote.company }}</strong><br>{{ quote.contactName }}<br>{{ quote.email }}<br>{{ quote.phone }}<hr>{{ quote.street }} {{ quote.houseNumber }}<br>{{ quote.postalCode }} {{ quote.city }}<br>{{ quote.countryCode }}</div></div></section><section class="col-md-6"><div class="card"><div class="card-header"><h2 class="card-title">Projekt</h2></div><div class="card-body">Referenz: {{ quote.projectReference|default('–') }}<br>Liefertermin: {{ quote.requestedDeliveryDate ? quote.requestedDeliveryDate|date('d.m.Y') : '–' }}<br>Beratung: {{ quote.needsAdvice?'Ja':'Nein' }}<br>Kompatibilitätsprüfung: {{ quote.needsCompatibilityCheck?'Ja':'Nein' }}<hr><div class="text-prewrap">{{ quote.message }}</div></div></div></section></div><section class="card mt-4"><div class="card-header"><h2 class="card-title">Positionen</h2></div><table class="table"><thead><tr><th>Produkt</th><th>Artikelnummer</th><th>Menge</th><th>Shoppreis bei Anfrage</th><th>Summe</th></tr></thead><tbody>{% for item in quote.items %}<tr><td>{{ item.productName }}{% if item.variantName %}<br><small>{{ item.variantName }}</small>{% endif %}</td><td>{{ item.variantCode }}</td><td>{{ item.quantity }}</td><td>{{ item.unitPrice|sylius_format_money(item.currencyCode) }}</td><td>{{ item.lineTotal|sylius_format_money(item.currencyCode) }}</td></tr>{% endfor %}</tbody><tfoot><tr><th colspan="4">Unverbindlicher Warenwert</th><th>{{ quote.estimatedTotal|sylius_format_money(quote.currencyCode) }}</th></tr></tfoot></table></section><section class="card mt-4"><div class="card-header"><h2 class="card-title">Historie</h2></div><div class="card-body">{% for event in quote.history %}<p><strong>{{ event.createdAt|date('d.m.Y H:i') }}</strong> — {{ event.message|default(event.type) }}{% if event.newStatus %} ({{ event.newStatus }}){% endif %}</p>{% endfor %}</div></section>{% endblock %}
