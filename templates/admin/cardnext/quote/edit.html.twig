{% extends 'admin/cardnext/layout.html.twig' %}{% set ready = quote.status.value != 'draft' %}{% set revisable = quote.status.value in ['ready','sent','rejected'] %}{% set downloadable = quote.status.value != 'draft' %}
{% block cardnext_content %}<div class="page-header"><h1>{{ quote.number }} <small>Version {{ quote.version }}</small></h1><p><span class="badge {{ ready ? 'bg-success':'bg-warning' }}">{{ {'draft':'Entwurf','ready':'Fertig','sent':'Versendet','accepted':'Angenommen','rejected':'Abgelehnt','superseded':'Ersetzt'}[quote.status.value] }}</span> · Anfrage <a href="{{ path('cardnext_admin_quote_show',{id:quote.quoteRequest.id}) }}">{{ quote.quoteRequest.number }}</a></p></div>
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Kunde</h2></div><div class="card-body"><strong>{{ quote.customerCompany }}</strong><br>{{ quote.customerContactName }}<br>{{ quote.customerStreet }} {{ quote.customerHouseNumber }}<br>{{ quote.customerPostalCode }} {{ quote.customerCity }} · {{ quote.customerCountryCode }}<br>{{ quote.customerEmail }}</div></div>
{% if downloadable %}<div class="mb-4"><a class="btn btn-primary" href="{{ path('cardnext_admin_quote_pdf',{id:quote.id}) }}">PDF herunterladen</a> {% if quote.status.value in ['ready','sent'] %}<form class="d-inline" method="post" action="{{ path('cardnext_admin_quote_send',{id:quote.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_send_'~quote.id) }}"><button class="btn btn-success">{{ quote.status.value == 'sent' ? 'Erneut senden':'Angebot versenden' }}</button></form>{% endif %} {% if revisable %}<form class="d-inline" method="post" action="{{ path('cardnext_admin_quote_revision',{id:quote.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_revision_'~quote.id) }}"><button class="btn btn-outline-primary">Neue Version erstellen</button></form>{% endif %}</div><div class="card mb-4"><div class="card-body">{% if quote.lastSentAt %}<p>Versendet: {{ quote.lastSentAt|date('d.m.Y H:i') }} · Versandanzahl: {{ quote.sendCount }}</p>{% endif %}{% if quote.firstViewedAt %}<p>Erstmals geöffnet: {{ quote.firstViewedAt|date('d.m.Y H:i') }}<br>Zuletzt geöffnet: {{ quote.lastViewedAt|date('d.m.Y H:i') }} · Aufrufe: {{ quote.viewCount }}</p>{% endif %}{% if quote.acceptedAt %}<p><strong>Angenommen</strong> {{ quote.acceptedAt|date('d.m.Y H:i') }} von {{ quote.acceptedByName }}<br>Angebot angenommen – Bestellung noch nicht erzeugt.</p>{% endif %}{% if quote.rejectedAt %}<p><strong>Abgelehnt</strong> {{ quote.rejectedAt|date('d.m.Y H:i') }} von {{ quote.rejectedByName }}{% if quote.rejectionReason %}<br>Grund: {{ quote.rejectionReason|nl2br }}{% endif %}</p>{% endif %}</div></div>{% endif %}
<form method="post" action="{{ path('cardnext_admin_quote_update',{id:quote.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"><div class="card mb-4"><div class="card-header"><h2 class="card-title">Positionen</h2></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Pos.</th><th>Artikel</th><th>Menge</th><th>Einzelpreis netto</th><th>MwSt. abweichend</th><th>Rabatt</th><th>Gesamt netto</th>{% if not ready %}<th></th>{% endif %}</tr></thead><tbody>{% for item in quote.items %}<tr><td>{% if ready %}{{ item.position }}{% else %}<input class="form-control" type="number" min="1" name="items[{{ item.id }}][position]" value="{{ item.position }}">{% endif %}</td><td><strong>{{ item.name }}</strong>{% if item.description %}<br><small>{{ item.description }}</small>{% endif %}</td><td>{% if ready %}{{ item.quantity }}{% else %}<input class="form-control" type="number" min="1" name="items[{{ item.id }}][quantity]" value="{{ item.quantity }}">{% endif %}</td><td>{% if ready %}{{ item.unitPrice|sylius_format_money(quote.currencyCode) }}{% else %}<input class="form-control" name="items[{{ item.id }}][unitPrice]" value="{{ money.format(item.unitPrice) }}">{% endif %}</td><td>{% if ready %}{{ item.taxRate is null ? 'Standard' : money.format(item.taxRate)~' %' }}{% else %}<input class="form-control" name="items[{{ item.id }}][taxRate]" value="{{ item.taxRate is null ? '' : money.format(item.taxRate) }}" placeholder="Standard">{% endif %}</td><td>{{ item.discountPercent is null ? '–' : money.format(item.discountPercent)~' %' }}</td><td>{{ item.lineTotal|sylius_format_money(quote.currencyCode) }}</td>{% if not ready %}<td><button class="btn btn-outline-danger" form="remove-{{ item.id }}">Entfernen</button></td>{% endif %}</tr>{% endfor %}</tbody></table></div></div>
<div class="row g-4"><section class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Kalkulation</h2></div><div class="card-body">{% if not ready %}<label>Versand netto</label><input class="form-control mb-2" name="shippingTotal" value="{{ money.format(quote.shippingTotal) }}"><label>Service netto</label><input class="form-control mb-2" name="serviceTotal" value="{{ money.format(quote.serviceTotal) }}"><label>Standard-MwSt. (%)</label><input class="form-control mb-2" name="defaultTaxRate" value="{{ money.format(quote.defaultTaxRate) }}"><label>Steuerhinweis</label><textarea class="form-control" name="taxNote">{{ quote.taxNote }}</textarea>{% endif %}<hr><dl class="row"><dt class="col-8">Zwischensumme Produkte netto</dt><dd class="col-4 text-end">{{ quote.subtotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8">Rabatt</dt><dd class="col-4 text-end">{{ quote.discountTotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8">Versand netto</dt><dd class="col-4 text-end">{{ quote.shippingTotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8">Service netto</dt><dd class="col-4 text-end">{{ quote.serviceTotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8">Nettosumme</dt><dd class="col-4 text-end">{{ (quote.subtotal+quote.shippingTotal+quote.serviceTotal)|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8">MwSt.</dt><dd class="col-4 text-end">{{ quote.taxTotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8"><strong>Gesamtsumme brutto</strong></dt><dd class="col-4 text-end"><strong>{{ quote.grandTotal|sylius_format_money(quote.currencyCode) }}</strong></dd></dl></div></div></section><section class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Bedingungen</h2></div><div class="card-body">
{% for field, label in {'validUntil':'Gültig bis','deliveryTerms':'Lieferbedingungen','paymentTerms':'Zahlungsbedingungen','customerNote':'Kundenhinweis','internalNote':'Interne Notiz'} %}
    <label>{{ label }}</label>
    {% if ready %}
        {% if field == 'validUntil' %}
            <p>{{ quote.validUntil ? quote.validUntil|date('d.m.Y') : '–' }}</p>
        {% else %}
            <p>{{ attribute(quote, field)|default('–') }}</p>
        {% endif %}
    {% elseif field == 'validUntil' %}
        <input
            type="date"
            class="form-control mb-2"
            name="{{ field }}"
            value="{{ quote.validUntil ? quote.validUntil|date('Y-m-d') : '' }}"
        >
    {% else %}
        <textarea class="form-control mb-2" name="{{ field }}">{{ attribute(quote, field) }}</textarea>
    {% endif %}
{% endfor %}
</div></div></section></div>{% if not ready %}<div class="mt-4"><button class="btn btn-primary">Speichern</button> <button class="btn btn-success" form="ready">Als fertig markieren</button></div>{% endif %}</form>
{% if not ready %}{% for item in quote.items %}<form id="remove-{{ item.id }}" method="post" action="{{ path('cardnext_admin_quote_item_remove',{quote:quote.id,item:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"></form>{% endfor %}<div class="card mt-4"><div class="card-header">Freie Position hinzufügen</div><div class="card-body"><form method="post" action="{{ path('cardnext_admin_quote_item_add',{id:quote.id}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"><input class="form-control" name="name" placeholder="Bezeichnung" required><input class="form-control" name="quantity" value="1" type="number" min="1"><input class="form-control" name="unitPrice" value="0,00"><input class="form-control" name="taxRate" placeholder="MwSt. optional, z. B. 7,00"><textarea class="form-control" name="description" placeholder="Beschreibung"></textarea><button class="btn btn-outline-primary">Position hinzufügen</button></form></div></div><form id="ready" method="post" action="{{ path('cardnext_admin_quote_ready',{id:quote.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"></form>{% endif %}{% endblock %}
