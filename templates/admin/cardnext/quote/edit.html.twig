{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}
<div class="page-header"><h1>Angebot {{ quote.number }}</h1><p>zu Anfrage <a href="{{ path('cardnext_admin_quote_show',{id:quote.quoteRequest.id}) }}">{{ quote.quoteRequest.number }}</a> · Version {{ quote.version }} · {{ quote.status.value }}</p></div>
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Kunde</h2></div><div class="card-body"><strong>{{ quote.customerCompany }}</strong><br>{{ quote.customerContactName }}<br>{{ quote.customerEmail }}</div></div>
<form method="post" action="{{ path('cardnext_admin_quote_update',{id:quote.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}">
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Positionen</h2></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Pos.</th><th>Produkt / Bezeichnung</th><th>Menge</th><th>Ursprungspreis</th><th>Angebotspreis</th><th>Rabatt</th><th>Gesamt</th><th></th></tr></thead><tbody>
{% for item in quote.items %}<tr><td><input class="form-control" type="number" min="1" name="items[{{ item.id }}][position]" value="{{ item.position }}" required></td><td><strong>{{ item.name }}</strong>{% if item.description %}<br><small>{{ item.description }}</small>{% endif %}</td><td><input class="form-control" type="number" min="1" name="items[{{ item.id }}][quantity]" value="{{ item.quantity }}" required></td><td>{{ item.originalUnitPrice is not null ? item.originalUnitPrice|sylius_format_money(quote.currencyCode) : '–' }}</td><td><div class="input-group"><input class="form-control" name="items[{{ item.id }}][unitPrice]" value="{{ money.format(item.unitPrice) }}" inputmode="decimal" required><span class="input-group-text">{{ quote.currencyCode }}</span></div></td><td>{{ item.discountPercent is not null ? (item.discountPercent / 100)|number_format(2, ',', '.') ~ ' %' : '–' }}</td><td>{{ item.lineTotal|sylius_format_money(quote.currencyCode) }}</td><td><button class="btn btn-outline-danger" form="remove-{{ item.id }}">Entfernen</button></td></tr>{% else %}<tr><td colspan="8">Noch keine Positionen.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-4"><section class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Kalkulation (netto)</h2></div><div class="card-body"><label class="form-label">Versand</label><input class="form-control mb-3" name="shippingTotal" value="{{ money.format(quote.shippingTotal) }}"><label class="form-label">Projekt-/Servicepauschale</label><input class="form-control" name="serviceTotal" value="{{ money.format(quote.serviceTotal) }}"><hr><dl class="row"><dt class="col">Zwischensumme</dt><dd class="col text-end">{{ quote.subtotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col-8">Positionsrabatte</dt><dd class="col-4 text-end">{{ quote.discountTotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col">Steuer (Phase 2b)</dt><dd class="col text-end">{{ quote.taxTotal|sylius_format_money(quote.currencyCode) }}</dd><dt class="col"><strong>Gesamt netto</strong></dt><dd class="col text-end"><strong>{{ quote.grandTotal|sylius_format_money(quote.currencyCode) }}</strong></dd></dl></div></div></section>
<section class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Bedingungen</h2></div><div class="card-body"><label class="form-label">Gültig bis</label><input class="form-control mb-3" type="date" name="validUntil" value="{{ quote.validUntil ? quote.validUntil|date('Y-m-d') : '' }}"><label class="form-label">Lieferbedingungen</label><textarea class="form-control mb-3" name="deliveryTerms">{{ quote.deliveryTerms }}</textarea><label class="form-label">Zahlungsbedingungen</label><textarea class="form-control mb-3" name="paymentTerms">{{ quote.paymentTerms }}</textarea><label class="form-label">Hinweis an den Kunden</label><textarea class="form-control mb-3" name="customerNote">{{ quote.customerNote }}</textarea><label class="form-label">Interne Notiz</label><textarea class="form-control" name="internalNote">{{ quote.internalNote }}</textarea><small>Die interne Notiz ist ausschließlich für Administratoren bestimmt.</small></div></div></section></div>
<div class="mt-4"><button class="btn btn-primary">Speichern</button> <button class="btn btn-success" form="ready">Als fertig markieren</button></div></form>
{% for item in quote.items %}<form id="remove-{{ item.id }}" method="post" action="{{ path('cardnext_admin_quote_item_remove',{quote:quote.id,item:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"></form>{% endfor %}
<div class="card mt-4"><div class="card-header"><h2 class="card-title">Freie Position hinzufügen</h2></div><div class="card-body"><form method="post" action="{{ path('cardnext_admin_quote_item_add',{id:quote.id}) }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"><div class="col-md-5"><label class="form-label">Bezeichnung</label><input class="form-control" name="name" required></div><div class="col-md-2"><label class="form-label">Menge</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-md-3"><label class="form-label">Einzelpreis</label><input class="form-control" name="unitPrice" value="0,00" required></div><div class="col-12"><label class="form-label">Beschreibung (optional)</label><textarea class="form-control" name="description"></textarea></div><div class="col-12"><button class="btn btn-outline-primary">Position hinzufügen</button></div></form></div></div>
<form id="ready" method="post" action="{{ path('cardnext_admin_quote_ready',{id:quote.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quote_edit_'~quote.id) }}"></form>
{% endblock %}
