{% extends 'admin/cardnext/layout.html.twig' %}{% block cardnext_content %}<div class="page-header"><h1>Angebote</h1></div><form class="row g-2 mb-3"><div class="col"><select class="form-select" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option value="{{ status.value }}" {{ app.request.query.get('status')==status.value?'selected' }}>{{ ('cardnext.quote.status.'~status.value)|trans }}</option>{% endfor %}</select></div><div class="col"><input class="form-control" name="channel" value="{{ app.request.query.get('channel') }}" placeholder="Channel"></div><div class="col-auto"><button class="btn btn-primary">Filtern</button></div></form><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Nummer</th><th>Datum</th><th>Firma</th><th>Ansprechpartner</th><th>E-Mail</th><th>Positionen</th><th>Warenwert</th><th>Channel</th><th>Status</th></tr></thead><tbody>{% for quote in quotes %}<tr><td><a href="{{ path('cardnext_admin_quote_show',{id:quote.id}) }}">{{ quote.number }}</a></td><td>{{ quote.createdAt|date('d.m.Y H:i') }}</td><td>{{ quote.company }}</td><td>{{ quote.contactName }}</td><td>{{ quote.email }}</td><td>{{ quote.items|length }}</td><td>{{ quote.estimatedTotal|sylius_format_money(quote.currencyCode) }}</td><td>{{ quote.channelCode }}</td><td>{{ ('cardnext.quote.status.'~quote.status.value)|trans }}</td></tr>{% else %}<tr><td colspan="9">Keine Anfragen vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
