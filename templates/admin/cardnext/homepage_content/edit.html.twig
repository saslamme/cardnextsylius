{% extends 'admin/cardnext/layout.html.twig' %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}
{% block cardnext_content %}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Inhalte → Homepage-Inhalte</div><h2 class="page-title">{{ page_title }}</h2></div><div class="col-auto"><a class="btn btn-outline-secondary" href="{{ path('cardnext_admin_homepage_content_index') }}">Zurück</a></div></div></div>
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}{{ form_errors(form) }}
<div class="row g-4"><div class="col-12 col-xl-8">
{% set sections = {'Hero': ['heroKicker','heroTitle','heroText','heroImageFile','removeHeroImage'], 'Einleitung': ['introKicker','introTitle','introText','introImageFile','removeIntroImage'], 'Warum-Bereich': ['whyKicker','whyTitle','whyText'], 'CTA / Beratung': ['ctaKicker','ctaTitle','ctaText','ctaImageFile','removeCtaImage'], 'Footer': ['footerText']} %}
{% for title, fields in sections %}<div class="card mb-4"><div class="card-header"><h3 class="card-title">{{ title }}</h3></div><div class="card-body">
{% set imagePath = title == 'Hero' ? content.heroImagePath : (title == 'Einleitung' ? content.introImagePath : (title == 'CTA / Beratung' ? content.ctaImagePath : null)) %}
{% if title in ['Hero', 'Einleitung', 'CTA / Beratung'] %}{% if imagePath %}<p><strong>Individuelles Bild</strong></p><img src="{{ asset(imagePath) }}" alt="" class="img-thumbnail mb-3" style="max-width: 240px; max-height: 140px">{% else %}<p class="text-secondary">Kein individuelles Bild konfiguriert – im Storefront wird das Standardbild verwendet.</p>{% endif %}{% endif %}
{% for field in fields %}{{ form_row(attribute(form, field)) }}{% endfor %}</div></div>{% endfor %}
</div><div class="col-12 col-xl-4"><div class="card"><div class="card-header"><h3 class="card-title">Zuordnung</h3></div><div class="card-body">{{ form_row(form.channel) }}{{ form_row(form.localeCode) }}<p class="text-secondary">Leere Felder verwenden den vorhandenen Übersetzungstext.</p></div></div></div></div>
<div class="card"><div class="card-body d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="{{ path('cardnext_admin_homepage_content_index') }}">Abbrechen</a><button class="btn btn-primary">Speichern</button></div></div>{{ form_end(form) }}
{% endblock %}
