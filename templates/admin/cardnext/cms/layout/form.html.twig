{% extends 'admin/cardnext/layout.html.twig' %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}
{% block cardnext_content %}<div class="page-header mb-4"><div class="page-pretitle">Inhalte / Layouts</div><h2 class="page-title">{{ new ? 'Layout anlegen' : 'Layout bearbeiten' }}</h2></div><div class="card"><div class="card-header"><h3 class="card-title">Layout-Einstellungen</h3></div><div class="card-body">{{ form_start(form) }}{{ form_widget(form, {attr: {class: 'form-control'}}) }}<div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Speichern</button><a class="btn" href="{{ path('cardnext_admin_cms_layouts') }}">Abbrechen</a></div>{{ form_end(form) }}</div></div>{% endblock %}
