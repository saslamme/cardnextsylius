{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<div class="d-flex justify-content-between mb-4"><h2 class="page-title">Layouts</h2><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_layout_new') }}">+ Layout</a></div><div class="card"><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Renderer</th><th>Blocktypen</th><th>Aktiv</th><th>Aktionen</th></tr></thead><tbody>{% for layout in layouts %}<tr><td><code>{{ layout.code }}</code></td><td>{{ layout.name }}</td><td>{{ layout.renderer }}</td><td>{{ layout.allowedBlockTypes ? layout.allowedBlockTypes|join(', ') : 'Alle' }}</td><td>{{ layout.enabled ? 'Ja' : 'Nein' }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_layout_edit',{id:layout.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_layout_delete',{id:layout.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-layout-' ~ layout.id) }}"><button class="btn btn-sm btn-danger">Löschen</button></form></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
