{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Inhalte</div><h2 class="page-title">Layouts</h2></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_layout_new') }}">+ Layout</a></div></div></div><div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Code</th><th>Name</th><th>Renderer</th><th>Blocktypen</th><th>Status</th><th class="text-end">Aktionen</th></tr></thead><tbody>{% for layout in layouts %}<tr><td><code>{{ layout.code }}</code></td><td class="fw-medium">{{ layout.name }}</td><td>{{ layout.renderer }}</td><td>{{ layout.allowedBlockTypes ? layout.allowedBlockTypes|join(', ') : 'Alle' }}</td><td><span class="badge bg-{{ layout.enabled ? 'success' : 'secondary' }}-lt">{{ layout.enabled ? 'Aktiv' : 'Deaktiviert' }}</span></td><td class="text-end"><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_layout_edit',{id:layout.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_layout_delete',{id:layout.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-layout-' ~ layout.id) }}"><button class="btn btn-sm btn-ghost-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="6" class="text-center text-secondary py-5">Noch keine Layouts vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
