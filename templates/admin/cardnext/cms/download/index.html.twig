{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}{% block title %}Downloads{% endblock %}{% block body %}{% hook 'sylius_admin.common.index.content' %}{% endblock %}{% block cardnext_content %}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Inhalte</div><h2 class="page-title">Downloads</h2></div><div class="col-auto"><span class="btn btn-primary disabled">+ Neuer Download</span></div></div></div>
<form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col-md"><input class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="Titel, Code oder Hersteller"></div><div class="col-md"><select class="form-select" name="type"><option value="">Alle Typen</option>{% for type in constant('App\\Entity\\Cms\\CmsDownload::TYPES') %}<option {{ app.request.query.get('type') == type ? 'selected' }}>{{ type }}</option>{% endfor %}</select></div><div class="col-auto"><button class="btn btn-secondary">Filtern</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Titel</th><th>Hersteller</th><th>Typ</th><th>Version</th><th>Kanäle</th><th>Datei</th><th>Status</th><th>Geändert</th></tr></thead><tbody>{% for d in downloads %}<tr><td>{{ d.translations|first ? (d.translations|first).title : d.code }}</td><td>{{ d.manufacturer }}</td><td><span class="badge bg-blue-lt">{{ d.type }}</span></td><td>{{ d.version|default('–') }}</td><td>{% for c in d.channels %}<span class="badge bg-secondary-lt">{{ c.code }}</span> {% endfor %}</td><td>{{ d.originalFilename ?: 'Externe URL' }}</td><td><span class="badge bg-{{ not d.enabled ? 'secondary' : (d.publishedAt and d.publishedAt > date() ? 'warning' : 'success') }}-lt">{{ not d.enabled ? 'Inaktiv' : (d.publishedAt and d.publishedAt > date() ? 'Geplant' : 'Aktiv') }}</span></td><td>{{ d.updatedAt|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="8" class="text-center py-5 text-secondary">Noch keine Downloads vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
