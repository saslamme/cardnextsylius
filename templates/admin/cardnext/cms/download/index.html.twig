{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}
{% block title %}Downloads{% endblock %}
{% block body %}{% hook 'sylius_admin.common.index.content' %}{% endblock %}
{% block cardnext_content %}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Inhalte</div><h2 class="page-title">Downloads</h2></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_download_new') }}">+ Neuer Download</a></div></div></div>
<form class="card card-body mb-3" method="get"><div class="row g-2">
  <div class="col-md-3"><input class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="Titel, Code oder Hersteller"></div>
  <div class="col-md-2"><select class="form-select" name="type"><option value="">Alle Typen</option>{% set types = {'manual':'Handbuch','datasheet':'Datenblatt','driver':'Treiber','software':'Software','firmware':'Firmware','certificate':'Zertifikat','other':'Sonstiges'} %}{% for value, label in types %}<option value="{{ value }}" {{ app.request.query.get('type') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div>
  <div class="col-md-2"><input class="form-control" name="manufacturer" value="{{ app.request.query.get('manufacturer') }}" placeholder="Hersteller"></div>
  <div class="col-md-2"><select class="form-select" name="channel"><option value="">Alle Kanäle</option>{% for channel in channels %}<option value="{{ channel.code }}" {{ app.request.query.get('channel') == channel.code ? 'selected' }}>{{ channel.name }} ({{ channel.code }})</option>{% endfor %}</select></div>
  <div class="col-md-2"><select class="form-select" name="enabled"><option value="">Jeder Status</option><option value="1" {{ app.request.query.get('enabled') == '1' ? 'selected' }}>Aktiv</option><option value="0" {{ app.request.query.get('enabled') == '0' ? 'selected' }}>Inaktiv</option></select></div>
  <div class="col-auto"><button class="btn btn-secondary">Filtern</button></div>
</div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Titel</th><th>Hersteller</th><th>Typ</th><th>Version</th><th>Kanäle</th><th>Datei</th><th>Status</th><th>Geändert</th><th>Aktionen</th></tr></thead><tbody>{% for d in downloads %}<tr><td>{{ d.translations|first ? (d.translations|first).title : d.code }}</td><td>{{ d.manufacturer }}</td><td><span class="badge bg-blue-lt">{{ types[d.type]|default(d.type) }}</span></td><td>{{ d.version|default('–') }}</td><td>{% for c in d.channels %}<span class="badge bg-secondary-lt" title="{{ c.name }}">{{ c.code }}</span> {% endfor %}</td><td>{{ d.originalFilename ?: 'Externer Download' }}</td><td><span class="badge bg-{{ not d.enabled ? 'secondary' : (d.publishedAt and d.publishedAt > date() ? 'warning' : 'success') }}-lt">{{ not d.enabled ? 'Inaktiv' : (d.publishedAt and d.publishedAt > date() ? 'Geplant' : 'Aktiv') }}</span></td><td>{{ d.updatedAt|date('d.m.Y H:i') }}</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="{{ path('cardnext_admin_cms_download_edit', {id: d.id}) }}">Bearbeiten</a> <form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_download_delete', {id: d.id}) }}" onsubmit="return confirm('Download wirklich löschen?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-download-' ~ d.id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="9" class="text-center py-5 text-secondary">Noch keine Downloads vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
