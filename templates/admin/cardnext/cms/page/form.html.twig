{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}
<div class="d-flex justify-content-between mb-4"><h2 class="page-title">{{ new ? 'CMS-Seite anlegen' : 'CMS-Seite bearbeiten' }}</h2><a class="btn" href="{{ path('cardnext_admin_cms_pages') }}">Zurück</a></div>
{{ form_start(form) }}{{ form_errors(form) }}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">1. Allgemein</h3></div><div class="card-body"><div class="row"><div class="col-md-6">{{ form_row(form.code) }}{{ form_row(form.layout) }}{{ form_row(form.status) }}</div><div class="col-md-6">{{ form_row(form.channels) }}{{ form_row(form.publishAt) }}{{ form_row(form.unpublishAt) }}{{ form_row(form.includeInSitemap) }}</div></div></div></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">2. Inhalte &amp; 3. SEO nach Sprache</h3></div><div class="card-body"><div class="accordion" id="translations">{% for translation in form.translations %}<div class="accordion-item"><h3 class="accordion-header"><button type="button" class="accordion-button {{ not loop.first ? 'collapsed' }}" data-bs-toggle="collapse" data-bs-target="#translation-{{ loop.index }}">{{ translation.vars.data.locale }}</button></h3><div id="translation-{{ loop.index }}" class="accordion-collapse collapse {{ loop.first ? 'show' }}"><div class="accordion-body">{{ form_widget(translation) }}</div></div></div>{% endfor %}</div></div></div>
<button class="btn btn-primary">Speichern</button>{{ form_end(form) }}
{% if not new %}<div class="card mt-4"><div class="card-header d-flex justify-content-between"><h3 class="card-title">Blöcke</h3><a class="btn btn-primary btn-sm" href="{{ path('cardnext_admin_cms_block_new',{page:page.id}) }}">+ Block hinzufügen</a></div><table class="table"><thead><tr><th>Position</th><th>Sprache</th><th>Typ</th><th>Aktiv</th><th>Aktionen</th></tr></thead><tbody>{% for block in page.blocks %}<tr><td>{{ block.position }}</td><td>{{ block.locale }}</td><td>{{ block.type }}</td><td>{{ block.enabled ? 'Ja' : 'Nein' }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_block_edit',{page:page.id,id:block.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_block_delete',{page:page.id,id:block.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-block-' ~ block.id) }}"><button class="btn btn-sm btn-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="5">Noch keine Blöcke.</td></tr>{% endfor %}</tbody></table></div>
<div class="card mt-4"><div class="card-header"><h3 class="card-title">Vorschau</h3></div><div class="card-body">{% for channel in page.channels %}{% for translation in page.translations %}{% if translation.title %}<a class="btn btn-sm mb-1" target="_blank" href="{{ path('cardnext_admin_cms_page_preview',{id:page.id,channel:channel.id,locale:translation.locale}) }}">{{ channel.code }} / {{ translation.locale }}</a>{% endif %}{% endfor %}{% endfor %}</div></div>{% endif %}
{% endblock %}
