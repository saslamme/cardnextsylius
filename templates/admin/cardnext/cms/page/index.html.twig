{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="page-pretitle">Inhalte</div><h2 class="page-title">CMS-Seiten</h2></div><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_page_new') }}">+ Neue CMS-Seite</a></div>
{% set status_labels = {draft: 'Entwurf', published: 'Veröffentlicht', disabled: 'Deaktiviert'} %}{% set status_colors = {draft: 'warning', published: 'success', disabled: 'secondary'} %}
<form class="card card-body mb-3" method="get" aria-label="CMS-Seiten filtern"><div class="row g-2"><div class="col-md-6 col-xl"><label class="visually-hidden" for="cms-search">Suche</label><input id="cms-search" class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="Code oder Titel"></div><div class="col-md-6 col-xl"><select class="form-select" name="status" aria-label="Status"><option value="">Alle Status</option>{% for value in ['draft','published','disabled'] %}<option value="{{ value }}" {{ app.request.query.get('status') == value ? 'selected' }}>{{ status_labels[value] }}</option>{% endfor %}</select></div><div class="col-md-6 col-xl"><select class="form-select" name="channel" aria-label="Verkaufskanal"><option value="">Alle Kanäle</option>{% for channel in channels %}<option value="{{ channel.code }}" {{ app.request.query.get('channel') == channel.code ? 'selected' }}>{{ channel.name|default(channel.code) }}</option>{% endfor %}</select></div><div class="col-md-6 col-xl"><select class="form-select" name="layout" aria-label="Layout"><option value="">Alle Layouts</option>{% for layout in layouts %}<option value="{{ layout.code }}" {{ app.request.query.get('layout') == layout.code ? 'selected' }}>{{ layout.name }}</option>{% endfor %}</select></div><div class="col-auto"><button class="btn btn-secondary">Filtern</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Titel</th><th>Code</th><th>Layout</th><th>Kanäle</th><th>Status</th><th>Geändert</th><th class="text-end">Aktionen</th></tr></thead><tbody>{% for page in pages %}{% set currentTranslation = page.translation(app.request.locale) %}<tr><td class="fw-medium">{{ currentTranslation ? currentTranslation.title : '–' }}</td><td><code>{{ page.code }}</code></td><td>{{ page.layout.name }}</td><td>{% for channel in page.channels %}<span class="badge bg-secondary-lt" title="{{ channel.name|default(channel.code) }}">{{ channel.code }}</span> {% endfor %}</td><td><span class="badge bg-{{ status_colors[page.status]|default('secondary') }}-lt">{{ status_labels[page.status]|default(page.status) }}</span></td><td class="text-secondary text-nowrap">{{ page.updatedAt|date('d.m.Y H:i') }}</td><td class="text-nowrap text-end"><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_page_edit',{id:page.id}) }}">Bearbeiten</a>{% if page.status == 'published' and currentTranslation %}<a class="btn btn-sm" target="_blank" rel="noopener" href="/{{ currentTranslation.slug }}">Öffnen</a>{% endif %}<form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_page_delete',{id:page.id}) }}" onsubmit="return confirm('Seite wirklich löschen?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-page-' ~ page.id) }}"><button class="btn btn-sm btn-ghost-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="7" class="text-center text-secondary py-5">Noch keine Seiten vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
