{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="page-pretitle">Inhalte</div><h2 class="page-title">CMS-Seiten</h2></div><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_page_new') }}">+ Neue CMS-Seite</a></div>
<form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col"><input class="form-control" name="q" value="{{ app.request.query.get('q') }}" placeholder="Code oder Titel"></div><div class="col"><select class="form-select" name="status"><option value="">Alle Status</option>{% for value in ['draft','published','disabled'] %}<option value="{{ value }}" {{ app.request.query.get('status') == value ? 'selected' }}>{{ value }}</option>{% endfor %}</select></div><div class="col"><select class="form-select" name="channel"><option value="">Alle Kanäle</option>{% for channel in channels %}<option value="{{ channel.code }}" {{ app.request.query.get('channel') == channel.code ? 'selected' }}>{{ channel.code }}</option>{% endfor %}</select></div><div class="col"><select class="form-select" name="layout"><option value="">Alle Layouts</option>{% for layout in layouts %}<option value="{{ layout.code }}" {{ app.request.query.get('layout') == layout.code ? 'selected' }}>{{ layout.name }}</option>{% endfor %}</select></div><div class="col-auto"><button class="btn btn-secondary">Filtern</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Code</th><th>Titel</th><th>Layout</th><th>Kanäle</th><th>Status</th><th>Geändert</th><th>Aktionen</th></tr></thead><tbody>{% for page in pages %}{% set currentTranslation = page.translation(app.request.locale) %}<tr><td><code>{{ page.code }}</code></td><td>{{ currentTranslation ? currentTranslation.title : '–' }}</td><td>{{ page.layout.name }}</td><td>{% for channel in page.channels %}<span class="badge bg-secondary-lt">{{ channel.code }}</span> {% endfor %}</td><td>{{ page.status }}</td><td>{{ page.updatedAt|date('d.m.Y H:i') }}</td><td class="text-nowrap"><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_page_edit',{id:page.id}) }}">Bearbeiten</a>{% if page.status == 'published' and currentTranslation %}<a class="btn btn-sm" target="_blank" href="/{{ currentTranslation.slug }}">Öffnen</a>{% endif %}<form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_page_delete',{id:page.id}) }}" onsubmit="return confirm('Seite wirklich löschen?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-page-' ~ page.id) }}"><button class="btn btn-sm btn-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="7">Noch keine Seiten vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
