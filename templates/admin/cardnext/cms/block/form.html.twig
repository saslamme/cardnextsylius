{% extends 'admin/cardnext/layout.html.twig' %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}
{% block cardnext_content %}{% set context_label = context_label|default('Inhalte / CMS-Seiten / ' ~ page.code) %}{% set title = title|default('CMS-Block bearbeiten') %}{% set back_url = back_url|default(path('cardnext_admin_cms_page_edit',{id:page.id})) %}<div class="page-header mb-4"><div class="page-pretitle">{{ context_label }}</div><h2 class="page-title">{{ title }}</h2></div><div class="alert alert-info">Nach einem Wechsel des Blocktyps bitte speichern; anschließend erscheinen die passenden Inhaltsfelder.</div><div class="card"><div class="card-header"><h3 class="card-title">Block-Einstellungen</h3></div><div class="card-body">{{ form_start(form) }}{{ form_widget(form) }}<div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Block speichern</button><a class="btn" href="{{ back_url }}">Abbrechen</a></div>{{ form_end(form) }}</div></div>{% endblock %}
