{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><div class="page-pretitle">Inhalte / Navigation</div><h2 class="page-title">{{ menu.name }}</h2></div><div class="col-auto"><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_menu_item_new',{menu:menu.id}) }}">+ Menüpunkt hinzufügen</a></div></div></div><div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Position</th><th>Bezeichnung</th><th>Typ</th><th>Ziel</th><th>Kanal</th><th>Sprache</th><th>Status</th><th class="text-end">Aktionen</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.position }}</td><td class="fw-medium">{{ item.label }}</td><td><span class="badge bg-secondary-lt">{{ item.targetType }}</span></td><td>{{ item.page ? item.page.code : (item.routeName ?: item.externalUrl) }}</td><td>{{ item.channel.name|default(item.channel.code) }}</td><td>{{ item.locale }}</td><td><span class="badge bg-{{ item.enabled ? 'success' : 'secondary' }}-lt">{{ item.enabled ? 'Aktiv' : 'Deaktiviert' }}</span></td><td class="text-end text-nowrap"><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_menu_item_edit',{menu:menu.id,id:item.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_menu_item_delete',{menu:menu.id,id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-menu-item-' ~ item.id) }}"><button class="btn btn-sm btn-ghost-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="8" class="text-center text-secondary py-5">Noch keine Menüpunkte.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
