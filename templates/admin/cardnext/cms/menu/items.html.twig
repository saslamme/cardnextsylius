{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<div class="d-flex justify-content-between mb-4"><div><div class="page-pretitle">Navigation</div><h2 class="page-title">{{ menu.name }}</h2></div><a class="btn btn-primary" href="{{ path('cardnext_admin_cms_menu_item_new',{menu:menu.id}) }}">+ Menüpunkt hinzufügen</a></div><div class="card"><table class="table"><thead><tr><th>Position</th><th>Bezeichnung</th><th>Typ</th><th>Ziel</th><th>Channel</th><th>Sprache</th><th>Aktiv</th><th>Aktionen</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.position }}</td><td>{{ item.label }}</td><td>{{ item.targetType }}</td><td>{{ item.page ? item.page.code : (item.routeName ?: item.externalUrl) }}</td><td>{{ item.channel.code }}</td><td>{{ item.locale }}</td><td>{{ item.enabled ? 'Ja' : 'Nein' }}</td><td><a class="btn btn-sm" href="{{ path('cardnext_admin_cms_menu_item_edit',{menu:menu.id,id:item.id}) }}">Bearbeiten</a><form class="d-inline" method="post" action="{{ path('cardnext_admin_cms_menu_item_delete',{menu:menu.id,id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-cms-menu-item-' ~ item.id) }}"><button class="btn btn-sm btn-danger">Löschen</button></form></td></tr>{% else %}<tr><td colspan="8">Noch keine Menüpunkte.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
