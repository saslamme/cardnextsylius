{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<h2 class="page-title mb-4">Navigation</h2><div class="row">{% for menu in menus %}<div class="col-md-6 mb-3"><a class="card card-link" href="{{ path('cardnext_admin_cms_menu_items',{id:menu.id}) }}"><div class="card-body"><h3>{{ menu.name }}</h3><code>{{ menu.code }}</code><span class="float-end">{{ menu.enabled ? 'Aktiv' : 'Deaktiviert' }}</span></div></a></div>{% else %}<p>Noch keine Menüs vorhanden.</p>{% endfor %}</div>{% endblock %}
