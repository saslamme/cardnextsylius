{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<div class="page-header mb-4"><div class="page-pretitle">Inhalte</div><h2 class="page-title">Navigation</h2></div><div class="row g-3">{% for menu in menus %}<div class="col-md-6"><a class="card card-link h-100" href="{{ path('cardnext_admin_cms_menu_items',{id:menu.id}) }}"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><h3 class="card-title mb-2">{{ menu.name }}</h3><code>{{ menu.code }}</code></div><span class="badge bg-{{ menu.enabled ? 'success' : 'secondary' }}-lt">{{ menu.enabled ? 'Aktiv' : 'Deaktiviert' }}</span></div></div></a></div>{% else %}<div class="col"><div class="card"><div class="card-body text-center text-secondary py-5">Noch keine Menüs vorhanden.</div></div></div>{% endfor %}</div>{% endblock %}
