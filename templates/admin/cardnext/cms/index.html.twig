{% extends 'admin/cardnext/layout.html.twig' %}
{% block cardnext_content %}<div class="page-header mb-4"><div><div class="page-pretitle">Inhalte</div><h2 class="page-title">{{ title }}</h2></div></div><div class="card"><div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Code</th><th>Name / Titel</th><th>Status</th></tr></thead><tbody>{% for row in rows %}<tr><td><code>{{ row.code }}</code></td><td>{% if kind == 'pages' %}{{ row.translations|first ? (row.translations|first).title : 'Noch keine Übersetzung' }}{% else %}{{ row.name }}{% endif %}</td><td>{% if kind == 'pages' %}{{ row.status }}{% else %}{{ row.enabled ? 'Aktiv' : 'Deaktiviert' }}{% endif %}</td></tr>{% else %}<tr><td colspan="3" class="text-secondary">Noch keine Einträge vorhanden.</td></tr>{% endfor %}</tbody></table></div></div><p class="text-secondary mt-3">Die redaktionellen Formulare verwenden die kontrollierten Layout-, Block- und Zieldefinitionen der CMS-Domain. Direkte Twig-, PHP- oder JavaScript-Eingabe ist nicht möglich.</p>{% endblock %}
